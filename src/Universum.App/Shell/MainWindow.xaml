                        <TextBlock Text="{Binding SortingHint}" Style="{StaticResource Hint}" FontSize="11.5" />
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SeriesNewsPageViewModel}">
            <DockPanel Margin="24,20,24,12">
