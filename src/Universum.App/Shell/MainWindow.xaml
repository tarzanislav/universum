                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="{loc:T 'Vrátiť späť'}" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="{loc:T 'Do fronty'}" Command="{Binding QueueCommand}" Margin="0,0,8,0" Padding="16,6" ToolTip="Pridá zmenu do fronty úloh namiesto okamžitého uloženia" />
                                <Button Content="{loc:T 'Uložiť'}" Command="{Binding SaveCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Method}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type jobs:JobQueuePageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Fronta úloh'}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding State}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button Content="{loc:T 'Spustiť'}" Command="{Binding StartCommand}" Padding="14,4" Margin="0,0,8,0" />
                    <Button Content="{loc:T 'Zastaviť po aktuálnej'}" Command="{Binding StopCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <Button Content="{loc:T 'Zrušiť'}" Command="{Binding CancelCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="Zruší bežiacu úlohu (originál ostane nezmenený) alebo vyradí čakajúcu" />
                    <Button Content="{loc:T 'Spustiť znova'}" Command="{Binding RetryCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="Čakajúcu úlohu skôr" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" Margin="0,0,16,0" ToolTip="Čakajúcu úlohu neskôr" />
                    <Button Content="{loc:T 'Výstup…'}" Command="{Binding OutputCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="{loc:T 'Vrátiť späť'}" Command="{Binding UndoCommand}" Padding="12,4" Margin="0,0,16,0" ToolTip="Vráti úpravu hlavičky, ktorú urobila táto úloha" />
                    <Button Content="{loc:T 'Odstrániť'}" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="{loc:T 'Vyčistiť dokončené'}" Command="{Binding ClearCommand}" Padding="12,4" />
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                        <DataGridTextColumn Header="Úloha" Binding="{Binding Description}" Width="2*" />
                        <DataGridTemplateColumn Header="Stav" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock x:Name="state" Text="{Binding Status}" />
                                        <ProgressBar Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="state" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                            <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Outcome}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Pridaná" Binding="{Binding Added}" />
                        <DataGridTextColumn Header="Trvanie" Binding="{Binding Duration}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <CheckBox Content="Spustiť frontu hneď po pridaní úlohy" IsChecked="{Binding AutoStart}" />
                    <CheckBox Content="Zvukové upozornenie, keď sú hotové všetky úlohy" IsChecked="{Binding FinishSound}" Margin="0,4,0,0"
                              ToolTip="Zvuk Windows: Hviezdička, keď je všetko hotové; Výkričník, keď niečo zlyhalo (aj Hromadné spracovanie)" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type jobs:JobOutputPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Job}" DisplayMemberPath="Display" Width="360" VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Výstup úloh'}" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,6,0,10">
                    <TextBlock Text="{Binding Job.Description}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Čas" Binding="{Binding Time}" />
                        <DataGridTemplateColumn Header="Druh" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="kind" Text="{Binding Severity}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Správa" Binding="{Binding Text}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Záznamy spracovania (owner, 31. 10. 2026): every run in words; ticked ones or all can be deleted -->
        <DataTemplate DataType="{x:Type jobs:ProcessingLogsPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                        <Button Content="{loc:T 'Zmazať označené'}" Command="{Binding DeleteCommand}" Padding="12,4" Margin="0,0,8,0"
                                ToolTip="Zmaže zaškrtnuté záznamy (alebo vybraný, keď nie je nič zaškrtnuté) – filmy sa nemenia" />
                        <Button Content="{loc:T 'Zmazať všetky'}" Command="{Binding DeleteAllCommand}" Padding="12,4" Margin="0,0,8,0" />
                        <Button Content="{loc:T 'Priečinok záznamov'}" Command="{Binding OpenFolderCommand}" Padding="12,4" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Záznamy spracovania'}" />
                </DockPanel>
                <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,10" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" MinWidth="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Logs}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="Označiť na zmazanie" />
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding When, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Kind, Mode=OneWay}" /></TextBlock>
                                        <TextBlock x:Name="summary" Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                        <Setter TargetName="summary" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="summary" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Content="len súbory s problémom" IsChecked="{Binding OnlyProblems}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="headline" Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                <ItemsControl ItemsSource="{Binding Problems}" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2">
                                                                <TextBlock TextWrapping="Wrap"><Run Text="Čo sa stalo: " FontWeight="SemiBold" /><Run Text="{Binding What, Mode=OneWay}" /></TextBlock>
                                                                <TextBlock TextWrapping="Wrap"><Run Text="Čo s tým: " FontWeight="SemiBold" /><Run Text="{Binding Advice, Mode=OneWay}" /></TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Čo sa urobilo:" FontWeight="SemiBold" />
                                                    <ItemsControl ItemsSource="{Binding Done}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="8,1,0,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Right" Content="Ukázať" Command="{Binding OpenCommand}" CommandParameter="{Binding File.Source}" Padding="8,1" Margin="8,0,0,0"
                                                            ToolTip="Otvorí priečinok s originálom v Prieskumníkovi" />
                                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <DockPanel Margin="0,2,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                    <Button DockPanel.Dock="Right" Content="Ukázať" Command="{Binding OpenCommand}" CommandParameter="{Binding File.Result}" Padding="8,1" Margin="8,0,0,0"
                                                            ToolTip="Otvorí priečinok s výsledkom v Prieskumníkovi" />
                                                    <TextBlock Text="{Binding Result}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Expander Header="Technické podrobnosti (výstup nástrojov)" Margin="0,4,0,0" Visibility="{Binding HasTechnical, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" BorderThickness="0" Margin="0,4,0,0" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="headline" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                <Setter TargetName="headline" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:BatchPageViewModel}">
            <Grid Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="aj podpriečinky" IsChecked="{Binding Recursive}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{loc:T 'Priečinok…'}" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" Padding="12,5" />
                        <Button Content="{loc:T 'Analyzovať'}" Command="{Binding AnalyzeCommand}" Padding="16,5" />
                        <Button Content="{loc:T 'Vymazať frontu'}" Command="{Binding ClearCommand}" Padding="12,5" Margin="8,0,0,0"
                                ToolTip="Zabudne analyzované, ešte nespracované súbory – aj poslané z Noviniek (na disku sa nič nezmení)" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Hromadné spracovanie'}" />
                        <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,6,0,8">
                    <ToggleButton DockPanel.Dock="Right" Content="{Binding PanelsText}" IsChecked="{Binding ShowPanels}" Padding="10,3" Margin="8,0,0,0"
                                  ToolTip="Šablónu, originály a názov pod tabuľkami skryje – tabuľky dostanú celé okno (koniec spracovania sa ukáže vždy)" />
                    <Button DockPanel.Dock="Right" Content="Upratať zvyšky" Command="{Binding CleanupCommand}" Padding="10,3"
                            ToolTip="Dočasné súbory po prerušenom spracovaní presunie do Koša" />
                    <Button DockPanel.Dock="Right" Content="Zastaviť analýzu" Command="{Binding StopCommand}" Padding="10,3" Margin="0,0,8,0"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- why nothing can be processed is said plainly, in the warning colour -->
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                     Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="180" MaxWidth="700" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="400" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                        <!-- owner, 31. 10. 2026: groups with files new since the analysis before – a pastel background, dark text to stay readable -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <Setter Property="Background" Value="#DDF3E4" />
                                        <Setter Property="Foreground" Value="#1B1B1B" />
                                        <Setter Property="ToolTip" Value="Nové súbory od predchádzajúcej analýzy" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- the group by its film or series (owner, 28. 10.); the letter stays in the tooltip and the report -->
                            <DataGridTextColumn Header="Skupina (film / seriál)" Binding="{Binding Title}" Width="*" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Súbory" Binding="{Binding Count}" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Signature}" TextWrapping="Wrap" Margin="8,0,8,6" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <!-- the list of groups can be widened -->
                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                  Background="Transparent" Cursor="SizeWE" ToolTip="Ťahaním zmeníte šírku zoznamu skupín" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Informácie" Command="{Binding ShowInfoCommand}" Padding="10,3"
                                    ToolTip="Zobrazí vybraný súbor na stránke Informácie" ToolTipService.ShowOnDisabled="True" />
                            <Button DockPanel.Dock="Right" Content="Zvuk v štúdiu" Command="{Binding EditSoundInStudioCommand}" Padding="10,3" Margin="0,0,6,0"
                                    ToolTip="Úprava audiostopy: dabing, posun, PAL 25 ↔ 23,976, kodek, hlasitosť – zmeny sa uložia do úlohy (Hromadné aj MEGA)" ToolTipService.ShowOnDisabled="True" />
                            <Button DockPanel.Dock="Right" Content="Titulky v štúdiu" Command="{Binding EditInStudioCommand}" Padding="10,3" Margin="0,0,6,0"
                                    ToolTip="Úprava titulkostopy: film s titulkami, časy, porovnanie – zmeny sa uložia do úlohy (Hromadné aj MEGA)" ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Text="Súbory skupiny – výsledok simulácie" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" MinHeight="110" ItemsSource="{Binding FileRows}" SelectedItem="{Binding SelectedFile}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False" SelectionChanged="OnBatchFilesSelected">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rozpoznať jazyk audiostôp vybraných súborov" Command="{Binding DetectAudioSelectedCommand}" />
                                    <MenuItem Header="Informácie o súbore" Command="{Binding ShowInfoCommand}" />
                                    <MenuItem Header="Upraviť v štúdiu (titulky)" Command="{Binding EditInStudioCommand}" />
                                    <MenuItem Header="Upraviť v štúdiu (zvuk)" Command="{Binding EditSoundInStudioCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Súbor" Binding="{Binding FileName}" Width="*" MinWidth="110" />
                                <DataGridTemplateColumn Header="Film / epizóda" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Text="{Binding Naming, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Film: Názov (rok), napr. Creep (2004). Seriál: číslo epizódy, napr. S01E04." />
                                                <!-- owner, 29. 10. 2026: a film exactly by its TMDB ID -->
                                                <DockPanel Margin="0,2,0,0" Visibility="{Binding IsFilm, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="TMDB ID:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBox Text="{Binding TmdbId, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                                             ToolTip="Presne podľa TMDB: číslo filmu (napr. 12345) alebo adresa z themoviedb.org; minisériál vložte ako adresu …/tv/…. Použije sa, keď pole opustíte." />
                                                </DockPanel>
                                                <TextBlock Text="{Binding NamingSuggestion}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="{loc:T 'Potvrdiť návrh'}" Command="{Binding ConfirmCommand}" Padding="8,2" Margin="0,2,0,0" FontSize="12" HorizontalAlignment="Left"
                                                        Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Návrh nie je istý (názov sa líšil od mena súboru alebo HISTRA titul nepotvrdila) – potvrďte ho, ak je správny, alebo vyberte iný" />
                                                <!-- owner, 28. 10.: the name of a file may be wrong – any title found can be chosen -->
                                                <ComboBox ItemsSource="{Binding Candidates}" DisplayMemberPath="Display" SelectedItem="{Binding ChosenCandidate}" FontSize="12" Margin="0,2,0,0"
                                                          Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="Vybrať iný titul z nájdených na TMDB (overí sa v HISTRA)" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- the file's own audio tracks without a language: chosen for this file, or what its speech suggests -->
                                <DataGridTemplateColumn Header="Jazyk audia" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding AudioSlots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,3">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Slot}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding Choices}" DisplayMemberPath="Display" FontSize="12"
                                                                          SelectedItem="{Binding SelectedChoice, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="Jazyk tejto stopy len pre tento súbor (prednosť pred voľbou pre skupinu)" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
