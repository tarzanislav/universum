                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding RunState}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
