                                                    <TextBlock Text="NOVÉ" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Where}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Week.WatchStatus}" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Week.WatchAttribution}" Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14" BorderBrush="#669CC25A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#339CC25A" Offset="0" />
                                    <GradientStop Color="#1FF2C14E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="Pripravené vo vstupnom priečinku" FontWeight="SemiBold" FontSize="15" Foreground="#5E8A2A" Margin="0,0,0,8" />
