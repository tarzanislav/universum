<!-- UNIVERSUM – Kalendár, Plánované úlohy, Zásobník TMDB, Poznámky (14. 11. 2026, step 2 of the review of the code: the templates of MainWindow.xaml by pages) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:Universum.App.Pages"
                    xmlns:app="clr-namespace:Universum.App"
                    xmlns:jobs="clr-namespace:Universum.App.Jobs"
                    xmlns:loc="clr-namespace:Universum.App.Localization"
                    xmlns:player="clr-namespace:Universum.App.Player">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate DataType="{x:Type pages:CalendarPageViewModel}">
        <DockPanel Margin="24,12,24,10">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Kalendár'}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="{loc:T 'Premiéry, nové epizódy, sviatky, prázdniny, meniny a vaše udalosti, úlohy a poznámky na jednom mieste. Kliknite na deň – vľavo uvidíte všetko o ňom. Nič sa tu nesťahuje z internetu: premiéry a epizódy sú tie, ktoré uchovávajú Premiéry a Novinky.'}" />
                <!-- the period and the views -->
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousCommand}" Padding="10,4" ToolTip="{loc:T 'Predchádzajúce obdobie'}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Content="{loc:T 'Dnes'}" Command="{Binding TodayCommand}" Padding="12,4" Margin="4,0" />
                        <Button Command="{Binding NextCommand}" Padding="10,4" ToolTip="{loc:T 'Nasledujúce obdobie'}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" />
                        </Button>
                        <TextBlock Text="{Binding PeriodText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,14,0" />
                        <DatePicker SelectedDate="{Binding JumpDate}" Width="130" VerticalAlignment="Center" ToolTip="{loc:T 'Skočiť na dátum'}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:T '+ Udalosť'}" Command="{Binding NewEventCommand}" Padding="12,4" Margin="8,0,0,0" ToolTip="{loc:T 'Nová udalosť vo vybraný deň'}" />
                        <Button Content="{loc:T 'Tlač a export…'}" Command="{Binding PrintCommand}" Padding="12,4" Margin="8,0,0,0"
                                ToolTip="{loc:T 'Tlač s náhľadom, PDF, HTML, iCalendar (.ics), CSV a záloha'}" />
                        <Button Content="{loc:T 'Obnoviť'}" Command="{Binding RefreshCommand}" Padding="12,4" Margin="8,0,0,0"
                                ToolTip="{loc:T 'Znova prečíta premiéry a epizódy, ktoré uchovávajú Premiéry a Novinky (zo zdrojov ich obnovíte tam)'}" />
                    </StackPanel>
                </DockPanel>
                <!-- the views on their own line (between the buttons they had no room in a narrower window) -->
                <WrapPanel Margin="2,0,0,6">
                    <RadioButton Content="{loc:T 'Mesiac'}" IsChecked="{Binding IsMonth}" GroupName="CalendarView" MinWidth="0" Margin="0,0,12,0" />
                    <RadioButton Content="{loc:T 'Týždeň'}" IsChecked="{Binding IsWeek}" GroupName="CalendarView" MinWidth="0" Margin="0,0,12,0" />
                    <RadioButton Content="{loc:T 'Týždeň – zoznam'}" IsChecked="{Binding IsWeekList}" GroupName="CalendarView" MinWidth="0" Margin="0,0,12,0" />
                    <RadioButton Content="{loc:T 'Mesiac – zoznam'}" IsChecked="{Binding IsMonthList}" GroupName="CalendarView" MinWidth="0" Margin="0,0,12,0" />
                    <RadioButton Content="{loc:T 'Rok – mesiace'}" IsChecked="{Binding IsYearMonths}" GroupName="CalendarView" MinWidth="0" Margin="0,0,12,0" />
                    <RadioButton Content="{loc:T 'Rok – riadky'}" IsChecked="{Binding IsYearRows}" GroupName="CalendarView" MinWidth="0" Margin="0,0,12,0" />
                    <RadioButton Content="{loc:T 'Agenda'}" IsChecked="{Binding IsAgenda}" GroupName="CalendarView" MinWidth="0" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Source={x:Static pages:CalendarPageViewModel.AgendaSpans}}" SelectedItem="{Binding AgendaSpan}" Width="96" Margin="0,0,12,0"
                              Visibility="{Binding IsAgenda, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Content="{loc:T 'Skryť prázdne dni'}" IsChecked="{Binding HideEmptyDays}" MinWidth="0"
                              Visibility="{Binding IsMonthList, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <!-- the layers: each group switches all of its layers, each layer itself (owner, points c and d); the panel folds -->
                <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6">
                    <Expander IsExpanded="{Binding ShowLayers}" Header="{loc:T 'Vrstvy a nastavenia kalendára'}">
                    <StackPanel>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding LayerGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,22,2">
                                            <CheckBox IsChecked="{Binding AllOn}" MinWidth="0" Margin="0,0,10,0" ToolTip="{loc:T 'Všetko v skupine naraz'}">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            </CheckBox>
                                            <ItemsControl ItemsSource="{Binding Layers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsOn}" MinWidth="0" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Title}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="{loc:T 'len vybrané tituly'}" IsChecked="{Binding OnlyChosen}" MinWidth="0" Margin="0,2,0,2" ToolTip="{loc:T 'Premiéry a epizódy len titulov zaškrtnutých vo Vybrané'}" />
                        </WrapPanel>
                        <Expander Header="{loc:T 'Nastavenia kalendára – krajiny sviatkov, mená, prázdniny'}" Margin="0,4,0,0">
                            <StackPanel Margin="0,6,0,4">
                                <TextBlock Text="{loc:T 'Sviatky, dni pracovného pokoja a pamätné dni krajín (aj viac naraz):'}" Style="{StaticResource Hint}" />
                                <ItemsControl ItemsSource="{Binding RegionSwitches}" Margin="0,2,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn}" MinWidth="0" Margin="0,0,14,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:T 'Meniny (prvé je meno jazyka rozhrania, ďalšie pod ním):'}" Style="{StaticResource Hint}" />
                                <WrapPanel Margin="0,2,0,6">
                                    <CheckBox Content="{loc:T 'slovenské'}" IsChecked="{Binding NamesSk}" MinWidth="0" Margin="0,0,14,0" />
                                    <CheckBox Content="{loc:T 'české'}" IsChecked="{Binding NamesCs}" MinWidth="0" Margin="0,0,14,0" />
                                    <CheckBox Content="{loc:T 'anglické ekvivalenty (John, Mary …)'}" IsChecked="{Binding NamesEn}" MinWidth="0" />
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" Visibility="{Binding HasSlovakSchool, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{loc:T 'Školské prázdniny SK – kraj:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding SchoolRegions}" SelectedItem="{Binding SchoolRegion}" Width="190" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasCzechSchool, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{loc:T 'Školní prázdniny CZ – okres:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding SchoolDistricts}" SelectedItem="{Binding SchoolDistrict}" Width="190" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </Expander>
                </Border>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
            </StackPanel>
            <!-- the day chosen, or the editor -->
            <Border DockPanel.Dock="Left" Width="340" Margin="0,0,14,0" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,16">
                        <ContentControl Content="{Binding Editor}" Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailWeek}" Style="{StaticResource Hint}" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding DetailNames}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,10,0,6">
                                <Button Content="{loc:T '+ Udalosť'}" Command="{Binding NewEventCommand}" Padding="10,4" Margin="0,0,6,4" />
                                <Button Content="{loc:T '+ Úloha'}" Command="{Binding NewTaskCommand}" Padding="10,4" Margin="0,0,6,4" />
                                <Button Content="{loc:T '+ Poznámka'}" Command="{Binding NewNoteCommand}" Padding="10,4" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBlock Text="{loc:T 'V tento deň tu zatiaľ nič nie je.'}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Visibility="{Binding DetailIsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding DetailSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Color}" Margin="0,0,0,3" />
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="4">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding Color.Color}" Opacity="0.14" />
                                                            </Border.Background>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding Color}" Margin="0,0,8,0" />
                                                                <Button DockPanel.Dock="Right" Command="{Binding OpenCommand}" Padding="6,2" VerticalAlignment="Top" Margin="6,0,0,0"
                                                                        ToolTip="{loc:T 'Otvoriť (záznam v editore, premiéru v Premiérach, epizódu v Novinkách)'}"
                                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" />
                                                                </Button>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" Margin="0,0,6,0"
                                                                                   Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="230">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid>
                <!-- month grid -->
                <Grid Visibility="{Binding IsMonth, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding WeekdayNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand" ToolTip="{Binding ToolTip}">
                                    <Border Style="{StaticResource CalendarDayFrame}" Margin="1" Padding="4,2" ClipToBounds="True">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding DayText}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Names1}" FontSize="10.5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Names2}" FontSize="10" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Holiday}" FontSize="10.5" Foreground="#D94F4F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasHoliday, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding More}" FontSize="10.5" Style="{StaticResource Hint}" />
                                            <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource CalendarEntryChip}" />
                                        </DockPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <!-- week: seven columns -->
                <ItemsControl ItemsSource="{Binding Days}" Visibility="{Binding IsWeek, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding SelectCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand">
                                <Border Style="{StaticResource CalendarDayFrame}" Margin="1" Padding="6,4">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding LongText}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Names1}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Names2}" FontSize="10.5" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Names3}" FontSize="10.5" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Holiday}" FontSize="11" Foreground="#D94F4F" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Visibility="{Binding HasHoliday, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource CalendarEntryChip}" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- the week, the month and the agenda as lists -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand">
                                    <Border Style="{StaticResource CalendarDayFrame}" Margin="0,0,0,4" Padding="10,6" CornerRadius="6">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left" Width="190" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding LongText}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="{Binding Names1}" FontSize="11.5" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Names2}" FontSize="11" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Names3}" FontSize="11" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Holiday}" Foreground="#D94F4F" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Visibility="{Binding HasHoliday, Converter={StaticResource BoolToVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding Shown}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,1,0,1" ToolTip="{Binding ToolTip}">
                                                                <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontWeight="SemiBold" Width="44" />
                                                                <TextBlock>
                                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    <Run Text="  " />
                                                                    <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- the year: twelve small months -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsYearMonths, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Months}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="236" Margin="0,0,10,10" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding DataContext.WeekdayNames, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="10" Style="{StaticResource Hint}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding SelectCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand" ToolTip="{Binding ToolTip}" Height="26">
                                                        <Border Style="{StaticResource CalendarDayFrame}" Margin="0.5" CornerRadius="3">
                                                            <Grid>
                                                                <TextBlock Text="{Binding DayText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Ellipse Width="5" Height="5" Fill="#D46A8C" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                                                         Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- the year in rows: days 1 – 31 by months -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding IsYearRows, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MinWidth="720">
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock DockPanel.Dock="Left" Width="30" />
                            <ItemsControl ItemsSource="{Binding MonthNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding YearRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="30" Text="{Binding Day}" FontSize="11" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                                        <ItemsControl ItemsSource="{Binding Months}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="12" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding SelectCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand" ToolTip="{Binding ToolTip}" Height="20">
                                                        <Border Style="{StaticResource CalendarDayFrame}" Margin="0.5" Padding="3,0">
                                                            <DockPanel>
                                                                <Ellipse DockPanel.Dock="Right" Width="5" Height="5" Fill="#D46A8C" VerticalAlignment="Center"
                                                                         Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock Text="{Binding Holiday}" FontSize="9.5" Foreground="#D94F4F" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:TasksPageViewModel}">
        <DockPanel Margin="24,12,24,10">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Plánované úlohy'}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="{loc:T 'Úlohy napíšte jedným riadkom, ako by ste ich povedali – deň, čas, #štítky a ! (vysoká priorita) UNIVERSUM pochopí. Úloha s termínom je aj v Kalendári. Hore sú úlohy, ktoré navrhuje UNIVERSUM.'}" />
                <!-- one line -->
                <DockPanel Margin="0,0,0,2">
                    <Button DockPanel.Dock="Right" Content="{loc:T 'Pridať'}" Command="{Binding AddCommand}" Padding="14,5" Margin="8,0,0,0" FontWeight="SemiBold" />
                    <Button DockPanel.Dock="Right" Content="{loc:T 'Nová úloha…'}" Command="{Binding NewCommand}" Padding="12,5" Margin="8,0,0,0" />
                    <TextBox Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,5"
                             ToolTip="{loc:T 'Napríklad: zajtra o 20:00 spracovať film #kino !  ·  do piatku zavolať  ·  za 3 dni …  – Enter pridá'}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="{Binding QuickHint}" FontSize="12" Margin="2,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QuickText}" Value="">
                                    <Setter Property="Opacity" Value="0.8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- the suggestions of UNIVERSUM -->
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8" Background="#14D46A8C"
                        Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:T 'Obnoviť'}" Command="{Binding RefreshCommand}" Padding="10,3" />
                            <TextBlock Text="{loc:T 'UNIVERSUM navrhuje'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,2">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="#D46A8C" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionText}" Command="{Binding ActionCommand}" Padding="10,3" Margin="6,0,0,0" FontWeight="SemiBold"
                                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{loc:T 'Prevziať'}" Command="{Binding TakeCommand}" Padding="10,3" Margin="6,0,0,0" ToolTip="{loc:T 'Urobí z návrhu úlohu'}" />
                                            <Button Content="{loc:T 'Skryť'}" Command="{Binding HideCommand}" Padding="10,3" Margin="6,0,0,0" ToolTip="{loc:T 'Tento návrh sa už neukáže'}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- owner, 31. 10. 2026: tasks for UNIVERSUM – what it does by itself at a time -->
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8" Background="#147A6FC9">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:T 'Nová akcia UNIVERSUM…'}" Command="{Binding NewActionCommand}" Padding="10,3"
                                    ToolTip="{loc:T 'Napríklad každú noc o 3:00 obnoviť Premiéry a Novinky alebo synchronizovať listy HISTRA'}" />
                            <TextBlock Text="{loc:T 'UNIVERSUM vykoná sám'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{loc:T 'Zatiaľ nič – akciu (obnoviť Premiéry a Novinky, synchronizovať HISTRA, analyzovať priečinok, spustiť MEGA dávku) naplánujete tlačidlom vpravo alebo v udalosti Kalendára.'}"
                                   Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasActions, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,2">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#7A6FC9" />
                                        <Button DockPanel.Dock="Right" Content="{loc:T 'Upraviť'}" Command="{Binding EditCommand}" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding What, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Next}" Style="{StaticResource Hint}" FontSize="11.5" />
                                            <TextBlock Text="{Binding Last}" Style="{StaticResource Hint}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasLast, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- the view and the filters -->
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{loc:T 'Štítok:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding TagChoices}" SelectedItem="{Binding Tag}" Width="130" Margin="0,0,12,0" />
                        <TextBlock Text="{loc:T 'Hľadať:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton Content="{loc:T 'Zoznam'}" IsChecked="{Binding IsList}" GroupName="TasksView" MinWidth="0" Margin="0,0,12,0" />
                        <RadioButton Content="{loc:T 'Tabuľa'}" IsChecked="{Binding IsBoard}" GroupName="TasksView" MinWidth="0" Margin="0,0,20,0" />
                        <CheckBox Content="{loc:T 'Ukázať hotové'}" IsChecked="{Binding ShowDone}" MinWidth="0" Margin="0,0,12,0" />
                        <Button Content="{loc:T 'Hotové do koša'}" Command="{Binding EmptyDoneCommand}" Padding="10,3" Margin="0,0,8,0" />
                        <Button Content="{loc:T 'Tlač a export…'}" Command="{Binding PrintCommand}" Padding="10,3" Margin="0,0,16,0" ToolTip="{loc:T 'Tlač s náhľadom, PDF, HTML, iCalendar, CSV, Markdown'}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </WrapPanel>
                </DockPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
            </StackPanel>
            <!-- the editor on the right -->
            <Border DockPanel.Dock="Right" Width="340" Margin="14,0,0,0" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding Editor}" Margin="16,12,16,16" />
                </ScrollViewer>
            </Border>
            <Grid>
                <TextBlock Text="{loc:T 'Zatiaľ tu nie sú žiadne úlohy – napíšte prvú do riadku hore.'}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <!-- the list by due day -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Color}" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TaskCard}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- the board -->
                <Grid Visibility="{Binding IsBoard, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T 'Na urobenie'}" FontWeight="SemiBold" FontSize="14" Foreground="#E09A3E" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ToDo}" ItemTemplate="{StaticResource TaskCard}" />
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T 'Rozpracované'}" FontWeight="SemiBold" FontSize="14" Foreground="#5B8FD9" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InProgress}" ItemTemplate="{StaticResource TaskCard}" />
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="4">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:T 'Hotové'}" FontWeight="SemiBold" FontSize="14" Foreground="#63C48F" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource TaskCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:TmdbTrayChoice}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="190" Margin="0,0,4,0" ToolTip="{Binding ToolTip}">
                <ComboBox x:Name="TrayBox" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsEnabled="{Binding HasRows}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <!-- owner, 14. 11. 2026: the series first, a line, then the films -->
                            <Border BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StartsFilms}" Value="True">
                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                <Setter Property="Padding" Value="0,4,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Label}" ToolTip="{Binding ToolTip}" />
                            </Border>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:T 'Zásobník TMDB'}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,30,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TrayBox}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Content="{loc:T 'Z prehliadača'}" Command="{Binding ReadBrowserCommand}" Padding="8,3"
                    ToolTip="{loc:T 'Prečíta filmy a seriály z TMDB otvorené v oknách prehliadača (Chrome, Edge, Firefox…): kartu vpredu presne podľa adresy, ostatné podľa názvu a roka – nejasné označí „over“.'}" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" />
        </StackPanel>
    </DataTemplate>
    <!-- a link of a note on a row of its own (owner, 7. 11. 2026): shortened when long, the whole address in the tooltip,
         a click opens the page -->
    <DataTemplate DataType="{x:Type pages:NoteLinkView}">
        <DockPanel HorizontalAlignment="Left" LastChildFill="True">
            <!-- owner, 12. 11. 2026: a title of the Zásobník TMDB removed alone -->
            <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                    Padding="3,0" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="{loc:T 'Odstrániť tento titul zo zásobníka (dá sa vrátiť)'}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
            </Button>
            <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Cursor="Hand" HorizontalAlignment="Left" Margin="0,1" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding Shown}" TextTrimming="CharacterEllipsis" TextDecorations="Underline" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Button>
        </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:TitleNoteEditor}">
        <StackPanel>
            <TextBlock Text="{loc:T 'Poznámka k titulu'}" Style="{StaticResource Hint}" />
            <TextBlock Text="{Binding Caption}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" />
            <!-- the links of the note, each on a row, to open them (owner, 7. 11. 2026) -->
            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:T 'Odkazy'}" Style="{StaticResource Hint}" />
                <ItemsControl ItemsSource="{Binding Links}" Focusable="False" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{loc:T 'Tá istá poznámka je pri titule v Premiérach a Novinkách – zmena platí všade. Prázdna poznámka sa odstráni.'}" />
            <WrapPanel>
                <Button Content="{loc:T 'Uložiť'}" Command="{Binding SaveCommand}" Padding="14,5" Margin="0,0,8,0" FontWeight="SemiBold" />
                <Button Content="{loc:T 'Zrušiť'}" Command="{Binding CancelCommand}" Padding="12,5" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:NotesPageViewModel}">
        <DockPanel Margin="24,12,24,10">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Poznámky'}" />
                    <ContentControl Content="{Binding DataContext.TrayService, RelativeSource={RelativeSource AncestorType=Window}}" ContentTemplate="{DynamicResource TrayAutoSwitch}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="16,0,0,4" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="{loc:T 'Vaše poznámky, poznámky k dňom z Kalendára a poznámky k titulom z Premiér a Noviniek na jednom mieste. Poznámku môžete napísať aj hlasom – cez hlasové písanie Windows alebo nahrávkou, ktorú UNIVERSUM prepíše v počítači.'}" />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{loc:T 'Pridať'}" Command="{Binding AddCommand}" Padding="14,5" Margin="8,0,0,0" FontWeight="SemiBold" />
                    <Button DockPanel.Dock="Right" Content="{loc:T 'Nová poznámka…'}" Command="{Binding NewCommand}" Padding="12,5" Margin="8,0,0,0" ToolTip="{loc:T 'Poznámka s textom, štítkami, farbou a hlasom'}" />
                    <TextBox Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,5"
                             ToolTip="{loc:T 'Rýchla poznámka – prvá veta je názov, #slová sú štítky; Enter ju pridá'}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{loc:T 'Štítok:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding TagChoices}" SelectedItem="{Binding Tag}" Width="120" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding Source={x:Static pages:NotesPageViewModel.Sorts}}" SelectedItem="{Binding Sort}" Width="140" Margin="0,0,10,0" />
                        <TextBlock Text="{loc:T 'Hľadať:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton Content="{loc:T 'Všetky'}" IsChecked="{Binding ShowAll}" GroupName="NotesSource" MinWidth="0" Margin="0,0,12,0" />
                        <RadioButton Content="{loc:T 'Moje'}" IsChecked="{Binding ShowMine}" GroupName="NotesSource" MinWidth="0" Margin="0,0,12,0" />
                        <RadioButton Content="{loc:T 'K dňom'}" IsChecked="{Binding ShowDays}" GroupName="NotesSource" MinWidth="0" Margin="0,0,12,0" />
                        <RadioButton Content="{loc:T 'K titulom'}" IsChecked="{Binding ShowTitles}" GroupName="NotesSource" MinWidth="0" Margin="0,0,12,0" />
                        <RadioButton Content="{Binding BinText}" IsChecked="{Binding ShowBin}" GroupName="NotesSource" MinWidth="0" Margin="0,0,10,0" />
                        <Button Content="{loc:T 'Tlač a export…'}" Command="{Binding PrintCommand}" Padding="10,3" Margin="0,0,8,0" ToolTip="{loc:T 'Tlač s náhľadom, PDF, HTML, Markdown, CSV'}" />
                        <CheckBox Content="{loc:T 'Meno namiesto linku'}" IsChecked="{Binding LinkNames}" VerticalAlignment="Center" Margin="4,0,12,0"
                                  ToolTip="{loc:T 'Pri odkaze na TMDB sa ukáže názov filmu alebo seriálu – pôvodný, pri inom písme ako latinka (čínsky, kórejský…) anglický, ako v knižnici. Celý odkaz je v bublinke pri myši.'}" />
                        <Button Content="{loc:T 'Vysypať kôš'}" Command="{Binding EmptyBinCommand}" Padding="10,3"
                                Visibility="{Binding ShowBin, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:T 'Záznamy v koši sa odstránia natrvalo (aj nahrávky poznámok)'}" />
                    </WrapPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <Button Content="{loc:T 'Vrátiť'}" Command="{Binding UndoTrayCommand}" Padding="8,1" Margin="10,0,0,0"
                            Visibility="{Binding CanUndoTray, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:T 'Vráti zásobník, ako bol pred poslednou zmenou (vyprázdnením alebo odstránením titulu)'}" />
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Right" Width="{Binding EditorWidth}" Margin="14,0,0,0" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <!-- owner, 8. 11. 2026: the note opened larger with a click; the tray emptied from inside it too -->
                    <WrapPanel DockPanel.Dock="Top" Margin="12,8,12,0">
                        <Button Command="{Binding WidenEditorCommand}" Padding="8,3" Margin="0,0,8,0" ToolTip="{loc:T 'Širšia poznámka (ďalší klik ešte širšia, potom zas užšia)'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T 'Rozšíriť'}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearTrayCommand}" Padding="8,3" Margin="0,0,8,0" Visibility="{Binding EditingTray, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{loc:T 'Vyprázdniť tento zásobník – nezostane v ňom žiaden titul z TMDB, vlastné riadky ostanú (dá sa vrátiť)'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T 'Vyprázdniť zásobník'}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding Editor}" Margin="16,8,16,16" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid>
                <TextBlock Text="{loc:T 'Zatiaľ tu nie sú žiadne poznámky.'}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding OpenCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand" Margin="0,0,10,10">
                                    <Border Width="{Binding CardWidth}" MinHeight="120" CornerRadius="8" Padding="12,10" Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="0,4,0,0">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" FontSize="12" Margin="0,2,6,0" ToolTip="{loc:T 'Má hlasovú nahrávku'}"
                                                               Visibility="{Binding HasRecording, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Command="{Binding ClearTrayCommand}" Padding="4,1" Margin="0,0,4,0" ToolTip="{loc:T 'Vyprázdniť tento zásobník – nezostane v ňom žiaden titul z TMDB, vlastné riadky ostanú (dá sa vrátiť)'}"
                                                            Visibility="{Binding IsTray, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding WidenCommand}" Padding="4,1" Margin="0,0,4,0" ToolTip="{Binding WidenToolTip}"
                                                            Visibility="{Binding CanWiden, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding PinCommand}" Padding="4,1" Margin="0,0,4,0" ToolTip="{loc:T 'Pripnúť hore / odopnúť'}"
                                                            Visibility="{Binding CanPin, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                                    <Setter Property="Text" Value="&#xE718;" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE840;" />
                                                                            <Setter Property="Foreground" Value="#D46A8C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button Command="{Binding RestoreCommand}" Padding="4,1" Margin="0,0,4,0" ToolTip="{loc:T 'Vrátiť z koša'}"
                                                            Visibility="{Binding InBin, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding DeleteCommand}" Padding="4,1" ToolTip="{loc:T 'Do koša'}"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                                <Run Text="{Binding Where, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding When, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Tags}" FontSize="11.5" Foreground="#D46A8C" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <!-- owner, 7. 11. 2026: the text, and every link on a row of its own (a click opens it) -->
                                            <StackPanel Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                                                           Visibility="{Binding IsLink, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                <ContentControl Content="{Binding Link}" Focusable="False" IsTabStop="False"
                                                                                Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding More}" Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,0"
                                                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
