<UserControl x:Class="Universum.App.Player.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:player="clr-namespace:Universum.App.Player"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- the picture with the subtitles drawn over it (a click plays or pauses) -->
        <Border Background="Black" CornerRadius="6" ClipToBounds="True" MouseLeftButtonDown="OnPictureClick">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                        <Image Source="{Binding Picture}" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                        <player:SubtitleOverlay Primary="{Binding PrimaryText}" Secondary="{Binding SecondaryText}" />
                    </Grid>
                </Viewbox>
                <TextBlock Text="{Binding Message}" Foreground="#DDFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
            </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding PreviousSubtitleCommand}" Padding="8,4" Margin="0,0,4,0" ToolTip="Predchádzajúci titulok">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE892;" FontSize="14" />
                </Button>
                <Button Content="−5 s" Command="{Binding SeekByCommand}" CommandParameter="-5" Padding="8,4" Margin="0,0,4,0" />
                <Button Command="{Binding PlayPauseCommand}" Padding="14,4" Margin="0,0,4,0" ToolTip="Prehrať / pozastaviť (medzerník)">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding PlayGlyph}" FontSize="14" />
                </Button>
                <Button Content="+5 s" Command="{Binding SeekByCommand}" CommandParameter="5" Padding="8,4" Margin="0,0,4,0" />
                <Button Command="{Binding NextSubtitleCommand}" Padding="8,4" Margin="0,0,10,0" ToolTip="Ďalší titulok">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" FontSize="14" />
                </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding Time}" VerticalAlignment="Center" FontFamily="Consolas" Margin="10,0,10,0" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="14" Margin="0,0,4,0" />
                <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Width="70" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Hlasitosť" />
                <ComboBox ItemsSource="{Binding AudioTracks}" SelectedIndex="{Binding AudioTrack}" Width="170" ToolTip="Zvuková stopa" />
            </StackPanel>
            <Slider Minimum="{Binding Start}" Maximum="{Binding End}" Value="{Binding Position}" VerticalAlignment="Center"
                    IsMoveToPointEnabled="True" IsEnabled="{Binding IsOpen}" ToolTip="Pozícia vo filme" />
        </DockPanel>
    </Grid>
</UserControl>
