                            <CheckBox Content="Opraviť chýbajúci index videa (súbor sa zapíše nanovo)" IsChecked="{Binding RepairIndex}" Margin="0,6,0,0" />
                            <TextBlock Text="Veľkosť v názve: hranice SMALL; BIG; BluRay v GB (nad poslednou BluRay BIG)" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="filmy:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding MovieSizes, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,20,0" />
                                <TextBlock Text="seriály:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SeriesSizes, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Uložiť" Command="{Binding SaveCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="Predvolený profil" Command="{Binding ResetCommand}" Padding="16,6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Skontrolovať teraz…" Command="{Binding ShowUpdatesCommand}" Padding="12,5" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Aktualizácie" FontWeight="SemiBold" />
                                <CheckBox Content="Kontrolovať automaticky (pri spustení, najviac raz za deň)" IsChecked="{Binding AutoCheckUpdates}" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Pýta sa len mkvtoolnix.download a github.com, nič o vás sa neposiela." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Zlučovanie" FontWeight="SemiBold" />
                            <CheckBox Content="Pri pridaní viacerých súborov sa pýtať, čo s nimi" IsChecked="{Binding MuxAskWhenAdding}" Margin="0,6,0,0"
                                      ToolTip="Ak ste v okne pridávania zvolili „Vždy použiť túto voľbu“, zaškrtnutím sa bude znova pýtať" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="{Binding MuxAddNote}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Údržba" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Folders}" Margin="0,4,0,8" />
                            <Button Content="Vymazať vyrovnávaciu pamäť analýzy" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left" Padding="12,5" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Background="{DynamicResource LayerFillColorDefaultBrush}">
            <TextBlock DockPanel.Dock="Top" Text="UNIVERSUM" FontSize="20" FontWeight="SemiBold" Margin="20,20,20,16" />
            <!-- Dashboard on its own, then the groups: framed, each with its own tint and a heading in its colour -->
            <ListBox ItemsSource="{Binding ToolsView}" SelectedItem="{Binding SelectedTool}" IsSynchronizedWithCurrentItem="False"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Border x:Name="Frame" Margin="8,4,8,1" Padding="0,0,0,2" CornerRadius="8" BorderThickness="1"
                                                    Background="{Binding Name.Background}" BorderBrush="{Binding Name.Border}">
                                                <StackPanel>
                                                    <TextBlock x:Name="Heading" Text="{Binding Name.Title}" Foreground="{Binding Name.Heading}"
                                                               FontSize="11.5" FontWeight="Bold" Margin="12,5,8,1" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Name.IsFramed}" Value="False">
                                                    <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Frame" Property="Margin" Value="0" />
                                                    <Setter TargetName="Frame" Property="BorderThickness" Value="0" />
                                                    <Setter TargetName="Frame" Property="Padding" Value="0" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <!-- compact rows: the whole rail (four groups) fits a window 740 px high without scrolling -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="MinHeight" Value="29" />
                        <Setter Property="Padding" Value="10,2" />
                        <Setter Property="Margin" Value="4,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,0">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl Grid.Column="1" Content="{Binding SelectedTool.Page}" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding UpdateBadge}" Command="{Binding ShowUpdatesCommand}" Margin="0,0,8,0" Padding="12,4"
                            ToolTip="Aktualizácie MKVToolNix a UNIVERSUM">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Otvoriť v MKVToolNix GUI" Command="{Binding OpenMkvToolNixGuiCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="MKVToolNix…" Command="{Binding SetupCommand}" Padding="12,4" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}">
                    <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MkvToolNixStatus, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
