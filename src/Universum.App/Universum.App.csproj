<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Universum</AssemblyName>
    <RootNamespace>Universum.App</RootNamespace>
    <Description>UNIVERSUM – grafická nadstavba nad MKVToolNix</Description>
    <SatelliteResourceLanguages>sk</SatelliteResourceLanguages>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- the UNIVERSUM icon (drawn by tools/icon/make_icon.py): a letter U in deep space with a ring -->
    <ApplicationIcon>Assets\universum.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- official TMDB logo (blue_short) from https://www.themoviedb.org/about/logos-attribution; the PNG is rendered
         from the unchanged SVG because WPF does not draw SVG -->
    <Resource Include="Assets\tmdb-logo.png" />
    <Resource Include="Assets\universum.ico" />
    <Resource Include="Assets\universum-256.png" />
    <!-- icons of the Explorer's context menu items (the installer points the registry at them) -->
    <Content Include="Assets\menu-*.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- licences of the bundled third-party works (CommunityToolkit.Mvvm), installed with the program -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\tmdb-logo.svg" />
  </ItemGroup>
  <ItemGroup>
    <!-- Návody: the guides in UNIVERSUM's own markup (SK, CZ, EN) and their pictures, cut from the self-test's screenshots
         (invented titles and files only) -->
    <!-- WithCulture="false": "poznamky.sk.txt" is not a Slovak satellite resource, the language is part of its name -->
    <EmbeddedResource Include="Guides\*.txt" LogicalName="Guides.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Guides\obrazky\*.jpg" LogicalName="Guides.obrazky.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Universum.Core\Universum.Core.csproj" />
    <ProjectReference Include="..\Universum.Platform.Windows\Universum.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
