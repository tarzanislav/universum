<!-- UNIVERSUM – the styles and templates by name, used by several pages (merged first into the window and into each dictionary of pages) (14. 11. 2026, step 2 of the review of the code: the templates of MainWindow.xaml by pages) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:Universum.App.Pages"
                    xmlns:app="clr-namespace:Universum.App"
                    xmlns:jobs="clr-namespace:Universum.App.Jobs"
                    xmlns:loc="clr-namespace:Universum.App.Localization"
                    xmlns:player="clr-namespace:Universum.App.Player">
    <!-- owner, 31. 10. 2026: links to the pages where the keys of the services are got (Nastavenia) -->
    <Style x:Key="ServiceLinks" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Button Content="{Binding Text}" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Padding="10,4" Margin="0,0,8,6" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the tables of Premiéry and Novinky: sharp text, links right after the title, optional posters, Vybrané and a note -->
    <Style x:Key="NewsCell" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="NewsSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NewsLink" TargetType="Button">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="NewsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="MinRowHeight" Value="40" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Language" Value="sk-SK" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="CellStyle">
            <Setter.Value>
                <!-- a chosen row stays readable: the tab's pastel colour, never the dark selection of the theme -->
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NewsHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <!-- today's rows tinted and bold; a chosen title gets a stripe of the tab's colour on the left -->
    <Style x:Key="NewsRowBase" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsChosen}" Value="True">
                <Setter Property="BorderBrush" Value="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="NewsTitleCell">
        <DockPanel Margin="6,4">
            <Border DockPanel.Dock="Left" CornerRadius="4" Margin="0,0,10,0" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Width="{Binding DataContext.PosterWidth, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue=38}"
                    Height="{Binding DataContext.PosterHeight, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue=57}"
                    Visibility="{Binding DataContext.ShowPosters, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                <Border CornerRadius="4">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Poster.Image}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <WrapPanel>
                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" VerticalAlignment="Center" ToolTip="{Binding Caption}">
                        <Hyperlink Command="{Binding OpenTmdbCommand}"><Run Text="{Binding Caption, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                    <Button Content="{loc:T 'TMDB'}" Command="{Binding OpenTmdbCommand}" Style="{StaticResource NewsLink}" ToolTip="{loc:T 'Otvoriť na TMDB'}" />
                    <Button Content="{loc:T 'HISTRA'}" Command="{Binding OpenHistraCommand}" Style="{StaticResource NewsLink}" ToolTip="{loc:T 'Otvoriť na HISTRA'}" />
                    <Button Content="{loc:T 'Zdroj'}" Command="{Binding OpenSourceCommand}" Style="{StaticResource NewsLink}" ToolTip="{loc:T 'Otvoriť v zdroji'}"
                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                    <!-- owner, 2. 11. 2026: the title into Poznámky or Plánované úlohy, opened there to be edited -->
                    <Button Command="{Binding ToNoteCommand}" Style="{StaticResource NewsLink}" ToolTip="{loc:T 'Pridať do Poznámok (a otvoriť na úpravu)'}">
                        <TextBlock><Run Text="&#xE70B;" FontFamily="{StaticResource IconFont}" /> <Run Text="{loc:T 'Do poznámok'}" /></TextBlock>
                    </Button>
                    <Button Command="{Binding ToTaskCommand}" Style="{StaticResource NewsLink}" ToolTip="{loc:T 'Pridať do Plánovaných úloh s termínom premiéry (a otvoriť na úpravu)'}">
                        <TextBlock><Run Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" /> <Run Text="{loc:T 'Do úloh'}" /></TextBlock>
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding LocalTitle}" Style="{StaticResource NewsSubtitle}" />
                <TextBlock Text="{Binding Rhythm, FallbackValue=''}" Style="{StaticResource NewsSubtitle}" FontWeight="SemiBold"
                           Foreground="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                <TextBlock Text="{Binding Streaming, FallbackValue=''}" Style="{StaticResource NewsSubtitle}" FontWeight="SemiBold" Foreground="#2F9461"
                           ToolTip="{loc:T 'Kde sa dá titul legálne pozerať (SK, CZ) – údaje JustWatch cez TMDB'}" />
            </StackPanel>
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="NewsChosenCell">
        <CheckBox IsChecked="{Binding IsChosen, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                  ToolTip="{loc:T 'Vybrané – titul, na ktorý sa teším (zobrazíte ich voľbou Zobraziť vybrané)'}" />
    </DataTemplate>
    <!-- a note: its text, and its links as words beside it (the address hides in the word; owner, 29. 10. 2026) -->
    <DataTemplate x:Key="NewsNoteCell">
        <DockPanel Margin="4,3" VerticalAlignment="Center">
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Links}" VerticalAlignment="Center" MaxWidth="240" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Padding="8,1,2,1" Margin="4,1,0,1" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                ToolTip="{Binding ToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                    <Hyperlink Command="{Binding OpenCommand}"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                                </TextBlock>
                                <Button Content="×" Command="{Binding RemoveCommand}" Padding="5,0" MinWidth="0" MinHeight="0" Margin="3,0,0,0"
                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip="{loc:T 'Odstrániť odkaz z poznámky'}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=LostFocus}" MinHeight="30" MinWidth="60" TextWrapping="Wrap" pages:NoteLinks.AskName="True"
                     ToolTip="{loc:T 'Poznámka k titulu – uloží sa, keď pole opustíte. Vložená webová adresa sa zmení na slovo-odkaz vedľa poznámky.'}" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="CalendarEntryChip">
        <Border Margin="0,1,0,0" Padding="4,1" CornerRadius="3" ToolTip="{Binding ToolTip}">
            <Border.Background>
                <SolidColorBrush Color="{Binding Color.Color}" Opacity="0.22" />
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Background="{Binding Color}" Margin="0,1,4,1" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0"
                           Visibility="{Binding HasTime, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Done}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </DataTemplate>
    <Style x:Key="CalendarDayFrame" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                <Setter Property="Background" Value="#0F808080" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSchoolHoliday}" Value="True">
                <Setter Property="Background" Value="#1CE8B93A" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDayOff}" Value="True">
                <Setter Property="Background" Value="#22D94F4F" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="#D46A8C" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding InPeriod}" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="CalendarDayButton" TargetType="Button">
        <ContentPresenter />
    </ControlTemplate>
    <!-- POZNÁMKY – Plánované úlohy (owner, 31. 10. 2026, stage P2) -->
    <DataTemplate x:Key="TaskCard">
        <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding PriorityColor}" Margin="0,0,8,0" />
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsDone}" MinWidth="0" VerticalAlignment="Top" Margin="0,1,6,0" ToolTip="{loc:T 'Hotovo'}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding LeftCommand}" Padding="5,2" Margin="2,0,0,0" ToolTip="{loc:T 'Späť (Na urobenie ← Rozpracované ← Hotové)'}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="10" />
                    </Button>
                    <Button Command="{Binding RightCommand}" Padding="5,2" Margin="2,0,0,0" ToolTip="{loc:T 'Ďalej (Na urobenie → Rozpracované → Hotové)'}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" />
                    </Button>
                    <Button Command="{Binding EditCommand}" Padding="5,2" Margin="2,0,0,0" ToolTip="{loc:T 'Upraviť'}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="10" />
                    </Button>
                    <Button Command="{Binding DeleteCommand}" Padding="5,2" Margin="2,0,0,0" ToolTip="{loc:T 'Do koša'}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="10" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PriorityText}" FontWeight="Bold" Foreground="{Binding PriorityColor}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding DueText}" FontSize="11.5" Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="#D94F4F" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Progress}" FontSize="11.5" Style="{StaticResource Hint}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Tags}" FontSize="11.5" Foreground="#D46A8C" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>
    <!-- POZNÁMKY – Poznámky (owner, 31. 10. 2026, stage P2) -->
    <!-- Zásobník TMDB (owner, 8. 11. 2026): the titles from the browser, one click fills the title; "Z prehliadača" reads the
         open browser windows -->
    <!-- the switch of the automatic gathering of the Zásobník TMDB at the top of the pages (owner, 8. 11. 2026) -->
    <DataTemplate x:Key="TrayAutoSwitch" DataType="{x:Type pages:TmdbTrayService}">
        <ToggleButton IsChecked="{Binding Automatic}" Padding="10,4" ToolTip="{Binding SwitchToolTip}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SwitchText}" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
    </DataTemplate>
</ResourceDictionary>
