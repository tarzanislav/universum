<UserControl x:Class="Universum.App.Pages.MuxTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Bottom">
            <RepeatButton x:Name="LeftButton" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Click="OnLeft" Padding="8,5" Margin="0,0,2,2"
                          Visibility="Collapsed" ToolTip="Posunúť záložky doľava" />
            <RepeatButton x:Name="RightButton" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Click="OnRight" Padding="8,5" Margin="0,0,6,2"
                          Visibility="Collapsed" ToolTip="Posunúť záložky doprava" />
            <Button Content="&#xE710;" FontFamily="{StaticResource IconFont}" Command="{Binding NewSettingsCommand}" Padding="9,5" Margin="0,0,0,2"
                    ToolTip="Nové nastavenia zlučovania (nový výstupný súbor)" />
        </StackPanel>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      ScrollChanged="OnScrollChanged" PreviewMouseWheel="OnWheel">
            <ItemsControl x:Name="Tabs" ItemsSource="{Binding Settings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,3,0">
                            <Border x:Name="Tab" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="10,6,4,6" Cursor="Hand"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="Transparent" ToolTip="{Binding DisplayName}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Name" Text="{Binding ShortName}" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text=" •" VerticalAlignment="Center" FontWeight="Bold" ToolTip="Zmeny ešte nie sú vo fronte"
                                               Visibility="{Binding IsUnprocessed, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Padding="5,3" Margin="6,0,0,0" MinWidth="0" MinHeight="0"
                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip="Zavrieť tieto nastavenia"
                                            Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="Accent" Height="3" VerticalAlignment="Bottom" CornerRadius="1.5" Margin="8,0" Background="#0067C0" Visibility="Hidden" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
