<Window x:Class="Universum.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Universum.App.Pages"
        xmlns:app="clr-namespace:Universum.App"
        xmlns:jobs="clr-namespace:Universum.App.Jobs"
        xmlns:loc="clr-namespace:Universum.App.Localization"
        xmlns:player="clr-namespace:Universum.App.Player"
        Title="UNIVERSUM" Icon="pack://application:,,,/Assets/universum.ico" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <!-- owner, 29. 10. 2026: a chosen row of any table stays readable – a light blue with dark text, never the theme's
             dark selection (the tables of Premiéry and Novinky have their own) -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE3F8" />
                    <Setter Property="BorderBrush" Value="#CFE3F8" />
                    <Setter Property="Foreground" Value="#141414" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- owner, 31. 10. 2026: links to the pages where the keys of the services are got (Nastavenia) -->
        <Style x:Key="ServiceLinks" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Text}" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Padding="10,4" Margin="0,0,8,6" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- the tables of Premiéry and Novinky: sharp text, links right after the title, optional posters, Vybrané and a note -->
        <Style x:Key="NewsCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="NewsSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NewsLink" TargetType="Button">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NewsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="MinRowHeight" Value="40" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Language" Value="sk-SK" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <!-- a chosen row stays readable: the tab's pastel colour, never the dark selection of the theme -->
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NewsHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <!-- today's rows tinted and bold; a chosen title gets a stripe of the tab's colour on the left -->
        <Style x:Key="NewsRowBase" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="NewsTitleCell">
            <DockPanel Margin="6,4">
                <Border DockPanel.Dock="Left" CornerRadius="4" Margin="0,0,10,0" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Width="{Binding DataContext.PosterWidth, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue=38}"
                        Height="{Binding DataContext.PosterHeight, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue=57}"
                        Visibility="{Binding DataContext.ShowPosters, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="4">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Poster.Image}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" VerticalAlignment="Center" ToolTip="{Binding Caption}">
                            <Hyperlink Command="{Binding OpenTmdbCommand}"><Run Text="{Binding Caption, Mode=OneWay}" /></Hyperlink>
                        </TextBlock>
                        <Button Content="{loc:T 'TMDB'}" Command="{Binding OpenTmdbCommand}" Style="{StaticResource NewsLink}" ToolTip="Otvoriť na TMDB" />
                        <Button Content="{loc:T 'HISTRA'}" Command="{Binding OpenHistraCommand}" Style="{StaticResource NewsLink}" ToolTip="Otvoriť na HISTRA" />
                        <Button Content="{loc:T 'Zdroj'}" Command="{Binding OpenSourceCommand}" Style="{StaticResource NewsLink}" ToolTip="Otvoriť v zdroji"
                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding LocalTitle}" Style="{StaticResource NewsSubtitle}" />
                    <TextBlock Text="{Binding Rhythm, FallbackValue=''}" Style="{StaticResource NewsSubtitle}" FontWeight="SemiBold"
                               Foreground="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <TextBlock Text="{Binding Streaming, FallbackValue=''}" Style="{StaticResource NewsSubtitle}" FontWeight="SemiBold" Foreground="#2F9461"
                               ToolTip="Kde sa dá titul legálne pozerať (SK, CZ) – údaje JustWatch cez TMDB" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="NewsChosenCell">
            <CheckBox IsChecked="{Binding IsChosen, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                      ToolTip="Vybrané – titul, na ktorý sa teším (zobrazíte ich voľbou Zobraziť vybrané)" />
        </DataTemplate>
        <!-- a note: its text, and its links as words beside it (the address hides in the word; owner, 29. 10. 2026) -->
        <DataTemplate x:Key="NewsNoteCell">
            <DockPanel Margin="4,3" VerticalAlignment="Center">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Links}" VerticalAlignment="Center" MaxWidth="240" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,1,2,1" Margin="4,1,0,1" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    ToolTip="{Binding ToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                        <Hyperlink Command="{Binding OpenCommand}"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                                    </TextBlock>
                                    <Button Content="×" Command="{Binding RemoveCommand}" Padding="5,0" MinWidth="0" MinHeight="0" Margin="3,0,0,0"
                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip="Odstrániť odkaz z poznámky" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=LostFocus}" MinHeight="30" MinWidth="60" TextWrapping="Wrap" pages:NoteLinks.AskName="True"
                         ToolTip="Poznámka k titulu – uloží sa, keď pole opustíte. Vložená webová adresa sa zmení na slovo-odkaz vedľa poznámky." />
            </DockPanel>
        </DataTemplate>
        <!-- MEGA spracovanie (owner, 29. 10. 2026): batches written later, each with its start -->
        <DataTemplate DataType="{x:Type pages:MegaPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="150" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'MEGA spracovanie'}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button Content="{loc:T 'Spustiť teraz'}" Command="{Binding StartCommand}" Padding="14,4" Margin="0,0,8,0" ToolTip="Pridá vybranú dávku do Fronty úloh a spustí ju" />
                    <Button Content="{loc:T 'Upraviť v Hromadnom spracovaní'}" Command="{Binding EditCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="Otvorí dávku so všetkými rozhodnutiami v Hromadnom spracovaní – opravíte ju a dáte Uložiť do dávky" />
                    <Button Content="{loc:T 'Znova preskočené a chybné'}" Command="{Binding RetryCommand}" Padding="12,4" Margin="0,0,16,0"
                            ToolTip="Súbory dokončenej dávky, ktoré sa preskočili, nepodarili alebo zrušili, sa znova skontrolujú a zapíšu" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="Dávku vyššie (poradie pre „po predchádzajúcej dávke“)" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" Margin="0,0,16,0" ToolTip="Dávku nižšie" />
                    <Button Content="{loc:T 'Zmazať originály'}" Command="{Binding DeleteOriginalsCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="Dávka odoslaná so „zmazať ručne“: originály jej zapísaných súborov do Koša Windows" />
                    <Button Content="{loc:T 'Odstrániť dávku'}" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="Súbory sa nemenia; nezapísané sa v Hromadnom spracovaní znova ukážu ako voľné" />
                    <Button Content="{loc:T 'Vyčistiť dokončené'}" Command="{Binding ClearFinishedCommand}" Padding="12,4" />
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dávka" Binding="{Binding Label}" />
                        <DataGridTextColumn Header="Čo obsahuje" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Súbory" Binding="{Binding Count}" Width="Auto" />
                        <DataGridTextColumn Header="Originály" Binding="{Binding Originals}" Width="Auto" />
                        <DataGridTemplateColumn Header="Spustiť" Width="Auto" MinWidth="330">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSchedule}">
                                        <ComboBox ItemsSource="{Binding StartChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                  SelectedValue="{Binding Start, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" FontSize="12" />
                                        <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" FontSize="12" Width="120"
                                                    Visibility="{Binding IsAt, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBox Text="{Binding Time, UpdateSourceTrigger=LostFocus}" Margin="6,0,0,0" Width="56" FontSize="12" VerticalContentAlignment="Center"
                                                 Visibility="{Binding IsAt, Converter={StaticResource BoolToVisibility}}" ToolTip="Čas spustenia, napr. 2:00" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="*" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="3" Margin="0,12,0,6">
                    <Button DockPanel.Dock="Right" Content="Vybrať súbor z dávky" Command="{Binding RemoveFileCommand}" Padding="12,4"
                            ToolTip="Súbor sa nemení; v Hromadnom spracovaní sa znova ukáže ako voľný" />
                    <TextBlock Text="Súbory vybranej dávky" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid Grid.Row="4" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Súbor" Binding="{Binding Name}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Folder}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cieľ v knižnici" Binding="{Binding Target}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Target}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="Auto" MinWidth="90" />
                        <DataGridTextColumn Header="Poznámka" Binding="{Binding Note}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:PlaceholderPageViewModel}">
            <StackPanel Margin="32">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" MaxWidth="640" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{Binding Stage, StringFormat='Pripravuje sa – {0}.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pages:InfoPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- the files of the multiplexer and the batch: one click shows each -->
                <Border Width="280" Margin="0,0,16,0" Style="{StaticResource Card}" Padding="8"
                        Visibility="{Binding HasKnownFiles, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Súbory v práci" FontWeight="SemiBold" Margin="4,0,0,2" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12" Margin="4,0,0,6" TextWrapping="Wrap"
                                   Text="Zo Zlučovania a z Hromadného spracovania – kliknutím zobrazíte informácie." />
                        <ListBox ItemsSource="{Binding KnownFiles}" SelectedItem="{Binding SelectedKnown}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding Path}" Margin="0,1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Informácie o súbore'}" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{Binding FileName}" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="2" Margin="0,4,0,12">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="{Binding Kind, Converter={StaticResource TrackTypeBrush}}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTemplateColumn Header="Typ" Width="74" SortMemberPath="Type">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                            <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" />
                            <DataGridTextColumn Header="Jazyk" Binding="{Binding Language}" />
                            <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="*" />
                            <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="Forced" Binding="{Binding IsForced, Mode=OneWay}" />
                            <DataGridTextColumn Header="Ďalšie príznaky" Binding="{Binding FlagMarks}" />
                            <DataGridTextColumn Header="Vlastnosti" Binding="{Binding Properties}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:RulesPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Vymazať frontu" Command="{Binding ClearCommand}" Padding="12,6" Margin="8,0,0,0"
                            ToolTip="Zabudne otvorený, ešte nespracovaný súbor (na disku sa nič nezmení)" />
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Single spracovanie'}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <TextBlock Text="{Binding Issues}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
                <!-- owner, 29. 10. 2026: the tracks in the order of the result; dragged by the grip (or the arrows) within their type -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False"
                          AllowDrop="True" DragOver="OnRuleDragOver" Drop="OnRuleDrop">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="{Binding Type, Converter={StaticResource TrackTypeBrush}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRemovedByLanguage}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Poradie" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanMove, Converter={StaticResource BoolToVisibility}}">
                                        <Border Background="Transparent" Cursor="SizeAll" Padding="3,2" ToolTip="Chyťte a potiahnite stopu hore alebo dole (v rámci zvukov alebo titulkov)"
                                                PreviewMouseLeftButtonDown="OnRuleGripDown" MouseMove="OnRuleGripMove">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="14" />
                                        </Border>
                                        <Button Command="{Binding MoveUpCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu hore">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10" />
                                        </Button>
                                        <Button Command="{Binding MoveDownCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu dole">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding PositionText}" />
                        <DataGridTemplateColumn Header="Typ" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TypeChip}" Background="{Binding Type, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                        <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Codec}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Jazyk (pred → po)" Width="175">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- owner, 29. 10. 2026: also a language written in the file can be corrected ("EN" that is Czech) -->
                                    <StackPanel>
                                        <TextBlock Text="{Binding LanguageBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding LanguageAfter}" FontWeight="SemiBold" Visibility="{Binding CanChooseLanguage, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" Visibility="{Binding CanChooseLanguage, Converter={StaticResource BoolToVisibility}}"
                                                  ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="SlovakName" MinWidth="160" ToolTip="Jazyk stopy – neurčený, alebo nesprávny jazyk zapísaný v súbore" />
                                        <TextBlock Text="{Binding LanguageNote}" FontSize="11" TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasLanguageNote, Converter={StaticResource BoolToVisibility}}" />
                                        <CheckBox Visibility="{Binding CanKeep, Converter={StaticResource BoolToVisibility}}" IsChecked="{Binding KeepChecked, UpdateSourceTrigger=PropertyChanged}"
                                                  FontSize="11.5" Margin="0,2,0,0" ToolTip="Tieto titulky ponechať, hoci ich jazyk nie je v zozname titulkov (Nastavenia)">
                                            <TextBlock Text="{Binding ResultNote}" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="260" />
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Názov (pred → po)" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NameBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NameAfter}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding CanName, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <!-- owner, 30. 10. 2026: Track name – the name can be written or added to -->
                                        <TextBox Text="{Binding EditedName, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" MinWidth="120"
                                                 Visibility="{Binding CanName, Converter={StaticResource BoolToVisibility}}"
                                                 ToolTip="Názov stopy vo výsledku – môžete ho prepísať alebo doň dopísať (potvrdí sa po opustení poľa); prázdny = bez názvu" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultAfter}" />
                        <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledAfter}" />
                        <!-- owner, 30. 10. 2026: forced also by the small amount of subtitles – UNIVERSUM's suggestion, changed here -->
                        <DataGridTemplateColumn Header="Forced" Width="Auto" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsForced, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Margin="0,0,4,0"
                                                      Visibility="{Binding IsSubtitles, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Forced titulky (aktívne len CZ, inak SK; ostatné dostanú len názov Forced)" />
                                            <TextBlock Text="{Binding ForcedAfter}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ForcedNote}" FontSize="11" TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Iné príznaky" Binding="{Binding OtherFlagsAfter}" />
                        <DataGridTextColumn Header="Rola" Binding="{Binding Role}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Originál:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                            <RadioButton Content="zachovať" IsChecked="{Binding KeepOriginal}" Margin="0,0,16,0" GroupName="original" />
                            <RadioButton Content="vymazať (zatiaľ vypnuté)" IsChecked="{Binding DeleteOriginal}" Margin="0,0,24,0" GroupName="original"
                                         ToolTip="Single spracovanie originály vždy zachová – mazanie originálov je len v Hromadnom spracovaní." ToolTipService.ShowOnDisabled="True" IsEnabled="False" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,8,0">
                                <Run Text="Knižnica:" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="{loc:T 'Priečinok…'}" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,4" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton Content="film" IsChecked="{Binding IsMovie}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <TextBlock Text="Titul:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,6,0"
                                     ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
                            <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="220" Margin="0,0,16,0"
                                      IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{loc:T 'Potvrdiť titul'}" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                    Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="Doplnok:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" Width="130" VerticalAlignment="Center"
                                          ToolTip="Doplnok k názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Epizóda:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="napr. S01E04" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}">
                            <Run Text="Cieľ:" FontWeight="SemiBold" /> <Run Text="{Binding Target, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap">
                            <Run Text="{Binding Tmdb.Message, Mode=OneWay}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" />
                        </TextBlock>
                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{loc:T 'Vrátiť späť'}" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="{loc:T 'Revízia'}" Command="{Binding ReviseCommand}" Margin="0,0,8,0" Padding="16,6"
                                        Visibility="{Binding CanRevise, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Výsledok už v knižnici je – spracovať znova ako novú verziu: nová sa zapíše a overí, až potom ide doterajšia do Koša" />
                                <Button Content="{loc:T 'Do fronty'}" Command="{Binding QueueCommand}" Margin="0,0,8,0" Padding="16,6" ToolTip="Pridá súbor do fronty úloh namiesto okamžitého spracovania" />
                                <Button Content="{loc:T 'Použiť pravidlá'}" Command="{Binding ApplyCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:MultiplexerPageViewModel}">
            <Grid Margin="24,12,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Zlučovanie'}" Margin="0,0,16,4" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <pages:MuxTabStrip Grid.Row="1" Margin="0,4,0,0" />
                <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="0,8,8,8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                    <ContentControl Content="{Binding Current}" />
                </Border>
                <!-- status line as in MKVToolNix: the queue and the progress of the running job -->
                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:T 'Pridať súbory…'}" Command="{Binding AddFilesCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="{loc:T 'Spustiť zlučovanie'}" Command="{Binding Current.StartCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="{loc:T 'Do fronty'}" Command="{Binding Current.QueueCommand}" Padding="14,6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QueueStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ProgressBar Width="140" Height="6" Maximum="1" Value="{Binding QueueProgress, Mode=OneWay}" VerticalAlignment="Center"
                                     Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>
        <!-- one multiplex settings: source files and tracks on the left, properties on the right, the output below -->
        <DataTemplate DataType="{x:Type pages:MuxSettingsViewModel}">
            <Grid x:Name="SettingsRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="400" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="250" MaxWidth="420" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" MinHeight="56" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="96" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{loc:T 'Vymazať všetko'}" Padding="10,3" Margin="0,0,6,0"
                                        Command="{Binding DataContext.ClearSourcesCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                        ToolTip="Odstráni všetky zdrojové súbory zo Zlučovania (na disku sa nič nezmení)" />
                                <Button Content="{loc:T 'Informácie'}" Padding="10,3" Margin="0,0,6,0"
                                        Command="{Binding DataContext.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                        ToolTip="Zobrazí vybraný zdrojový súbor (alebo súbor vybranej stopy) na stránke Informácie" ToolTipService.ShowOnDisabled="True" />
                                <Button Content="{loc:T 'Odstrániť'}" Command="{Binding RemoveSourceCommand}" Padding="10,3"
                                        ToolTip="Odstráni vybraný zdrojový súbor (aj jeho stopy), časť alebo pripojený súbor" ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                            <TextBlock Text="Zdrojové súbory" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,8,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SourceRows}" SelectedItem="{Binding SelectedSource}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                            <!-- right click (MKVToolNix GUI: the menu of Source files) -->
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Pridať súbory…" Command="{Binding AddSourcesCommand}" />
                                    <MenuItem Header="Pripojiť súbory…" Command="{Binding AppendFilesCommand}"
                                              ToolTip="Pripojí súbory na koniec vybraného súboru – pokračujú jeho stopami (napr. 2. časť filmu)" />
                                    <MenuItem Header="Pridať súbory ako ďalšie časti…" Command="{Binding AddPartsCommand}"
                                              ToolTip="Súbory sa prečítajú ako jeden s vybraným súborom (napr. VTS_01_1.VOB, VTS_01_2.VOB)" />
                                    <Separator />
                                    <MenuItem Header="Odstrániť súbor" Command="{Binding RemoveSourceCommand}" />
                                    <MenuItem Header="Odstrániť všetky súbory" Command="{Binding RemoveAllSourcesCommand}" />
                                    <Separator />
                                    <MenuItem Header="Nastaviť názov výstupného súboru podľa vybraného súboru" Command="{Binding OutputFromSourceCommand}" />
                                    <Separator />
                                    <MenuItem Header="Informácie o súbore" Command="{Binding SourceInfoCommand}" />
                                    <Separator />
                                    <MenuItem Header="Vybrať všetky stopy zo súboru" Command="{Binding TakeAllTracksOfSourceCommand}"
                                              ToolTip="Zaškrtne všetky stopy vybraného súboru" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Názov súboru" Width="2*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- parts and appended files indented under their file, each file in its own colour -->
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                <Setter Property="Margin" Value="18,0,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kontajner" Binding="{Binding Container}" Width="100" MinWidth="70" />
                                <DataGridTextColumn Header="Veľkosť" Binding="{Binding Size}" Width="72" MinWidth="64" />
                                <DataGridTextColumn Header="Priečinok" Binding="{Binding Directory}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Directory}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Ťahaním zmeníte výšku zoznamov" />
                        <DockPanel Grid.Row="3" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{loc:T 'Pravidlá UNIVERSUM'}" Command="{Binding ApplyRulesCommand}" Padding="10,3" Margin="0,0,6,0"
                                        ToolTip="Vyplní názvy, jazyky, príznaky a poradie vybraných stôp podľa pravidiel UNIVERSUM" ToolTipService.ShowOnDisabled="True" />
                                <Button Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Command="{Binding MoveUpCommand}" Padding="9,5" Margin="0,0,4,0" ToolTip="Posunúť vyššie (Ctrl+↑)" />
                                <Button Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Command="{Binding MoveDownCommand}" Padding="9,5" ToolTip="Posunúť nižšie (Ctrl+↓)" />
                            </StackPanel>
                            <TextBlock Text="Stopy vo výstupe" FontWeight="SemiBold" VerticalAlignment="Center"
                                       ToolTip="V poradí, v akom budú vo výstupnom súbore; nezaškrtnuté stopy sa nevezmú" />
                        </DockPanel>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding TrackRows}" SelectedItem="{Binding SelectedTrackItem}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Up" Modifiers="Control" Command="{Binding MoveUpCommand}" />
                                <KeyBinding Key="Down" Modifiers="Control" Command="{Binding MoveDownCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="{Binding Kind, Converter={StaticResource TrackTypeBrush}}" />
                                    <Style.Triggers>
                                        <!-- the tracks of an appended file: under the track they continue, not editable -->
                                        <DataTrigger Binding="{Binding IsMain}" Value="False">
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="ToolTip" Value="{Binding Explanation}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Vziať" Width="84" MinWidth="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Margin="0,0,2,0"
                                                          IsEnabled="{Binding IsMain}" ToolTip="Vziať túto stopu do výstupu" />
                                                <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="{Binding Source}"
                                                        Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                                <TextBlock Text="{Binding Position}" VerticalAlignment="Center" ToolTip="Poradie vo výstupe" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Typ" Width="78" MinWidth="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                                <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="86" MinWidth="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Codec}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Jazyk" Binding="{Binding Language.Display}" Width="110" MinWidth="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="*" MinWidth="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Name}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" Width="66" MinWidth="66" />
                                <DataGridCheckBoxColumn Header="Forced" Binding="{Binding IsForced, Mode=OneWay}" Width="64" MinWidth="64" />
                                <DataGridTextColumn Header="Ďalšie" Binding="{Binding FlagMarks}" Width="0.6*" MinWidth="56">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding FlagMarks}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- what the rules would still change, on one line (all in the tooltip) -->
                        <DockPanel Grid.Row="5" Margin="0,4,0,0" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FindingsText}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ItemsControl ItemsSource="{Binding Findings}" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DockPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext" ToolTip="Ťahaním zmeníte šírku panelov" />
                    <!-- Properties: of the selected track or source file; below them the output's title, chapters and attachments -->
                    <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Vlastnosti" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Hint}" Visibility="{Binding ShowsNothing, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap"
                                           Text="Vyberte stopu alebo zdrojový súbor – jeho vlastnosti sa zobrazia tu." />
                                <StackPanel DataContext="{Binding SelectedTrack}" Visibility="{Binding DataContext.ShowsTrack, ElementName=SettingsRoot, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel Margin="0,0,0,6">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}">
                                            <Run Text="{Binding Codec, Mode=OneWay}" /> <Run Text="{Binding Properties, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <CheckBox Content="Vziať túto stopu do výstupu" IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                    <TextBlock Text="Názov stopy" Margin="0,2,0,2" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Jazyk" Margin="0,8,0,2" />
                                    <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Display" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Príznaky" Margin="0,10,0,2" FontWeight="SemiBold" />
                                    <CheckBox Content="Predvolená stopa (Default)" IsChecked="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Zapnutá (Enabled)" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Vynútené zobrazenie (Forced)" IsChecked="{Binding IsForced, UpdateSourceTrigger=PropertyChanged}" />
                                    <Expander Header="Ďalšie príznaky a rozšírené vlastnosti" Margin="0,8,0,0"
                                              IsExpanded="{Binding DataContext.ShowAdvanced, ElementName=SettingsRoot}">
                                        <StackPanel Margin="0,6,0,0">
                                            <CheckBox Content="Pre nepočujúcich (SDH)" IsChecked="{Binding IsHearingImpaired, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Pre nevidiacich (audio popis)" IsChecked="{Binding IsVisualImpaired, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Popis deja textom" IsChecked="{Binding IsTextDescriptions, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Pôvodný jazyk diela" IsChecked="{Binding IsOriginal, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Komentár" IsChecked="{Binding IsCommentary, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Oneskorenie (ms, záporné = skôr)" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Predvolené trvanie / FPS (napr. 25p, 24000/1001p)" Margin="0,8,0,2" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding DefaultDuration, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Kompresia" Margin="0,8,0,2" />
                                            <ComboBox ItemsSource="{Binding CompressionChoices}" SelectedItem="{Binding Compression}" DisplayMemberPath="Text" HorizontalAlignment="Stretch" />
                                            <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                <CheckBox Content="Opraviť časové údaje bitstreamu" IsChecked="{Binding FixBitstreamTiming, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                                <TextBlock Text="Pomer strán obrazu (napr. 16/9)" Margin="0,8,0,2" />
                                                <TextBox Text="{Binding AspectRatio, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Orez v pixeloch (vľavo,hore,vpravo,dole)" Margin="0,8,0,2" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding Cropping, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsTextSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Kódovanie znakov titulkov" Margin="0,8,0,2" />
                                                <ComboBox IsEditable="True" Text="{Binding SubtitleCharset, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"
                                                          ToolTip="Prázdne = podľa súboru; pre staré české a slovenské titulky zvyčajne cp1250">
                                                    <ComboBoxItem Content="cp1250" />
                                                    <ComboBoxItem Content="iso-8859-2" />
                                                    <ComboBoxItem Content="utf-8" />
                                                    <ComboBoxItem Content="cp1252" />
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap">
                                        <Run Text="Zo súboru" /> <Run Text="{Binding Source, Mode=OneWay}" /><Run Text=", ID stopy" /> <Run Text="{Binding Track.Id, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- a track of an appended file: what it continues; the main track is the one edited -->
                                <StackPanel DataContext="{Binding SelectedAppendedTrack}" Visibility="{Binding DataContext.ShowsAppendedTrack, ElementName=SettingsRoot, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel Margin="0,0,0,6">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Codec, Mode=OneWay}" /> <Run Text="{Binding Properties, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                        <TextBlock Text="Pripojená časť" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                    <Button Content="{loc:T 'Upraviť hlavnú stopu'}" Command="{Binding DataContext.SelectMainTrackCommand, ElementName=SettingsRoot}" HorizontalAlignment="Left" Padding="10,3" />
                                </StackPanel>
                                <StackPanel DataContext="{Binding SelectedSource}" Visibility="{Binding DataContext.ShowsSource, ElementName=SettingsRoot, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding Role, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Container, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Input.Details}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="Zo súboru vziať aj" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <CheckBox Content="Kapitoly" IsChecked="{Binding Input.KeepChapters, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Input.HasChapters}" />
                                    <CheckBox Content="Prílohy (písma, obrázky)" IsChecked="{Binding Input.KeepAttachments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Input.HasAttachments}" />
                                    <CheckBox Content="Tagy" IsChecked="{Binding Input.KeepTags, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Input.HasTags}" />
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Pripojený súbor pokračuje stopami súboru, ku ktorému patrí (názvy, jazyky a príznaky má od neho); ďalšie časti sa čítajú ako jeden súbor. Pravým tlačidlom na súbore otvoríte ďalšie možnosti." />
                                </StackPanel>
                                <Separator Margin="0,12,0,4" />
                                <Expander Header="Výstup: názov, kapitoly, prílohy">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Názov (title) výstupného súboru" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Kapitoly zo súboru (XML, OGM .txt, cue)" Margin="0,8,0,2" TextWrapping="Wrap" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClearChaptersCommand}" Padding="8,3" Margin="4,0,0,0" ToolTip="Bez súboru s kapitolami" />
                                            <Button DockPanel.Dock="Right" Content="Vybrať…" Command="{Binding ChooseChaptersCommand}" Padding="8,3" Margin="4,0,0,0" />
                                            <TextBox Text="{Binding ChaptersFile, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Pridajú sa ku kapitolám zo zdrojov, pri ktorých sú zaškrtnuté" />
                                        </DockPanel>
                                        <TextBlock Text="Nové prílohy (písma, obrázky)" Margin="0,8,0,2" />
                                        <ListBox ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}" MaxHeight="80" MinHeight="28" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="{loc:T 'Pridať…'}" Command="{Binding AddAttachmentCommand}" Padding="10,3" Margin="0,0,6,0" />
                                            <Button Content="{loc:T 'Odstrániť'}" Command="{Binding RemoveAttachmentCommand}" Padding="10,3" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <!-- the output: title (TMDB), name by the rules, beside the source or in the library -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <WrapPanel DataContext="{Binding Library}">
                        <RadioButton Content="film" IsChecked="{Binding IsMovie}" GroupName="muxKind" VerticalAlignment="Center" Margin="0,0,10,4" MinWidth="0" />
                        <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="muxKind" VerticalAlignment="Center" Margin="0,0,16,4" MinWidth="0" />
                        <TextBlock Text="Titul:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,4" />
                        <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,6,4"
                                 ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj adresa TMDB (/movie/ = film, /tv/ = seriál)" />
                        <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,4" />
                        <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,12,4"
                                  IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:T 'Potvrdiť titul'}" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <TextBlock Text="Doplnok:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" Width="130" VerticalAlignment="Center"
                                      ToolTip="Doplnok k názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}" Margin="0,0,12,4">
                            <TextBlock Text="Epizóda:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="napr. S01E04 (špeciály S00E01)" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" TextWrapping="NoWrap" Margin="0,0,0,4">
                            <Run Text="{Binding Tmdb.Message, Mode=OneWay}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" />
                        </TextBlock>
                    </WrapPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Výstupný súbor:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{loc:T 'Vybrať…'}" Command="{Binding ChooseOutputCommand}" Padding="10,3" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Vybrať priečinok a meno výstupného súboru" />
                            <CheckBox Content="Do knižnice" IsChecked="{Binding UseLibrary}" IsEnabled="{Binding CanUseLibrary}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="0"
                                      ToolTip="Výsledok pôjde do knižnice (MOVIES / TVSHOWS) s názvom podľa pravidiel; cesta sa potom nedá upravovať." ToolTipService.ShowOnDisabled="True" />
                            <Button Content="{loc:T 'Knižnica…'}" Command="{Binding Library.ChooseOutputDirectoryCommand}" Padding="10,3" Margin="4,0,0,0" ToolTip="{Binding Library.OutputDescription}" />
                            <Button Content="{loc:T 'Resetovať'}" Command="{Binding ResetOutputCommand}" Padding="10,3" Margin="6,0,0,0"
                                    ToolTip="Späť na predvolený výstup: vedľa prvého zdroja, s názvom podľa pravidiel, ak je zadaný titul" />
                        </StackPanel>
                        <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OutputEditable}" ToolTip="{Binding OutputPath}" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ProgressBar Width="140" Height="6" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding OutputNote}" Style="{StaticResource Hint}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Problems}" />
                            <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Result}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:ChaptersPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Kapitoly'}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    </StackPanel>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button Content="{loc:T 'Pridať'}" Command="{Binding AddCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="Nová kapitola za vybranou (o minútu neskôr)" />
                    <Button Content="{loc:T 'Odstrániť'}" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="{loc:T 'Zoradiť podľa času'}" Command="{Binding SortCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <TextBlock Text="Každých" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,6,0" />
                    <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="{loc:T 'Vygenerovať'}" Command="{Binding GenerateCommand}" Padding="12,4" Margin="0,0,16,0" ToolTip="Nahradí zoznam kapitolami po celej dĺžke súboru" />
                    <TextBlock Text="Posun" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Shift, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,6,0" />
                    <TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="{loc:T 'Posunúť všetky'}" Command="{Binding ShiftCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <Button Content="{loc:T 'Načítať zo súboru…'}" Command="{Binding ImportCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="Kapitoly XML alebo OGM (.txt)" />
                    <Button Content="{loc:T 'Odstrániť všetky'}" Command="{Binding RemoveAllCommand}" Padding="12,4" />
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                        <DataGridTemplateColumn Header="Začiatok (HH:MM:SS.mmm)" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox x:Name="start" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                            <Setter TargetName="start" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Názov" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Jazyk" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Display" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                            <WrapPanel DataContext="{Binding Library}">
                                <RadioButton Content="film" IsChecked="{Binding IsMovie}" GroupName="chaptersKind" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0" />
                                <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="chaptersKind" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="0" />
                                <TextBlock Text="Titul:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,6,0"
                                         ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
                                <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,16,0"
                                          IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="{loc:T 'Potvrdiť titul'}" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                        Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="Doplnok:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" Width="130" VerticalAlignment="Center"
                                              ToolTip="Doplnok k názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}" Margin="0,0,16,0">
                                    <TextBlock Text="Epizóda:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="napr. S01E04" />
                                </StackPanel>
                                <Button Content="{loc:T 'Knižnica…'}" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" ToolTip="{Binding OutputDescription}" />
                            </WrapPanel>
                            <TextBlock TextTrimming="CharacterEllipsis" DataContext="{Binding Library}" ToolTip="{Binding Description}" Margin="0,4,0,8">
                                <Run Text="Výsledok (nový súbor v knižnici, originál ostane):" FontWeight="SemiBold" /> <Run Text="{Binding Description, Mode=OneWay}" />
                                <Run Text="{Binding Tmdb.Message, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{loc:T 'Obnoviť zo súboru'}" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="12,6" />
                            <Button Content="{loc:T 'Vrátiť späť'}" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                            <Button Content="{loc:T 'Uložiť'}" Command="{Binding SaveCommand}" Padding="16,6" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Uloží sa kópia s novými kapitolami do knižnice; originál ostane nezmenený." Style="{StaticResource Hint}" />
                            <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SubtitlesPageViewModel}">
            <!-- owner, 30. 10. 2026: Úprava titulkostopy – the film plays with the subtitles being edited, other subtitles to compare -->
            <Grid Margin="24,16,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{loc:T 'Vyčistiť'}" Command="{Binding ClearCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="Zabudne otvorené video a titulky – na disku sa nič nezmení" />
                        <Button Content="{loc:T 'Otvoriť video…'}" Command="{Binding OpenVideoCommand}" Padding="16,6" Margin="0,0,8,0" />
                        <Button Content="{loc:T 'Otvoriť titulky…'}" Command="{Binding OpenSubtitlesCommand}" Padding="16,6"
                                ToolTip="Súbory titulkov (SRT, ASS/SSA, WebVTT, TTML, SAMI, SubViewer, MicroDVD, MPL2, TMPlayer) – uložia sa ako nové SRT" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Úprava titulkostopy'}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="430" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*" MinHeight="200" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="150" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <WrapPanel>
                                    <CheckBox Content="Porovnať s:" IsChecked="{Binding Compare}" VerticalAlignment="Center" Margin="0,0,6,0"
                                              ToolTip="Iné titulky hore na obraze (žlté), so svojimi zmenami" />
                                    <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding CompareRow}" Width="190" Margin="0,0,16,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Language.Display, Mode=OneWay}" /> – <Run Text="{Binding Source, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" DataContext="{Binding SelectedRow}" Margin="0,0,12,0">
                                        <TextBlock Text="Posun:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                                        <Button Content="−1000" Command="{Binding DelayStepCommand}" CommandParameter="-1000" Padding="6,2" Margin="0,0,3,0" />
                                        <Button Content="−100" Command="{Binding DelayStepCommand}" CommandParameter="-100" Padding="6,2" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" Width="70" TextAlignment="Right" />
                                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="3,0,4,0" />
                                        <Button Content="+100" Command="{Binding DelayStepCommand}" CommandParameter="100" Padding="6,2" Margin="0,0,3,0" />
                                        <Button Content="+1000" Command="{Binding DelayStepCommand}" CommandParameter="1000" Padding="6,2" />
                                    </StackPanel>
                                    <Button Content="{loc:T 'Titulok začína teraz'}" Command="{Binding StartsNowCommand}" Padding="10,2" Margin="0,0,6,0"
                                            ToolTip="Najbližší titulok vybraných titulkov sa posunie tak, aby začínal práve teraz (posun sa zmení o rozdiel)" />
                                    <Button Content="{loc:T '1. bod'}" Command="{Binding MarkFirstCommand}" Padding="8,2" Margin="0,0,4,0"
                                            ToolTip="Synchronizácia podľa dvoch titulkov: najbližší titulok patrí sem (na začiatku filmu)" />
                                    <Button Content="{loc:T '2. bod'}" Command="{Binding MarkSecondCommand}" Padding="8,2"
                                            ToolTip="…a druhý titulok ku koncu filmu – vypočíta rýchlosť a posun" />
                                </WrapPanel>
                                <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <player:PlayerView DataContext="{Binding Player}" />
                        </DockPanel>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2,0,2" />
                        <TabControl Grid.Row="2">
                            <TabItem Header="Stopy titulkov">
                                <Grid Margin="0,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Visibility="{Binding HasFound, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Externé titulky pri videu (podľa názvu, slov názvu a čísla epizódy):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Found}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,2">
                                                            <Button DockPanel.Dock="Left" Content="Pridať" Command="{Binding AddCommand}" Padding="10,2" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Ponechať">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Zdroj" Binding="{Binding Source, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                                            <DataGridTextColumn Header="Jazyk" Binding="{Binding Language.Display, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                            <DataGridTextColumn Header="Formát" Binding="{Binding Format, Mode=OneWay}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Titulkov" Binding="{Binding Count, Mode=OneWay}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Zmeny" Binding="{Binding Summary, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="2" Margin="0,8,0,4">
                                        <WrapPanel>
                                            <Button Content="{loc:T 'Pridať externé titulky…'}" Command="{Binding AddExternalCommand}" Padding="12,4" Margin="0,0,8,0"
                                                    ToolTip="Súbory titulkov, ktoré patria k videu – pridajú sa ako nové stopy (textové ako SRT v UTF-8)" />
                                            <Button Content="{loc:T 'Odstrániť zo zoznamu'}" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,16,0" ToolTip="Pridaný externý súbor sa nepridá" />
                                            <Button Content="{loc:T 'Skontrolovať titulky videa'}" Command="{Binding CheckTracksCommand}" Padding="12,4"
                                                    ToolTip="Porovná každú titulkovú stopu videa so zvukom: sedí, mešká, ide skôr, iné FPS" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="Napasovať vybrané automaticky:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <CheckBox Content="podľa zvuku" IsChecked="{Binding SyncByAudio}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      ToolTip="Kde sa vo filme hovorí – osem častí filmu, aj iné FPS (25 ↔ 23,976 …)" />
                                            <CheckBox Content="podľa titulkov:" IsChecked="{Binding SyncBySubtitles}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="Iné titulky, ktoré k filmu sedia (aj v inom jazyku)" />
                                            <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SyncReference}" Width="200" Margin="0,0,8,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding Language.Display, Mode=OneWay}" /> – <Run Text="{Binding Source, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="{loc:T 'Napasovať'}" Command="{Binding SyncCommand}" Padding="12,4" Margin="0,0,8,0"
                                                    ToolTip="Nastaví rýchlosť (alebo zmenu FPS) a posun vybraných titulkov, keď je výsledok istý; oboje naraz = istota, keď sa zhodnú" />
                                            <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopSyncCommand}" Padding="12,4" Margin="0,0,8,0"
                                                    ToolTip="Zastaví čítanie zvuku filmu" />
                                            <Button Content="{loc:T 'Použiť návrh'}" Command="{Binding ApplyProposalCommand}" Padding="12,4"
                                                    Visibility="{Binding HasProposal, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Neistý výsledok sa sám nepoužije – nastaví ho až toto tlačidlo; overte ho prehraním" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Časy titulkov">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Dvojklik: prehrávač ide na titulok. Text titulku opravíte klávesom F2 alebo kliknutím do vybraného titulku (riadky oddeľuje „ | “ s medzerami, prázdny text titulok vynechá); pravé tlačidlo: odstrániť titulok, vrátiť úpravy. Upravovať sa dá, keď sú vypnuté opravy celého textu (nepočujúci, formátovanie, prekrývanie časov)." />
                                    <DataGrid ItemsSource="{Binding Preview}" SelectedItem="{Binding SelectedPreview}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                              BeginningEdit="OnCueBeginningEdit" CellEditEnding="OnCueCellEditEnding" SelectionChanged="OnCueSelected"
                                              Loaded="OnCueGridLoaded">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <!-- double click: the player goes to the subtitle (also over a cell that could be edited) -->
                                                <EventSetter Event="MouseDoubleClick" Handler="OnCueDoubleClick" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Odstrániť titulok" Command="{Binding RemoveCueCommand}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Vrátiť všetky úpravy textu" Command="{Binding UndoCueEditsCommand}" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Teraz" Binding="{Binding Before}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Po zmene" Binding="{Binding After}" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Stiahnuť a preložiť">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="OpenSubtitles.com:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding OnlineLanguages}" SelectedItem="{Binding OnlineLanguage}" Width="60" Margin="0,0,6,0" ToolTip="Jazyk titulkov" />
                                            <ComboBox ItemsSource="{Binding HearingImpairedFilters}" SelectedItem="{Binding HearingImpairedFilter}" Width="100" Margin="0,0,6,0" ToolTip="Titulky pre nepočujúcich (SDH)" />
                                            <Button Content="{loc:T 'Hľadať'}" Command="{Binding SearchOnlineCommand}" Padding="12,3" Margin="0,0,20,0"
                                                    ToolTip="Podľa titulu (s TMDB ID presne) a epizódy; účet a API kľúč v Nastaveniach" />
                                            <TextBlock Text="titulky.com (CZ/SK):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Content="{loc:T 'Hľadať v prehliadači'}" Command="{Binding SearchTitulkyCommand}" Padding="12,3" Margin="0,0,20,0"
                                                    ToolTip="Pravidlá titulky.com dovoľujú len prehliadač: stiahnite titulky, UNIVERSUM ich sám vezme zo Stiahnutých súborov" />
                                            <TextBlock Text="Preložiť vybrané (svsub.net) do:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding OnlineLanguages}" SelectedItem="{Binding TranslateTo}" Width="60" Margin="0,0,6,0" />
                                            <Button Content="{loc:T 'Preložiť'}" Command="{Binding TranslateCommand}" Padding="12,3"
                                                    ToolTip="Vybrané titulky preloží AI cez váš účet svsub.net (token v Nastaveniach); posielajú sa len titulky pod neutrálnym názvom" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding OnlineStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <ItemsControl ItemsSource="{Binding OnlineResults}" MaxHeight="160" Margin="0,4,0,0">
                                            <ItemsControl.Template>
                                                <ControlTemplate>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,1">
                                                        <Button DockPanel.Dock="Left" Content="Stiahnuť" Padding="8,1" Margin="0,0,8,0"
                                                                Command="{Binding DataContext.DownloadOnlineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Stiahnuté a preložené titulky sa uložia vedľa videa ako „Názov videa.jazyk.srt“ (nikdy cez existujúci súbor) – Single aj Hromadné spracovanie ich potom nájdu samo." />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Text z obrázkov (OCR)">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                                   Text="Obrázkové titulky (PGS z Blu-ray) vybranej stopy UNIVERSUM prečíta vlastným rozpoznávaním textu: písmená porovná s písmami Windows, pochybné slová opraví podľa jazyka a tvary, ktoré nepozná, sa opýta – raz za film, zapamätá si ich aj pre ďalšie filmy. Text sa uloží vedľa videa ako „Názov videa.jazyk.srt“ (nikdy cez existujúci súbor, originál ostane) a pridá sa ako nová titulková stopa; časy sú pôvodné časy obrázkov. VobSub (DVD) zatiaľ nie." />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="{loc:T 'Rozpoznať text'}" Command="{Binding ReadTextCommand}" Padding="12,3" Margin="0,0,8,0"
                                                    ToolTip="Vyberte v zozname stopu s obrázkovými titulkami (PGS) – stopu videa alebo súbor .sup" />
                                            <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopReadingTextCommand}" Padding="12,3" Margin="0,0,16,0" />
                                            <CheckBox Content="Opraviť text podľa jazyka" IsChecked="{Binding OcrCheckText}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                      ToolTip="Slová, ktorými si čítanie nebolo isté, opraví podľa slovníka z vašich titulkov a slov, ktoré vo filme prečítalo isto; každú opravu môžete vrátiť" />
                                            <Button Content="{loc:T 'Naučiť slovník z titulkov…'}" Command="{Binding LearnLexiconCommand}" Padding="12,3"
                                                    ToolTip="Vyberte priečinok s vašimi textovými titulkami (SRT, ASS, VTT, SUB), napr. knižnicu – UNIVERSUM si z nich zapamätá slová každého jazyka (len v tomto počítači, každý súbor raz)" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LexiconSummary}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding OcrStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <StackPanel Visibility="{Binding HasOcrCorrections, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                            <TextBlock Text="Opravené podľa jazyka (Vrátiť dá späť slovo, ako sa prečítalo – v novej stope, ako zmena v Časoch titulkov):" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding OcrCorrections}" MaxHeight="180" Margin="0,4,0,0">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,1">
                                                            <Button DockPanel.Dock="Left" Content="Vrátiť" Padding="8,1" Margin="0,0,8,0" Command="{Binding RevertCommand}" CommandParameter="{Binding}" />
                                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" BorderBrush="#C8C8C8" BorderThickness="1"
                                                CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding OcrQuestion.Title}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Background="#282828" Padding="6" VerticalAlignment="Top">
                                                        <Image Source="{Binding OcrQuestion.Shape}" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Čo je to? Písmeno – alebo viac písmen, keď sa dotýkajú (napr. „rn“):" TextWrapping="Wrap" MaxWidth="380" />
                                                        <TextBox x:Name="OcrAnswerBox" Text="{Binding OcrAnswer, UpdateSourceTrigger=PropertyChanged}" Width="120" FontSize="20"
                                                                 HorizontalAlignment="Left" Margin="0,4,0,0" IsVisibleChanged="OnOcrAnswerVisible">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Command="{Binding TeachCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="Kde vo filme stojí (zvýraznený):" Style="{StaticResource Hint}" Margin="0,8,0,2" />
                                                <Border Background="#282828" Padding="4" HorizontalAlignment="Left">
                                                    <Image Source="{Binding OcrQuestion.Line}" MaxHeight="72" MaxWidth="900" Stretch="Uniform" />
                                                </Border>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="{loc:T 'Ďalej'}" Command="{Binding TeachCommand}" Padding="12,3" Margin="0,0,8,0"
                                                            ToolTip="Tvar je napísaný text (Enter); UNIVERSUM si ho zapamätá" />
                                                    <Button Content="{loc:T 'Nie je to písmeno'}" Command="{Binding SpeckCommand}" Padding="12,3" Margin="0,0,8,0"
                                                            ToolTip="Škvrna alebo zvyšok obrysu – v texte sa vynechá" />
                                                    <Button Content="{loc:T 'Neviem'}" Command="{Binding SkipShapeCommand}" Padding="12,3" Margin="0,0,8,0"
                                                            ToolTip="V texte bude „�“ – opravíte ho v Časoch titulkov" />
                                                    <Button Content="{loc:T 'Uložiť teraz'}" Command="{Binding FinishReadingCommand}" Padding="12,3"
                                                            ToolTip="Ďalšie neznáme tvary sa už nepýta – v texte budú ako „�“" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedRow}"
                                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <WrapPanel>
                                <TextBlock Text="Jazyk:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}" DisplayMemberPath="Display" Width="170" Margin="0,0,12,0" />
                                <TextBlock Text="Názov stopy:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="170"
                                         ToolTip="Názov stopy vo výsledku – kým ho neprepíšete, dáva ho pravidlo (forced = „Forced“, inak bez názvu); môžete doň dopísať, prázdny = bez názvu" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="Forced" IsChecked="{Binding Forced}" Margin="0,0,16,0" />
                                <CheckBox Content="Pre nepočujúcich (SDH)" IsChecked="{Binding HearingImpaired}" />
                            </WrapPanel>

                            <TextBlock Text="Zmena FPS titulkov" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pôvodné FPS (titulky boli pre)" Style="{StaticResource Hint}" />
                                    <ListBox ItemsSource="{Binding Rates}" SelectedItem="{Binding FpsFrom}" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nové FPS (video)" Style="{StaticResource Hint}" />
                                    <ListBox ItemsSource="{Binding Rates}" SelectedItem="{Binding FpsTo}" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Zmena rýchlosti titulkov (percentá)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                            <Slider Minimum="-99" Maximum="100" Value="{Binding SpeedPercent}" TickFrequency="10" TickPlacement="BottomRight" SmallChange="0.1" LargeChange="1"
                                    ToolTip="+ = titulky rýchlejšie (časy kratšie), − = pomalšie (časy dlhšie)" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="−1 %" Command="{Binding SpeedStepCommand}" CommandParameter="-1" Padding="8,2" Margin="0,0,4,0" />
                                <Button Content="−0,1 %" Command="{Binding SpeedStepCommand}" CommandParameter="-0.1" Padding="8,2" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}" Width="80" TextAlignment="Right" />
                                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,8,0" />
                                <Button Content="+0,1 %" Command="{Binding SpeedStepCommand}" CommandParameter="0.1" Padding="8,2" Margin="0,0,4,0" />
                                <Button Content="+1 %" Command="{Binding SpeedStepCommand}" CommandParameter="1" Padding="8,2" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Od −99 % do +100 %: +100 % = titulky dvakrát rýchlejšie, −50 % = dvakrát pomalšie; aj desatinné čísla (napr. 4,271)." />

                            <TextBlock Text="Posun (Delay v ms)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−1000" Command="{Binding DelayStepCommand}" CommandParameter="-1000" Padding="8,2" Margin="0,0,4,0" />
                                <Button Content="−100" Command="{Binding DelayStepCommand}" CommandParameter="-100" Padding="8,2" Margin="0,0,8,0" />
                                <TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" Width="90" TextAlignment="Right" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,8,0" />
                                <Button Content="+100" Command="{Binding DelayStepCommand}" CommandParameter="100" Padding="8,2" Margin="0,0,4,0" />
                                <Button Content="+1000" Command="{Binding DelayStepCommand}" CommandParameter="1000" Padding="8,2" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="1000 = 1 sekunda; kladné = titulky neskôr, záporné = skôr." />

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimingExample}" TextWrapping="Wrap" />
                                    <Button Content="{loc:T 'Vynulovať časy'}" Command="{Binding ResetTimingCommand}" HorizontalAlignment="Left" Padding="10,2" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Synchronizácia podľa dvoch titulkov" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Kedy je titulok teraz a kedy má byť (z prehrávača) – pre jeden na začiatku a jeden na konci; vypočíta rýchlosť a posun." />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="1. titulok je v" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox Grid.Column="1" Text="{Binding FirstNow, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" />
                                <TextBlock Grid.Column="2" Text="má byť v" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox Grid.Column="3" Text="{Binding FirstTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Text="2. titulok je v" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SecondNow, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="má byť v" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SecondTarget, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{loc:T 'Vypočítať'}" Command="{Binding TwoPointsCommand}" Padding="10,2" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SyncNote}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Text titulkov" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                                <CheckBox Content="Konvertovať do SRT (UTF-8)" IsChecked="{Binding ToSrt}" Visibility="{Binding CanConvert, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4" />
                                <CheckBox Content="Odstrániť prvky pre nepočujúcich ([hudba], (smiech), MENO:)" IsChecked="{Binding RemoveHearingImpaired}" Margin="0,0,0,4" />
                                <CheckBox Content="Odstrániť formátovanie (kurzíva, tučné)" IsChecked="{Binding RemoveFormatting}" Margin="0,0,0,4" />
                                <CheckBox Content="Opraviť prekrývanie a príliš krátke časy" IsChecked="{Binding FixTimes}" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Externé textové titulky sa vždy uložia ako SRT v UTF-8. Pri stope videa sa pri zmene textu prečíta celá stopa (číta sa celý súbor)." />
                            </StackPanel>
                            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- Upraviť v štúdiu: a file of Hromadné spracovanie – the changes go back into the task -->
                        <DockPanel Visibility="{Binding IsTask, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="{loc:T 'Späť bez uloženia'}" Command="{Binding LeaveTaskCommand}" Padding="12,6" Margin="0,0,8,0" />
                                <Button Content="{loc:T 'Uložiť do úlohy'}" Command="{Binding SaveToTaskCommand}" Padding="16,6" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding TaskText}" TextWrapping="Wrap" Margin="0,0,16,0" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsTask, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <WrapPanel DataContext="{Binding Library}">
                                    <RadioButton Content="film" IsChecked="{Binding IsMovie}" GroupName="subtitlesKind" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0" />
                                    <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="subtitlesKind" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="0" />
                                    <TextBlock Text="Titul:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,6,0"
                                             ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
                                    <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,16,0"
                                              IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{loc:T 'Potvrdiť titul'}" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                            Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <TextBlock Text="Doplnok:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" Width="130" VerticalAlignment="Center"
                                                  ToolTip="Doplnok k názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}" Margin="0,0,16,0">
                                        <TextBlock Text="Epizóda:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="napr. S01E04" />
                                    </StackPanel>
                                    <Button Content="{loc:T 'Knižnica…'}" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" ToolTip="{Binding OutputDescription}" />
                                </WrapPanel>
                                <TextBlock TextTrimming="CharacterEllipsis" DataContext="{Binding Library}" ToolTip="{Binding Description}" Margin="0,4,0,4">
                                    <Run Text="Výsledok (nový súbor v knižnici, originál ostane):" FontWeight="SemiBold" /> <Run Text="{Binding Description, Mode=OneWay}" />
                                    <Run Text="{Binding Tmdb.Message, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <CheckBox Content="Použiť pravidlá UNIVERSUM (poradie stôp, príznaky, Forced, odstránenie prázdnych)" IsChecked="{Binding UseRules}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Blocked}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            </StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Uložiť" Command="{Binding SaveCommand}" Padding="16,6" VerticalAlignment="Top" />
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}" Width="90" Margin="0,0,8,0" VerticalAlignment="Top"
                                          Visibility="{Binding IsFiles, Converter={StaticResource BoolToVisibility}}" ToolTip="Formát nových súborov titulkov" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="Video: nový súbor v knižnici (mkvmerge, časy cez --sync). Súbory titulkov: nové SRT alebo WebVTT vedľa pôvodných. Originály ostanú nezmenené." TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                        <Button Content="{loc:T 'Uložiť prácu'}" Command="{Binding SaveWorkCommand}" Padding="10,2" Margin="0,0,6,0"
                                                ToolTip="Hodnoty všetkých titulkov tohto videa sa zapamätajú – pri ďalšom otvorení videa sa obnovia (nič sa nezapíše do súborov)" />
                                        <Button Content="{loc:T 'Zahodiť prácu'}" Command="{Binding DiscardWorkCommand}" Padding="10,2" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding WorkNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:AudioPageViewModel}">
            <!-- owner, 30. 10. 2026: Úprava audiostopy – the sounds play with the film; a dub fitted, PAL 25 ↔ 23,976, codec, loudness -->
            <Grid Margin="24,16,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{loc:T 'Vyčistiť'}" Command="{Binding ClearCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="Zabudne otvorené video a zvuky – na disku sa nič nezmení" />
                        <Button Content="{loc:T 'Otvoriť video…'}" Command="{Binding OpenVideoCommand}" Padding="16,6" Margin="0,0,8,0" />
                        <Button Content="{loc:T 'Pridať zvuk…'}" Command="{Binding AddSoundCommand}" Padding="16,6"
                                ToolTip="Zvukové súbory (MKA, AC-3, E-AC-3, DTS, AAC, MP3, FLAC, Opus, WAV) alebo iný film, z ktorého sa zoberie zvuk (napr. CZ dabing z iného vydania)" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Úprava audiostopy'}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*" MinHeight="200" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="150" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" DataContext="{Binding SelectedRow}"
                                       Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}"
                                       IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Grid}}">
                                <TextBlock Text="Hrá:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Source}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="Posun:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                                <Button Content="−1000" Command="{Binding DelayStepCommand}" CommandParameter="-1000" Padding="6,2" Margin="0,0,3,0" />
                                <Button Content="−100" Command="{Binding DelayStepCommand}" CommandParameter="-100" Padding="6,2" Margin="0,0,3,0" />
                                <Button Content="−10" Command="{Binding DelayStepCommand}" CommandParameter="-10" Padding="6,2" Margin="0,0,4,0" />
                                <TextBox Text="{Binding DelayText, UpdateSourceTrigger=LostFocus}" Width="70" TextAlignment="Right" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="3,0,4,0" />
                                <Button Content="+10" Command="{Binding DelayStepCommand}" CommandParameter="10" Padding="6,2" Margin="0,0,3,0" />
                                <Button Content="+100" Command="{Binding DelayStepCommand}" CommandParameter="100" Padding="6,2" Margin="0,0,3,0" />
                                <Button Content="+1000" Command="{Binding DelayStepCommand}" CommandParameter="1000" Padding="6,2" />
                            </WrapPanel>
                            <player:PlayerView DataContext="{Binding Player}" />
                        </DockPanel>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2,0,2" />
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Ponechať">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                          IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Zdroj" Binding="{Binding Source, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                                    <DataGridTextColumn Header="Jazyk" Binding="{Binding Language.Display, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Názov stopy" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Formát" Binding="{Binding Format, Mode=OneWay}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Zmeny" Binding="{Binding Summary, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Margin="0,8,0,4">
                                <WrapPanel>
                                    <Button Content="{loc:T 'Odstrániť zo zoznamu'}" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,16,0" ToolTip="Pridaný zvuk sa nepridá" />
                                    <TextBlock Text="Napasovať vybraný zvuk na:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding References}" SelectedItem="{Binding Reference}" Width="200" Margin="0,0,8,0"
                                              ToolTip="Zvuk filmu, ku ktorému sa vybraný zvuk napasuje (hudba a ruchy sú v oboch, aj pri dabingu)">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Language.Display, Mode=OneWay}" /> – <Run Text="{Binding Source, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="{loc:T 'Napasovať'}" Command="{Binding SyncCommand}" Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="Prečíta oba zvuky celé a porovná ich v mnohých častiach filmu: posun aj zmena FPS (25 ↔ 23,976); istý výsledok sa nastaví sám" />
                                    <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopCommand}" Padding="12,4" Margin="0,0,8,0" />
                                    <Button Content="{loc:T 'Použiť návrh'}" Command="{Binding ApplyProposalCommand}" Padding="12,4"
                                            Visibility="{Binding HasProposal, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Neistý výsledok sa sám nepoužije – nastaví ho až toto tlačidlo; overte ho prehraním" />
                                </WrapPanel>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedRow}"
                                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                        <!-- nothing changes while the sounds are fitted or written -->
                        <StackPanel Margin="0,0,8,0" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Grid}}">
                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Format}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <TextBlock Text="Jazyk:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}"
                                          DisplayMemberPath="Display" Width="170" Margin="0,0,12,0" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Názov stopy:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="250"
                                         ToolTip="Názov stopy vo výsledku – kým ho neprepíšete, dáva ho pravidlo (zvuk bez názvu); môžete doň dopísať, prázdny = bez názvu" />
                            </WrapPanel>

                            <TextBlock Text="Zmena FPS (PAL 25 ↔ 23,976)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Zvuk bol pre (FPS)" Style="{StaticResource Hint}" />
                                    <ListBox ItemsSource="{Binding Rates}" SelectedItem="{Binding FpsFrom}" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Video (FPS)" Style="{StaticResource Hint}" />
                                    <ListBox ItemsSource="{Binding Rates}" SelectedItem="{Binding FpsTo}" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Zachovať výšku tónu" IsChecked="{Binding KeepPitch}" Margin="0,4,0,0"
                                      ToolTip="Zapnuté: hlasy znejú rovnako, len pomalšie/rýchlejšie. Vypnuté: výška tónu sa zmení s rýchlosťou (vráti pôvodnú výšku zvuku zrýchleného pre PAL bez korekcie)" />

                            <TextBlock Text="Posun (Delay v ms)" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−1000" Command="{Binding DelayStepCommand}" CommandParameter="-1000" Padding="8,2" Margin="0,0,4,0" />
                                <Button Content="−100" Command="{Binding DelayStepCommand}" CommandParameter="-100" Padding="8,2" Margin="0,0,8,0" />
                                <TextBox Text="{Binding DelayText, UpdateSourceTrigger=LostFocus}" Width="90" TextAlignment="Right" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,8,0" />
                                <Button Content="+100" Command="{Binding DelayStepCommand}" CommandParameter="100" Padding="8,2" Margin="0,0,4,0" />
                                <Button Content="+1000" Command="{Binding DelayStepCommand}" CommandParameter="1000" Padding="8,2" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="1000 = 1 sekunda; kladné = zvuk neskôr, záporné = skôr. Samotný posun sa zapíše bez straty kvality (mkvmerge)." />

                            <TextBlock Text="Kodek a hlasitosť" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                            <WrapPanel>
                                <TextBlock Text="Kodek:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}" Width="150" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}" Width="120" ToolTip="Dátový tok (automaticky podľa kodeku a kanálov)" />
                            </WrapPanel>
                            <CheckBox Content="Stereo (zmiešať 5.1 do dvoch kanálov)" IsChecked="{Binding Stereo}" Margin="0,6,0,0" />
                            <CheckBox Content="Normalizovať hlasitosť na −23 LUFS (EBU R128)" IsChecked="{Binding Normalize}" Margin="0,4,0,0"
                                      ToolTip="Zvuk sa najprv celý zmeria, potom sa zapíše s rovnakou hlasitosťou ako ostatné filmy" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Zosilniť / stlmiť:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding GainText, UpdateSourceTrigger=PropertyChanged}" Width="60" TextAlignment="Right" />
                                <TextBlock Text="dB" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Zmena FPS, kodek, stereo a hlasitosť zapíšu zvuk znova (FFmpeg) do nového súboru; DTS a TrueHD sa dajú zapísať len do iného kodeku." />
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <Button Content="{loc:T 'Vynulovať zmeny'}" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Padding="10,2" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <!-- Zvuk v štúdiu: a file of Hromadné spracovanie – the changes go back into the task -->
                        <DockPanel Visibility="{Binding IsTask, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="{loc:T 'Späť bez uloženia'}" Command="{Binding LeaveTaskCommand}" Padding="12,6" Margin="0,0,8,0" />
                                <Button Content="{loc:T 'Uložiť do úlohy'}" Command="{Binding SaveToTaskCommand}" Padding="16,6" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding TaskText}" TextWrapping="Wrap" Margin="0,0,16,0" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsTask, Converter={StaticResource InverseBoolToVisibility}}">
                        <WrapPanel DataContext="{Binding Library}">
                            <RadioButton Content="film" IsChecked="{Binding IsMovie}" GroupName="audioKind" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0" />
                            <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="audioKind" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="0" />
                            <TextBlock Text="Titul:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,6,0"
                                     ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
