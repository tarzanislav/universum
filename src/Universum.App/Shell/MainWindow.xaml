                                <DataGridTextColumn Header="Súbor" Binding="{Binding FileName}" Width="*" MinWidth="110" />
                                <DataGridTemplateColumn Header="Film / epizóda" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Text="{Binding Naming, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Film: Názov (rok), napr. Creep (2004). Seriál: číslo epizódy, napr. S01E04." />
                                                <TextBlock Text="{Binding NamingSuggestion}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cieľ v knižnici" Binding="{Binding Target}" Width="1.5*" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Target}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="*" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Aj tak">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ProcessAnyway, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      Visibility="{Binding CanProcessAnyway, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Spracovať aj bez povinnej stopy šablóny" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Bez šablóny" Command="{Binding RulesOnlyCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Zo skupiny" Command="{Binding TemplateFromGroupCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Upraviť…" Command="{Binding EditTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Načítať…" Command="{Binding LoadTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Uložiť…" Command="{Binding SaveTemplateCommand}" Padding="10,3" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="Šablóna:" FontWeight="SemiBold" /> <Run Text="{Binding TemplateDescription, Mode=OneWay}" />
                            </TextBlock>
                            <CheckBox Content="stopy mimo šablóny odstrániť" IsChecked="{Binding RemoveUnlisted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Originál:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
