                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" />
                                                <DataGridTextColumn Header="{loc:T 'Teraz'}" Binding="{Binding Before}" IsReadOnly="True" />
                                                <DataGridTextColumn Header="{loc:T 'Po zmene'}" Binding="{Binding After}" IsReadOnly="True" />
                                                <DataGridTextColumn Header="{loc:T 'Text'}" Binding="{Binding Text}" Width="*" />
