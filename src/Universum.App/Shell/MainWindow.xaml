                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"
                                       Text="Súbory sa dajú poslať aj z Prieskumníka: pravé tlačidlo → UNIVERSUM (vo Windows 11 pod „Zobraziť ďalšie možnosti“)." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
