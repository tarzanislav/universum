<Window x:Class="Universum.App.Updates.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNIVERSUM – aktualizácie" Width="760" Height="640" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Aktualizácie" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Najprv sa aktualizuje MKVToolNix, potom UNIVERSUM – inštalátor UNIVERSUM program na konci znova spustí. Inštalátory sa spustia len po overení kontrolného súčtu a podpisu." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="4" Padding="8,2"
                                    Visibility="{Binding MkvSecurity, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="bezpečnostné opravy" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            </Border>
                            <TextBlock Text="MKVToolNix" FontWeight="SemiBold" FontSize="16" />
                        </DockPanel>
                        <TextBlock Text="{Binding MkvToolNixLine}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBox Text="{Binding MkvNews, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"
                                 MaxHeight="220" VerticalScrollBarVisibility="Auto" ToolTip="Zoznam zmien z NEWS.md (anglicky, ako ho vydáva autor MKVToolNix)" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="UNIVERSUM" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding UniversumLine}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding UniversumInstallHint}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,4,0,0" />
                        <TextBox Text="{Binding UniversumNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Aktualizovať všetko" Command="{Binding UpdateAllCommand}" Margin="0,0,8,6" Padding="16,6" FontWeight="SemiBold" />
            <Button Content="Len MKVToolNix" Command="{Binding UpdateMkvToolNixCommand}" Margin="0,0,8,6" Padding="12,6" />
            <Button Content="Len UNIVERSUM" Command="{Binding UpdateUniversumCommand}" Margin="0,0,8,6" Padding="12,6" />
            <Button Content="Stránka vydania" Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,6" Padding="12,6" />
        </WrapPanel>
        <DockPanel Grid.Row="4" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Zavrieť" IsCancel="True" Click="OnClose" Padding="16,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Pripomenúť neskôr" Command="{Binding RemindLaterCommand}" Margin="0,0,8,0" Padding="12,6" ToolTip="Znova o 3 dni (bezpečnostné opravy MKVToolNix aj skôr)" />
                <Button Content="Preskočiť túto verziu" Command="{Binding SkipCommand}" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Skontrolovať znova" Command="{Binding CheckCommand}" Padding="12,6" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
