                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}" Margin="0,0,16,0">
                                <TextBlock Text="Epizóda:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="napr. S01E04" />
                            </StackPanel>
                            <Button Content="Knižnica…" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" ToolTip="{Binding OutputDescription}" />
                        </WrapPanel>
                        <TextBlock Margin="0,0,0,8" TextTrimming="CharacterEllipsis" DataContext="{Binding Library}" ToolTip="{Binding Description}">
                            <Run Text="Výsledok (nový súbor v knižnici, originál ostane):" FontWeight="SemiBold" /> <Run Text="{Binding Description, Mode=OneWay}" />
                            <Run Text="{Binding Tmdb.Message, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Vrátiť späť" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="Do fronty" Command="{Binding QueueCommand}" Margin="0,0,8,0" Padding="16,6" ToolTip="Pridá zmenu do fronty úloh namiesto okamžitého uloženia" />
                                <Button Content="Uložiť" Command="{Binding SaveCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Method}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type jobs:JobQueuePageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Fronta úloh" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding State}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button Content="Spustiť" Command="{Binding StartCommand}" Padding="14,4" Margin="0,0,8,0" />
                    <Button Content="Zastaviť po aktuálnej" Command="{Binding StopCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <Button Content="Zrušiť" Command="{Binding CancelCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="Zruší bežiacu úlohu (originál ostane nezmenený) alebo vyradí čakajúcu" />
                    <Button Content="Spustiť znova" Command="{Binding RetryCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="Čakajúcu úlohu skôr" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" Margin="0,0,16,0" ToolTip="Čakajúcu úlohu neskôr" />
                    <Button Content="Výstup…" Command="{Binding OutputCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Vrátiť späť" Command="{Binding UndoCommand}" Padding="12,4" Margin="0,0,16,0" ToolTip="Vráti úpravu hlavičky, ktorú urobila táto úloha" />
                    <Button Content="Odstrániť" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Vyčistiť dokončené" Command="{Binding ClearCommand}" Padding="12,4" />
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                        <DataGridTextColumn Header="Úloha" Binding="{Binding Description}" Width="2*" />
                        <DataGridTemplateColumn Header="Stav" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock x:Name="state" Text="{Binding Status}" />
                                        <ProgressBar Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="state" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                            <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Outcome}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Pridaná" Binding="{Binding Added}" />
                        <DataGridTextColumn Header="Trvanie" Binding="{Binding Duration}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <CheckBox Content="Spustiť frontu hneď po pridaní úlohy" IsChecked="{Binding AutoStart}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type jobs:JobOutputPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Job}" DisplayMemberPath="Display" Width="360" VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="Výstup úloh" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,6,0,10">
                    <TextBlock Text="{Binding Job.Description}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Čas" Binding="{Binding Time}" />
                        <DataGridTemplateColumn Header="Druh" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="kind" Text="{Binding Severity}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Správa" Binding="{Binding Text}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:BatchPageViewModel}">
            <Grid Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="aj podpriečinky" IsChecked="{Binding Recursive}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Priečinok…" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" Padding="12,5" />
                        <Button Content="Analyzovať" Command="{Binding AnalyzeCommand}" Padding="16,5" />
                        <Button Content="Vymazať frontu" Command="{Binding ClearCommand}" Padding="12,5" Margin="8,0,0,0"
                                ToolTip="Zabudne analyzované, ešte nespracované súbory – aj poslané z Noviniek (na disku sa nič nezmení)" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Hromadné spracovanie" />
                        <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,6,0,8">
                    <Button DockPanel.Dock="Right" Content="Upratať zvyšky" Command="{Binding CleanupCommand}" Padding="10,3"
                            ToolTip="Dočasné súbory po prerušenom spracovaní presunie do Koša" />
                    <Button DockPanel.Dock="Right" Content="Zastaviť analýzu" Command="{Binding StopCommand}" Padding="10,3" Margin="0,0,8,0"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- why nothing can be processed is said plainly, in the warning colour -->
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                     Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="180" MaxWidth="700" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="400" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <!-- the group by its film or series (owner, 28. 10.); the letter stays in the tooltip and the report -->
                            <DataGridTextColumn Header="Skupina (film / seriál)" Binding="{Binding Title}" Width="*" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Súbory" Binding="{Binding Count}" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Signature}" TextWrapping="Wrap" Margin="8,0,8,6" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <!-- the list of groups can be widened -->
                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                  Background="Transparent" Cursor="SizeWE" ToolTip="Ťahaním zmeníte šírku zoznamu skupín" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Informácie" Command="{Binding ShowInfoCommand}" Padding="10,3"
                                    ToolTip="Zobrazí vybraný súbor na stránke Informácie" ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Text="Súbory skupiny – výsledok simulácie" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding FileRows}" SelectedItem="{Binding SelectedFile}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False" SelectionChanged="OnBatchFilesSelected">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rozpoznať jazyk audiostôp vybraných súborov" Command="{Binding DetectAudioSelectedCommand}" />
                                    <MenuItem Header="Informácie o súbore" Command="{Binding ShowInfoCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Súbor" Binding="{Binding FileName}" Width="*" MinWidth="110" />
                                <DataGridTemplateColumn Header="Film / epizóda" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Text="{Binding Naming, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Film: Názov (rok), napr. Creep (2004). Seriál: číslo epizódy, napr. S01E04." />
                                                <!-- owner, 29. 10. 2026: a film exactly by its TMDB ID -->
                                                <DockPanel Margin="0,2,0,0" Visibility="{Binding IsFilm, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="TMDB ID:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBox Text="{Binding TmdbId, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                                             ToolTip="Presne podľa TMDB: číslo filmu (napr. 12345) alebo adresa z themoviedb.org; minisériál vložte ako adresu …/tv/…. Použije sa, keď pole opustíte." />
                                                </DockPanel>
                                                <TextBlock Text="{Binding NamingSuggestion}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <Button Content="Potvrdiť návrh" Command="{Binding ConfirmCommand}" Padding="8,2" Margin="0,2,0,0" FontSize="12" HorizontalAlignment="Left"
                                                        Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="Návrh nie je istý (názov sa líšil od mena súboru alebo HISTRA titul nepotvrdila) – potvrďte ho, ak je správny, alebo vyberte iný" />
                                                <!-- owner, 28. 10.: the name of a file may be wrong – any title found can be chosen -->
                                                <ComboBox ItemsSource="{Binding Candidates}" DisplayMemberPath="Display" SelectedItem="{Binding ChosenCandidate}" FontSize="12" Margin="0,2,0,0"
                                                          Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="Vybrať iný titul z nájdených na TMDB (overí sa v HISTRA)" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- the file's own audio tracks without a language: chosen for this file, or what its speech suggests -->
                                <DataGridTemplateColumn Header="Jazyk audia" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding AudioSlots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,3">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Slot}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Display" FontSize="12"
                                                                          SelectedItem="{Binding SelectedChoice, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="Jazyk tejto stopy len pre tento súbor (prednosť pred voľbou pre skupinu)" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cieľ v knižnici" Binding="{Binding Target}" Width="1.5*" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Target}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="*" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Aj tak">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ProcessAnyway, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      Visibility="{Binding CanProcessAnyway, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Spracovať aj bez povinnej stopy šablóny" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- the buttons wrap under the title when the pane is narrow -->
                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Stopy skupiny" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4"
                                       ToolTip="Rozhodnutie platí pre všetky súbory skupiny" />
                            <WrapPanel HorizontalAlignment="Right">
                                <!-- owner, 28. 10.: everything, the group, or only chosen films (a menu opened by the button) -->
                                <Button Content="Rozpoznať jazyk audiostôp ▾" Click="OnSpeechMenu" Margin="0,0,8,4" Padding="10,3"
                                        ToolTip="Vypočuje si niekoľko úsekov z rôznych miest filmu a navrhne jazyk reči (whisper.cpp, všetko len v počítači; pár sekúnd na stopu). Vyberte, ktoré súbory.">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Vybrané súbory (v zozname, Ctrl / Shift)" Command="{Binding DetectAudioSelectedCommand}" />
                                            <MenuItem Header="Celá skupina – filmy každý zvlášť, seriál jedna epizóda" Command="{Binding DetectAudioCommand}" />
                                            <MenuItem Header="Všetky skupiny" Command="{Binding DetectAudioAllCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="Rozpoznať jazyk titulkov" Command="{Binding DetectSubtitlesCommand}" Margin="0,0,8,4" Padding="10,3"
                                        ToolTip="Prečíta textové titulky prvého súboru skupiny (číta celý súbor, môže chvíľu trvať)" />
                                <Button Content="Potvrdiť návrhy" Command="{Binding ConfirmSuggestionsCommand}" Margin="0,0,0,4" Padding="10,3" />
                            </WrapPanel>
                        </DockPanel>
                        <!-- owner, 29. 10. 2026: the tracks in the order of the result; dragged by the grip (or the arrows) within their type -->
                        <DataGrid Grid.Row="3" Margin="0,6,0,0" ItemsSource="{Binding SlotRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False"
                                  AllowDrop="True" DragOver="OnSlotDragOver" Drop="OnSlotDrop">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="{Binding Key.Type, Converter={StaticResource TrackTypeBrush}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemovedByLanguage}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Poradie" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="Transparent" Cursor="SizeAll" Padding="3,2" ToolTip="Chyťte a potiahnite stopu hore alebo dole (v rámci zvukov alebo titulkov)"
                                                        PreviewMouseLeftButtonDown="OnSlotGripDown" MouseMove="OnSlotGripMove">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="14" />
                                                </Border>
                                                <Button Command="{Binding MoveUpCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu hore">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10" />
                                                </Button>
                                                <Button Command="{Binding MoveDownCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu dole">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Stopa" Binding="{Binding Slot}" />
                                <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="70" />
                                <DataGridTextColumn Header="Názov v súbore" Binding="{Binding Name}" Width="*" MinWidth="80" />
                                <DataGridTemplateColumn Header="Jazyk" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- owner, 29. 10. 2026: also a language written in the file can be corrected ("EN" that is Czech) -->
                                            <ComboBox ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="SlovakName"
                                                      SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Jazyk stopy pre celú skupinu – aj keď je v súbore zapísaný iný (nesprávny) jazyk" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Pôvod" Width="1.2*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="11.5" />
                                                <TextBlock Text="{Binding Suggested}" FontWeight="SemiBold" FontSize="11.5" />
                                                <CheckBox Visibility="{Binding CanKeep, Converter={StaticResource BoolToVisibility}}" IsChecked="{Binding Kept, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="11.5" Margin="0,2,0,0" ToolTip="Tieto titulky ponechať, hoci ich jazyk nie je v zozname titulkov (Nastavenia)">
                                                    <TextBlock Text="{Binding ResultNote}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                </CheckBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Forced" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Visibility="{Binding IsSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                <CheckBox IsThreeState="True" IsChecked="{Binding Forced, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="zaškrtnuté = forced, prázdne = nie, plné pole = podľa súboru" />
                                                <TextBlock Text="{Binding ForcedHint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Bez šablóny" Command="{Binding RulesOnlyCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Zo skupiny" Command="{Binding TemplateFromGroupCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Upraviť…" Command="{Binding EditTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Načítať…" Command="{Binding LoadTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Uložiť…" Command="{Binding SaveTemplateCommand}" Padding="10,3" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="Šablóna:" FontWeight="SemiBold" /> <Run Text="{Binding TemplateDescription, Mode=OneWay}" />
                            </TextBlock>
                            <CheckBox Content="stopy mimo šablóny odstrániť" IsChecked="{Binding RemoveUnlisted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Originál:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton Content="zachovať" IsChecked="{Binding KeepOriginal}" GroupName="batchOriginal" Margin="0,0,12,0" />
                            <RadioButton Content="vymazať (zatiaľ vypnuté)" IsChecked="{Binding DeleteOriginal}" GroupName="batchOriginal" Margin="0,0,20,0"
                                         ToolTip="Zatiaľ vypnuté: kým program v praxi neodladíme, originály sa vždy zachovajú." ToolTipService.ShowOnDisabled="True" IsEnabled="False" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Run Text="Knižnica:" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="Priečinok…" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton Content="filmy" IsChecked="{Binding IsMovies}" GroupName="batchKind" VerticalAlignment="Center" Margin="0,0,12,0"
                                         IsEnabled="{Binding CanChooseKind}" />
                            <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="batchKind" VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsEnabled="{Binding CanChooseKind}" />
                            <TextBlock Text="{Binding KindNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="Potvrdiť" Command="{Binding ConfirmKindCommand}" Padding="10,3" Margin="0,0,20,0"
                                    Visibility="{Binding KindNeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Druh (filmy alebo seriál) je odhadnutý z mien súborov – potvrďte ho, alebo zvoľte druhý" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Seriál:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SeriesTitle, UpdateSourceTrigger=LostFocus}" Width="230" Margin="0,0,6,0"
                                         ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
                                <Button Content="TMDB" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,6,0"
                                          IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="TMDB ID:" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <TextBox Text="{Binding SeriesTmdbId, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                         ToolTip="Číslo seriálu na TMDB (napr. 227191) alebo adresa themoviedb.org/tv/… – názov sa načíta presne podľa neho" />
                                <TextBlock Text="{Binding OtherSeries}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap" MaxWidth="360"
                                           ToolTip="Epizódy ďalších seriálov poslané z Noviniek spolu s prvým – každá ide do priečinka svojho seriálu (vidno v stĺpci Cieľ v knižnici)" />
                                <TextBlock Text="{Binding SeriesSuggestion}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="420" />
                                <Button Content="Potvrdiť seriál" Command="{Binding ConfirmSeriesCommand}" Padding="10,3" Margin="0,0,12,0"
                                        Visibility="{Binding SeriesNeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="HISTRA tento seriál nepotvrdila – potvrďte ho, ak je správny (alebo zadajte iný)" />
                            </StackPanel>
                            <!-- owner, 30. 10. 2026: films have the same row as a series – title, TMDB, TMDB ID -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMovies, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Film:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding FilmTitle, UpdateSourceTrigger=LostFocus}" Width="230" Margin="0,0,6,0" IsEnabled="{Binding CanNameFilm}"
                                         ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB. Platí pre film vybranej skupiny (aj jeho verzie)." />
                                <Button Content="TMDB" Command="{Binding FilmTmdb.SearchCommand}" ToolTip="{Binding FilmTmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0"
                                        IsEnabled="{Binding CanNameFilm}" />
                                <ComboBox ItemsSource="{Binding FilmTmdb.Results}" SelectedItem="{Binding FilmTmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,6,0"
                                          IsDropDownOpen="{Binding FilmTmdb.IsOpen}" Visibility="{Binding FilmTmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="TMDB ID:" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <TextBox Text="{Binding FilmTmdbId, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center" IsEnabled="{Binding CanNameFilm}"
                                         ToolTip="Číslo filmu na TMDB (napr. 1629051) alebo adresa themoviedb.org/movie/… – názov sa načíta presne podľa neho, aj pri filme v inom písme" />
                                <TextBlock Text="{Binding FilmSuggestion}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="420" />
                                <TextBlock Text="{Binding FilmHint}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                            <Button Content="Spresniť názvy" Command="{Binding FindMoviesCommand}" Padding="10,3" Margin="0,0,6,0"
                                    Visibility="{Binding CanFindTitles, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Spresní navrhnuté názvy filmov podľa TMDB a overí ich v katalógu HISTRA; bez kľúča TMDB hľadá v HISTRA (len presná zhoda názvu a roku)" />
                            <Button Content="Prijať návrhy názvov" Command="{Binding ConfirmTitlesCommand}" Padding="10,3"
                                    ToolTip="Druh, názvy a čísla epizód odhadnuté z mien súborov a priečinkov (nie otázky Season 00 / Season 01)" />
                            <Button Content="Prijať všetko v skupine" Command="{Binding AcceptGroupCommand}" Padding="10,3" Margin="6,0,0,0" FontWeight="SemiBold"
                                    ToolTip="Pre vybranú skupinu naraz: druh, názov seriálu alebo filmu, čísla epizód aj jazyky stôp podľa návrhov (nie otázky Season 00 / bežná sezóna a návrhy s upozornením)" />
                            <Button Content="Špeciály do Season 00" Command="{Binding AnswerSpecialsCommand}" Padding="10,3" Margin="6,0,0,0"
                                    Visibility="{Binding HasSpecialsQuestions, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Odpoveď na otázku Season 00 alebo bežná sezóna: súbory z priečinka špeciálov (alebo s S00 v mene) idú do Season 00. Inak zadajte číslo epizódy pri súbore." />
                        </WrapPanel>
                        <!-- the end of a run, boldly (owner, 29. 10. 2026) -->
                        <Border Margin="0,8,0,0" CornerRadius="6" Padding="14,8" Background="{Binding Finish.Background, FallbackValue=Transparent}"
                                Visibility="{Binding HasFinish, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Finish.Icon}" FontSize="26" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Finish.Title}" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Finish.Detail}" FontSize="13" Foreground="White" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Uložiť správu…" Command="{Binding SaveReportCommand}" Margin="0,0,6,0" Padding="10,4" />
                                <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="0,0,6,0" Padding="10,4" />
                                <Button Content="Zastaviť" Command="{Binding StopCommand}" Margin="0,0,6,0" Padding="10,4"
                                        ToolTip="Dokončí rozpracované súbory a ďalej nepokračuje" />
                                <ComboBox ItemsSource="{Binding MegaTargets}" SelectedItem="{Binding SelectedMegaTarget}" DisplayMemberPath="Label" MaxWidth="220" Margin="0,0,4,0"
                                          FontSize="12" Visibility="{Binding IsEditingMega, Converter={StaticResource InverseBoolToVisibility}}"
                                          ToolTip="Kam idú pripravené súbory: nová dávka, alebo doplniť čakajúcu dávku" />
                                <Button Content="{Binding SendToMegaText}" Command="{Binding SendToMegaCommand}" Margin="0,0,6,0" Padding="12,4"
                                        ToolTip="Pripravené súbory uloží do dávky MEGA spracovania – zapíšu sa neskôr (keď dávku spustíte, po predchádzajúcej dávke alebo v nastavenom čase)" />
                                <Button Content="Spustiť" Command="{Binding RunCommand}" Padding="18,4" ToolTip="Spustí spracovanie ako úlohu vo Fronte úloh (priebeh aj výstup každého súboru uvidíte aj tam)" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Simulation}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding RunState}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <!-- the input folder, the same on every page that shows it -->
        <DataTemplate DataType="{x:Type pages:InputFolderViewModel}">
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="12,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Zmeniť…" Command="{Binding ChooseCommand}" Padding="10,3" Margin="8,0,6,0" />
                        <Button Content="Otvoriť" Command="{Binding OpenCommand}" Padding="10,3" ToolTip="Otvoriť v Prieskumníkovi" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}">
                            <Run Text="Vstupný priečinok: " FontWeight="SemiBold" /><Run Text="{Binding Display, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SortingHint}" Style="{StaticResource Hint}" FontSize="11.5" />
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SeriesNewsPageViewModel}">
            <DockPanel Margin="24,20,24,12">
                <DockPanel.Resources>
                    <Style x:Key="NewsRow" TargetType="DataGridRow" BasedOn="{StaticResource NewsRowBase}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Resources>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Novinky – Seriály" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Epizódy bežiacich seriálov za posledný týždeň (staršie sú v Histórii). Zaškrtnite epizódy a odošlite ich na spracovanie: UNIVERSUM ich hneď nájde vo vstupnom priečinku – jeden súbor ide do Single spracovania, viac do Hromadného spracovania. Súbory sa len čítajú." />
                    <ContentControl Content="{Binding InputFolder}" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Command="{Binding SendCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="Nájde zaškrtnuté epizódy vo vstupnom priečinku a odošle ich na spracovanie">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SendText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="Opýta sa zdrojov na dnešok a ďalšie dni hneď">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                    <TextBlock Text="Obnoviť" />
                                </StackPanel>
                            </Button>
                            <Button Content="Zastaviť" Command="{Binding StopCommand}" Padding="12,5" Margin="0,0,12,0"
                                    Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="2,0,0,6" />
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left" Width="520" Margin="0,0,0,8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" CornerRadius="10" BorderThickness="2" BorderBrush="{Binding Accent}" Background="{Binding Tint}" Padding="14,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="9" Background="{Binding Accent}" Padding="8,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CountText}" Foreground="White" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{Binding Accent}" />
                                                    <Setter TargetName="Title" Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!-- what is shown: the last week or the history; posters; only the chosen series; search -->
                    <DockPanel Margin="0,0,0,6">
                        <TextBox DockPanel.Dock="Right" Width="170" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                 ToolTip="Hľadať seriál, stanicu alebo poznámku (bez diakritiky)" />
                        <TextBlock DockPanel.Dock="Right" Text="Hľadať:" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <!-- owner, 29. 10. 2026: the size of the posters above the column of titles, the views further right -->
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0" IsEnabled="{Binding ShowPosters}"
                                        ToolTip="Zväčší postery v tabuľke až dvojnásobne (veľkosť sa zapamätá)">
                                <TextBlock Text="Veľkosť POSTERU" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Minimum="1" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Width="130"
                                        Value="{Binding PosterScale}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PosterScale, StringFormat={}{0:0.##}×}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="34"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <RadioButton Content="Týždeň spätne" IsChecked="{Binding ShowRecent}" GroupName="NewsView" MinWidth="0" Margin="0,0,16,0" />
                            <RadioButton Content="Nadchádzajúce" IsChecked="{Binding ShowUpcoming}" GroupName="NewsView" MinWidth="0" Margin="0,0,16,0" />
                            <RadioButton Content="História" IsChecked="{Binding ShowHistory}" GroupName="NewsView" MinWidth="0" Margin="0,0,24,0" />
                            <CheckBox Content="Zobraziť aj postery" IsChecked="{Binding ShowPosters}" MinWidth="0" Margin="0,0,16,0" />
                            <CheckBox Content="Zobraziť vybrané" IsChecked="{Binding OnlyChosen}" MinWidth="0" Margin="0,0,16,0" ToolTip="Len seriály zaškrtnuté v stĺpci Vybrané" />
                            <CheckBox Content="len z mojich listov HISTRA" IsChecked="{Binding OnlyMyLists}" MinWidth="0"
                                      Visibility="{Binding HasMyLists, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="2,0,0,6"
                               Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- further series for Hromadné spracovanie, and episodes not in the input folder yet -->
                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0" Visibility="{Binding HasReady, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Pripravené pre Hromadné spracovanie (jeden seriál naraz)" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Ready}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3,0,0">
                                            <Button DockPanel.Dock="Right" Content="Do Hromadného spracovania" Command="{Binding SendCommand}" Padding="10,2" />
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0" Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Skontrolovať znova" Command="{Binding CheckAgainCommand}" Padding="10,2" />
                                <TextBlock Text="Čaká na súbor vo vstupnom priečinku" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Waiting}" MaxHeight="120">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2,0,0">
                                            <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" Padding="6,1" ToolTip="Odstrániť zo zoznamu">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                                            </Button>
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Attribution}" Style="{StaticResource Hint}" FontSize="11.5" Margin="2,8,0,0" />
                </StackPanel>
                <Grid>
                    <!-- the series alphabetically with their nearest episode; opened, the tree of their episodes right under them -->
                    <DataGrid ItemsSource="{Binding SelectedTab.Rows}" Style="{StaticResource NewsGrid}" BorderBrush="{Binding SelectedTab.Accent}"
                              AlternatingRowBackground="{Binding SelectedTab.Stripe}" RowStyle="{StaticResource NewsRow}" ColumnHeaderStyle="{StaticResource NewsHeader}"
                              RowDetailsVisibilityMode="Collapsed" LoadingRow="OnNewsLoadingRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" MinWidth="36" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding ToggleCommand}" Padding="4" MinWidth="0" Margin="4,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                ToolTip="Zobraziť alebo skryť epizódy seriálu">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding ExpandGlyph}" FontSize="12" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Názov seriálu" Width="3*" MinWidth="210" SortMemberPath="Caption" CellTemplate="{StaticResource NewsTitleCell}" />
                            <DataGridTextColumn Header="Produkcia" Binding="{Binding Production}" Width="1.1*" MinWidth="90" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTemplateColumn Header="Spracovať" Width="88" MinWidth="88" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCheck}" MinWidth="0" Padding="0"
                                                      ToolTip="Zaškrtne všetky odvysielané epizódy seriálu na spracovanie" />
                                            <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dátum" Binding="{Binding Date}" Width="96" MinWidth="96" SortMemberPath="SortDate" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTextColumn Header="Kedy" Binding="{Binding When}" Width="96" MinWidth="96" SortMemberPath="SortDate">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NewsCell}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Deň" Binding="{Binding Day}" Width="70" MinWidth="70" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTemplateColumn Header="Najbližšia" Width="104" MinWidth="104" SortMemberPath="NearestCode">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding NearestCode}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding NearestNote}" Style="{StaticResource NewsSubtitle}" FontSize="11.5" />
                                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource NewsSubtitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2F9461" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Vybrané" Width="72" MinWidth="72" SortMemberPath="IsChosen" CellTemplate="{StaticResource NewsChosenCell}" />
                            <DataGridTemplateColumn Header="Poznámky" Width="1.6*" MinWidth="120" SortMemberPath="Note" CellTemplate="{StaticResource NewsNoteCell}" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="36,0,8,8" Padding="10,6" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <ItemsControl ItemsSource="{Binding Episodes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" Foreground="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCheck}" MinWidth="0" VerticalAlignment="Center"
                                                              ToolTip="Zaškrtnuté epizódy odošlete tlačidlom Odoslať na spracovanie (len odvysielané)">
                                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                    </CheckBox>
                                                    <TextBlock Grid.Column="2" Text="{Binding Mark}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Production}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Day}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Date}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6" Text="{Binding When}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding State}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" IsHitTestVisible="False"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:PremieresPageViewModel}">
            <DockPanel Margin="24,20,24,12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Premiéry" />
                    <ContentControl Content="{Binding InputFolder}" Margin="0,4,0,8" />
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Command="{Binding RefreshCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="Opýta sa zdrojov hneď (inak raz denne) a doplní, čo pribudlo">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                    <TextBlock Text="Obnoviť" />
                                </StackPanel>
                            </Button>
                            <Button Content="Zastaviť" Command="{Binding StopCommand}" Padding="12,5" Margin="0,0,12,0"
                                    Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                    </DockPanel>
                    <!-- the four tables as pastel tabs, each with its count -->
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" CornerRadius="10" BorderThickness="2" BorderBrush="{Binding Accent}" Background="{Binding Tint}" Padding="14,10">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="9" Background="{Binding Accent}" Padding="8,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CountText}" Foreground="White" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{Binding Accent}" />
                                                    <Setter TargetName="Title" Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderThickness" Value="3" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!-- what is shown: the coming premieres or the history; posters; only the chosen titles; search -->
                    <DockPanel Margin="0,0,0,6">
                        <TextBox DockPanel.Dock="Right" Width="170" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                 ToolTip="Hľadať názov, produkciu alebo poznámku (bez diakritiky)" />
                        <TextBlock DockPanel.Dock="Right" Text="Hľadať:" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <!-- owner, 29. 10. 2026: the size of the posters above the column of titles, the views further right -->
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,40,0" IsEnabled="{Binding ShowPosters}"
                                        ToolTip="Zväčší postery v tabuľke až dvojnásobne (veľkosť sa zapamätá)">
                                <TextBlock Text="Veľkosť POSTERU" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Minimum="1" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Width="130"
                                        Value="{Binding PosterScale}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PosterScale, StringFormat={}{0:0.##}×}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="34"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <RadioButton Content="Týždeň spätne" IsChecked="{Binding ShowRecent}" GroupName="PremiereView" MinWidth="0" Margin="0,0,16,0" />
                            <RadioButton Content="Nadchádzajúce" IsChecked="{Binding ShowUpcoming}" GroupName="PremiereView" MinWidth="0" Margin="0,0,16,0" />
                            <RadioButton Content="História" IsChecked="{Binding ShowHistory}" GroupName="PremiereView" MinWidth="0" Margin="0,0,24,0" />
                            <CheckBox Content="Zobraziť aj postery" IsChecked="{Binding ShowPosters}" MinWidth="0" Margin="0,0,16,0" />
                            <CheckBox Content="Zobraziť vybrané" IsChecked="{Binding OnlyChosen}" MinWidth="0" ToolTip="Len tituly zaškrtnuté v stĺpci Vybrané" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="2,0,0,6" />
                    <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="2,0,0,6"
                               Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Attribution}" Style="{StaticResource Hint}" FontSize="11.5" Margin="2,8,0,0" />
                <Grid>
                    <!-- films: title (with poster and links), production, premiere, day, VOD/TV, Vybrané, note -->
                    <DataGrid ItemsSource="{Binding SelectedTab.Rows}" Style="{StaticResource NewsGrid}" BorderBrush="{Binding SelectedTab.Accent}"
                              AlternatingRowBackground="{Binding SelectedTab.Stripe}" RowStyle="{StaticResource NewsRowBase}" ColumnHeaderStyle="{StaticResource NewsHeader}"
                              Visibility="{Binding IsFilmTab, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Názov filmu" Width="3*" MinWidth="210" SortMemberPath="Caption" CellTemplate="{StaticResource NewsTitleCell}" />
                            <DataGridTextColumn Header="Produkcia" Binding="{Binding Production}" Width="1.2*" MinWidth="95" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTemplateColumn Header="Premiéra" Width="100" MinWidth="100" SortMemberPath="SortDate">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Date}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Where}" Style="{StaticResource NewsSubtitle}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="None"
                                                       ToolTip="{Binding Where}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Kedy" Binding="{Binding When}" Width="96" MinWidth="96" SortMemberPath="SortDate">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NewsCell}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Deň" Binding="{Binding Day}" Width="70" MinWidth="70" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTextColumn Header="VOD / TV / kino" Binding="{Binding Availability}" Width="1.6*" MinWidth="120" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTemplateColumn Header="Vybrané" Width="72" MinWidth="72" SortMemberPath="IsChosen" CellTemplate="{StaticResource NewsChosenCell}" />
                            <DataGridTemplateColumn Header="Poznámky" Width="1.6*" MinWidth="120" SortMemberPath="Note" CellTemplate="{StaticResource NewsNoteCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- series: title, production, premiere, day, periodicity, number of episodes, Vybrané, note -->
                    <DataGrid ItemsSource="{Binding SelectedTab.Rows}" Style="{StaticResource NewsGrid}" BorderBrush="{Binding SelectedTab.Accent}"
                              AlternatingRowBackground="{Binding SelectedTab.Stripe}" RowStyle="{StaticResource NewsRowBase}" ColumnHeaderStyle="{StaticResource NewsHeader}"
                              Visibility="{Binding IsSeriesTab, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Názov seriálu" Width="3*" MinWidth="210" SortMemberPath="Caption" CellTemplate="{StaticResource NewsTitleCell}" />
                            <DataGridTextColumn Header="Produkcia" Binding="{Binding Production}" Width="1.2*" MinWidth="95" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTextColumn Header="Premiéra" Binding="{Binding Date}" Width="100" MinWidth="100" SortMemberPath="SortDate" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTextColumn Header="Kedy" Binding="{Binding When}" Width="96" MinWidth="96" SortMemberPath="SortDate">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NewsCell}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Séria · epizóda" Binding="{Binding What}" Width="120" MinWidth="120" SortMemberPath="What" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTextColumn Header="Deň" Binding="{Binding Day}" Width="70" MinWidth="70" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTextColumn Header="Periodicita" Binding="{Binding Periodicity}" Width="1.2*" MinWidth="95" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTextColumn Header="Epizódy" Binding="{Binding Episodes}" Width="76" MinWidth="76" ElementStyle="{StaticResource NewsCell}" />
                            <DataGridTemplateColumn Header="Vybrané" Width="72" MinWidth="72" SortMemberPath="IsChosen" CellTemplate="{StaticResource NewsChosenCell}" />
                            <DataGridTemplateColumn Header="Poznámky" Width="1.6*" MinWidth="120" SortMemberPath="Note" CellTemplate="{StaticResource NewsNoteCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" IsHitTestVisible="False"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:HistraListsPageViewModel}">
            <DockPanel Margin="24,20,24,12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Listy z HISTRA" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Vaše listy filmov a seriálov z histra.net. UNIVERSUM ich z HISTRA len číta (nič tam nezapisuje), uchováva ich len v tomto počítači a obnoví ich iba tlačidlom Synchronizovať." />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Command="{Binding ImportCommand}" Padding="12,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                    <TextBlock Text="Importovať listy…" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SyncCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="Načíta všetky importované listy z HISTRA znova">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0" />
                                    <TextBlock Text="Synchronizovať" />
                                </StackPanel>
                            </Button>
                            <Button Content="Zastaviť" Command="{Binding StopCommand}" Padding="12,5" Margin="0,0,16,0"
                                    Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Hľadať film alebo seriál v listoch (český aj pôvodný názov, rok; bez diakritiky)" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="Hľadať:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Status}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Requirement}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanUse}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- the detail of the chosen title -->
                <Border DockPanel.Dock="Right" Width="380" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0"
                        Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DataContext="{Binding Selected}">
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,8,8,0" Padding="8,2" ToolTip="Zavrieť"
                                Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=DockPanel, AncestorLevel=2}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                        </Button>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,0,18,18">
                                <Border Width="200" Height="300" CornerRadius="8" HorizontalAlignment="Left" Background="{Binding List.Tint}">
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding LargePoster.Image}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <TextBlock Text="{Binding Caption}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding LocalTitle}" FontSize="15" TextWrapping="Wrap"
                                           Visibility="{Binding HasLocalTitle, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Facts}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="Odkazy" FontWeight="SemiBold" Margin="0,14,0,4" />
                                <ItemsControl ItemsSource="{Binding Links}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Text}" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Padding="10,3" Margin="0,0,6,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Identifikátory" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <ItemsControl ItemsSource="{Binding Ids}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding HasOther, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Ďalšie údaje z HISTRA" FontWeight="SemiBold" Margin="0,10,0,4" />
                                    <ItemsControl ItemsSource="{Binding Other}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,14,0,0"
                                           Text="Údaje a ID pochádzajú z HISTRA, plagáty zo servera plagátov v Nastaveniach. ČSFD ID HISTRA nemá – odkaz otvorí hľadanie na ČSFD." />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid>
                    <!-- no list yet -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20,16"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Zatiaľ tu nie je žiadny list" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Kliknite na Importovať listy… – ukážu sa vaše listy z HISTRA s náhľadmi plagátov a vyberiete, ktoré má mať UNIVERSUM." />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Lists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14" Background="{Binding Tint}"
                                            AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="5" CornerRadius="8,0,0,8" Background="{Binding Accent}" />
                                            <!-- the order of the lists: drag by the grip, or the arrows -->
                                            <StackPanel DockPanel.Dock="Left" Margin="8,10,0,0" VerticalAlignment="Top">
                                                <Border Background="Transparent" Cursor="SizeAll" Padding="4,2" ToolTip="Chyťte a potiahnite list hore alebo dole"
                                                        PreviewMouseLeftButtonDown="OnListGripDown" MouseMove="OnListGripMove">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Accent}" />
                                                </Border>
                                                <Button Command="{Binding MoveUpCommand}" Padding="6,2" Margin="0,4,0,0" MinWidth="0" ToolTip="Posunúť list hore">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="11" />
                                                </Button>
                                                <Button Command="{Binding MoveDownCommand}" Padding="6,2" Margin="0,4,0,0" MinWidth="0" ToolTip="Posunúť list dole">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Margin="14,10,14,12">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding FilterResult}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Button Content="{Binding ExpandText}" Command="{Binding ToggleCommand}" Padding="10,3" Margin="0,0,6,0"
                                                                Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Command="{Binding RemoveCommand}" Padding="8,3" ToolTip="Odstrániť list z UNIVERSUM (v HISTRA ostane)">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Accent}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="12" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="V HISTRA sa tento list pri poslednej synchronizácii nenašiel – tu ostáva jeho posledný obsah."
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                                                                   Visibility="{Binding Missing, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Visible}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,10,10" Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <StackPanel Width="96">
                                                                            <Border x:Name="Frame" Width="96" Height="144" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent"
                                                                                    Background="{Binding List.Tint}">
                                                                                <Grid>
                                                                                    <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="6" FontSize="11.5" />
                                                                                    <Border CornerRadius="4">
                                                                                        <Border.Background>
                                                                                            <ImageBrush ImageSource="{Binding SmallPoster.Image}" Stretch="UniformToFill" />
                                                                                        </Border.Background>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Caption}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                                        </StackPanel>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{Binding List.Accent}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:InterestsPageViewModel}">
            <DockPanel Margin="24,20,24,12">
                <!-- a pastel banner, the controls, the chips of the sources -->
                <StackPanel DockPanel.Dock="Top">
                    <Border CornerRadius="14" Padding="22,14" Margin="0,0,0,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#55F28C7C" Offset="0" />
                                <GradientStop Color="#55F2B34E" Offset="0.3" />
                                <GradientStop Color="#5563C48F" Offset="0.55" />
                                <GradientStop Color="#556FA8E8" Offset="0.8" />
                                <GradientStop Color="#55A78BE6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding RefreshCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="Načíta zdroje hneď (inak pri prvom spustení dňa)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                        <TextBlock Text="Obnoviť" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Zastaviť" Command="{Binding StopCommand}" Padding="12,5" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Zaujímavosti" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Text="Novinky, recenzie a zaujímavosti zo sveta filmu – preložené do vášho jazyka, celé články u ich autorov." TextWrapping="Wrap" Opacity="0.85" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DockPanel Margin="0,0,0,6">
                        <TextBox DockPanel.Dock="Right" Width="170" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="Hľadať v nadpisoch a úvodoch (bez diakritiky)" />
                        <TextBlock DockPanel.Dock="Right" Text="Hľadať:" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <WrapPanel VerticalAlignment="Center">
                            <RadioButton Content="Dnes" IsChecked="{Binding ShowToday}" GroupName="InterestPeriod" MinWidth="0" Margin="0,0,16,0" />
                            <RadioButton Content="Tento týždeň" IsChecked="{Binding ShowWeek}" GroupName="InterestPeriod" MinWidth="0" Margin="0,0,16,0" />
                            <RadioButton Content="Všetko (História)" IsChecked="{Binding ShowAll}" GroupName="InterestPeriod" MinWidth="0" Margin="0,0,24,0" />
                            <CheckBox Content="Len obľúbené ★" IsChecked="{Binding OnlyFavorites}" MinWidth="0" Margin="0,0,16,0" />
                            <CheckBox Content="Zobraziť originál" IsChecked="{Binding ShowOriginal}" MinWidth="0" />
                        </WrapPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Sources}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ChooseCommand}" Margin="0,0,6,6" Cursor="Hand" ToolTip="Len články tohto zdroja (znova kliknúť = všetky)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip" CornerRadius="12" Padding="12,3" BorderThickness="1.5" BorderBrush="{Binding Accent}" Background="{Binding Tint}">
                                                <TextBlock x:Name="Label" Text="{Binding Text}" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{Binding Accent}" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="2,0,0,4" />
                    <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="2,0,0,6"
                               Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Attribution}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="2,8,0,0" />
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- the newest article big -->
                            <Border DataContext="{Binding Featured}" CornerRadius="14" BorderThickness="2" BorderBrush="{Binding Accent}" Background="{Binding Tint}"
                                    Padding="14" Margin="0,0,10,14" Visibility="{Binding DataContext.IsEmpty, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="360" Height="200" CornerRadius="10" Margin="0,0,18,0" Background="{Binding Accent}"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border CornerRadius="10" Background="{Binding Accent}" Padding="10,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Source}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding LanguageText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,10" MaxHeight="110" TextTrimming="WordEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Čítať celý článok" Command="{Binding OpenCommand}" Padding="14,5" Margin="0,0,8,0" />
                                            <Button Command="{Binding FavoriteCommand}" Padding="10,5" Margin="0,0,8,0" ToolTip="Obľúbené">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="☆" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Text" Value="★" />
                                                                    <Setter Property="Foreground" Value="#E8A33A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Content="Originál / preklad" Command="{Binding ToggleOriginalCommand}" Padding="10,5" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- the other articles as colourful cards -->
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="300" Margin="0,0,12,12" CornerRadius="12" BorderThickness="1.5" BorderBrush="{Binding Accent}" Background="{Binding Tint}">
                                            <StackPanel>
                                                <Border Height="150" CornerRadius="11,11,0,0" Background="{Binding Accent}" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                                    <Border CornerRadius="11,11,0,0">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                                <StackPanel Margin="12,10,12,12">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border CornerRadius="9" Background="{Binding Accent}" Padding="8,1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Source}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                                        </Border>
                                                        <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" FontSize="11.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="64" TextTrimming="WordEllipsis" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="88" TextTrimming="WordEllipsis" Margin="0,6,0,8"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LanguageText}" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Čítať" Command="{Binding OpenCommand}" Padding="10,2" Margin="0,0,6,0" />
                                                            <Button Command="{Binding FavoriteCommand}" Padding="8,2" Margin="0,0,6,0" ToolTip="Obľúbené">
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="☆" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                    <Setter Property="Text" Value="★" />
                                                                                    <Setter Property="Foreground" Value="#E8A33A" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                            <Button Content="Originál" Command="{Binding ToggleOriginalCommand}" Padding="8,2" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Zobraziť ďalšie" Command="{Binding MoreCommand}" HorizontalAlignment="Center" Padding="16,6" Margin="0,4,0,12"
                                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" IsHitTestVisible="False"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:DashboardPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16">
                        <Run Text="{Binding Greeting, Mode=OneWay}" /><Run Text=" – prehľad dňa a toho, čo UNIVERSUM práve robí." />
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.3*" MinWidth="380" />
                        </Grid.ColumnDefinitions>
                        <!-- today: time, date, name day -->
                        <Border Style="{StaticResource Card}" Padding="20,16" BorderBrush="#66F2A07C">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#40FFB38A" Offset="0" />
                                    <GradientStop Color="#26F28CB0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="Dnes" FontWeight="SemiBold" Foreground="#D9673A" />
                                <TextBlock Text="{Binding TimeText}" FontSize="46" FontWeight="Light" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DateText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NameDayText}" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding TomorrowText}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DayInfo}" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- weather of the town in the settings (Open-Meteo, named below) -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" BorderBrush="#665BA8E0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4D7CC4F5" Offset="0" />
                                    <GradientStop Color="#26A78BE6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Content="Obnoviť" Command="{Binding RefreshWeatherCommand}" Padding="10,3"
                                            Visibility="{Binding HasPlace, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Počasie" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding PlaceText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Right" FontSize="11.5" VerticalAlignment="Bottom">
                                        <Hyperlink Command="{Binding OpenWeatherSiteCommand}" ToolTip="https://open-meteo.com – údaje pod licenciou CC BY 4.0">
                                            <Run Text="{Binding WeatherAttribution, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="{Binding WeatherMessage}" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,12,0" />
                                </DockPanel>
                                <StackPanel>
                                    <Button Content="Nastaviť mesto…" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,12,0,0"
                                            Visibility="{Binding HasPlace, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Visibility="{Binding HasWeather, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding WeatherSymbol}" FontFamily="Segoe UI Symbol" FontSize="44" VerticalAlignment="Center" Margin="0,0,14,0"
                                                       Foreground="#F2A33A" />
                                            <TextBlock Text="{Binding TemperatureText}" FontSize="44" FontWeight="Light" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeatherDescription}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WeatherDetail}" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding WeatherDays}" Margin="0,12,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Background="#337CC4F5" Margin="0,0,6,0" Padding="10,4" ToolTip="{Binding Description}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Temperatures}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Rain}" Style="{StaticResource Hint}" FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <!-- this week: episodes of the chosen series and premieres, films premiering -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="20,14" BorderBrush="#6663C48F">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3363C48F" Offset="0" />
                                    <GradientStop Color="#1F6FA8E8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Novinky – Seriály" Command="{Binding Week.OpenNewsCommand}" Padding="10,2" />
                                    <TextBlock Text="Tento týždeň – seriály" FontWeight="SemiBold" FontSize="15" Foreground="#2F9461" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Žiadne epizódy vybraných seriálov ani premiéry seriálov – seriály, ktoré sledujete, zaškrtnite v Novinkách v stĺpci Vybrané."
                                           Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Week.NoEpisodes, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Week.Episodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Day" Text="{Binding Day}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="★" Foreground="#E8A33A" Visibility="{Binding Chosen, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Day" Property="Foreground" Value="#2F9461" />
                                                    <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14" BorderBrush="#66F28C7C">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#33F28C7C" Offset="0" />
                                    <GradientStop Color="#1FF2C14E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Premiéry" Command="{Binding Week.OpenPremieresCommand}" Padding="10,2" />
                                    <TextBlock Text="Tento týždeň – filmy" FontWeight="SemiBold" FontSize="15" Foreground="#C9573F" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Tento týždeň nemá premiéru žiadny sledovaný film." Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Visibility="{Binding Week.NoFilms, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Week.Films}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Day" Text="{Binding Day}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="★" Foreground="#E8A33A" Visibility="{Binding Chosen, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Day" Property="Foreground" Value="#C9573F" />
                                                    <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- where the chosen titles can be watched legally; chosen titles already in the input folder -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="20,14" BorderBrush="#664FB8B8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#334FB8B8" Offset="0" />
                                    <GradientStop Color="#1F63C48F" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Skontrolovať" Command="{Binding Week.CheckWatchCommand}" Padding="10,2"
                                            ToolTip="Zistí hneď, kde sa dajú vybrané tituly pozerať (inak raz denne pri spustení)" />
                                    <TextBlock Text="Kde pozerať – vybrané tituly" FontWeight="SemiBold" FontSize="15" Foreground="#2E8F8F" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Vybrané tituly zatiaľ nie sú na streamovacích službách na Slovensku ani v Česku (alebo ešte neboli skontrolované)."
                                           Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Week.NoOffers, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Week.Offers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Border DockPanel.Dock="Right" CornerRadius="8" Background="#2E8F8F" Padding="7,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="NOVÉ" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Where}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Week.WatchStatus}" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Week.WatchAttribution}" Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14" BorderBrush="#669CC25A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#339CC25A" Offset="0" />
                                    <GradientStop Color="#1FF2C14E" Offset="1" />
                                </LinearGradientBrush>
