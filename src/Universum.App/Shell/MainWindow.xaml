                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2EA78BE6" Offset="0" />
                                    <GradientStop Color="#1A6FA8E8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        <StackPanel>
                            <TextBlock Text="UNIVERSUM teraz" FontWeight="SemiBold" Margin="0,0,0,6" />
