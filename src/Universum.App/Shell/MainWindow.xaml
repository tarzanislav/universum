                                                <StackPanel>
                                                    <TextBox Text="{Binding Naming, UpdateSourceTrigger=LostFocus}"
                                                             ToolTip="{loc:T 'Film: Názov (rok), napr. Creep (2004). Seriál: číslo epizódy, napr. S01E04.'}" />
                                                    <!-- owner, 29. 10. 2026: a film exactly by its TMDB ID -->
                                                    <DockPanel Margin="0,2,0,0" Visibility="{Binding IsFilm, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{loc:T 'TMDB ID:'}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBox Text="{Binding TmdbId, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                                                 ToolTip="{loc:T 'Presne podľa TMDB: číslo filmu (napr. 12345) alebo adresa z themoviedb.org; minisériál vložte ako adresu …/tv/…. Použije sa, keď pole opustíte.'}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding NamingSuggestion}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <Button Content="{loc:T 'Potvrdiť návrh'}" Command="{Binding ConfirmCommand}" Padding="8,2" Margin="0,2,0,0" FontSize="12" HorizontalAlignment="Left"
                                                            Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{loc:T 'Návrh nie je istý (názov sa líšil od mena súboru alebo HISTRA titul nepotvrdila) – potvrďte ho, ak je správny, alebo vyberte iný'}" />
                                                    <!-- owner, 28. 10.: the name of a file may be wrong – any title found can be chosen -->
                                                    <ComboBox ItemsSource="{Binding Candidates}" DisplayMemberPath="Display" SelectedItem="{Binding ChosenCandidate}" FontSize="12" Margin="0,2,0,0"
                                                              Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}"
                                                              ToolTip="{loc:T 'Vybrať iný titul z nájdených na TMDB (overí sa v HISTRA)'}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- the file's own audio tracks without a language: chosen for this file, or what its speech suggests -->
                                    <DataGridTemplateColumn Header="{loc:T 'Jazyk audia'}" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding AudioSlots}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,3">
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding Slot}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding Choices}" DisplayMemberPath="Display" FontSize="12"
                                                                              SelectedItem="{Binding SelectedChoice, UpdateSourceTrigger=PropertyChanged}"
                                                                              ToolTip="{loc:T 'Jazyk tejto stopy len pre tento súbor (prednosť pred voľbou pre skupinu)'}" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:T 'Cieľ v knižnici'}" Binding="{Binding Target}" Width="1.5*" MinWidth="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Target}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="{loc:T 'Doplnok k názvu'}" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" MinWidth="100"
                                                          VerticalAlignment="Top"
                                                          ToolTip="{loc:T 'Doplnok do názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie.'}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:T 'Výsledok'}" Binding="{Binding Outcome}" Width="*" MinWidth="90">
                                        <DataGridTextColumn.ElementStyle>
