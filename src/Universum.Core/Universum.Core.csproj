<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tool-independent core of UNIVERSUM: media model, rules, planning and the MKVToolNix backend.
       Only the .NET base library is used, so the core builds and is tested on Windows and Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Universum.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Universum.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Slovak calendar of names: data of name-day-calendar (MIT, Peter Knezek), see THIRD-PARTY-NOTICES.md -->
    <EmbeddedResource Include="Calendar\sk-namedays.txt" LogicalName="Universum.Core.Calendar.sk-namedays.txt" />
  </ItemGroup>
</Project>
