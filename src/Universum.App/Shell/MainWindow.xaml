                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Temperatures}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Rain}" Style="{StaticResource Hint}" FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <!-- this week: episodes of the chosen series and premieres, films premiering -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="20,14" BorderBrush="#6663C48F">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3363C48F" Offset="0" />
                                    <GradientStop Color="#1F6FA8E8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Novinky – Seriály" Command="{Binding Week.OpenNewsCommand}" Padding="10,2" />
