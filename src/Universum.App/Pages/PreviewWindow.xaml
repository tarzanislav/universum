<Window x:Class="Universum.App.Pages.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:player="clr-namespace:Universum.App.Player"
        Title="{Binding Title, StringFormat='UNIVERSUM – náhľad: {0}'}" Width="1100" Height="760" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <!-- owner, 1. 11. 2026: a preview of Zlučovanie in UNIVERSUM's player, with the sound and subtitles of the result -->
    <DockPanel Margin="16,12,16,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Titulky:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Subtitles}" SelectedItem="{Binding Subtitle}" Width="260" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <player:PlayerView DataContext="{Binding Player}" />
    </DockPanel>
</Window>
