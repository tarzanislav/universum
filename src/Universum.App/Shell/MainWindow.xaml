                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Rozpoznať jazyk titulkov" Command="{Binding DetectSubtitlesCommand}" Margin="0,0,8,0" Padding="10,3"
                                        ToolTip="Prečíta textové titulky prvého súboru skupiny (číta celý súbor, môže chvíľu trvať)" />
                                <Button Content="Potvrdiť návrhy" Command="{Binding ConfirmSuggestionsCommand}" Padding="10,3" />
                            </StackPanel>
                            <TextBlock Text="Stopy skupiny" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Rozhodnutie platí pre všetky súbory skupiny" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding SlotRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stopa" Binding="{Binding Slot}" />
                                <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="70" />
                                <DataGridTextColumn Header="Názov v súbore" Binding="{Binding Name}" Width="*" MinWidth="80" />
                                <DataGridTemplateColumn Header="Jazyk" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding FileLanguage}" Visibility="{Binding NeedsLanguage, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Center" />
                                                <ComboBox Visibility="{Binding NeedsLanguage, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding LanguageChoices}"
                                                          DisplayMemberPath="SlovakName" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Pôvod" Width="1.2*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="11.5" />
                                                <TextBlock Text="{Binding Suggested}" FontWeight="SemiBold" FontSize="11.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Forced" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Visibility="{Binding IsSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                <CheckBox IsThreeState="True" IsChecked="{Binding Forced, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="zaškrtnuté = forced, prázdne = nie, plné pole = podľa súboru" />
                                                <TextBlock Text="{Binding ForcedHint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Súbory skupiny – výsledok simulácie" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <DataGrid Grid.Row="3" ItemsSource="{Binding FileRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Súbor" Binding="{Binding FileName}" Width="*" MinWidth="110" />
                                <DataGridTemplateColumn Header="Film / epizóda" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Text="{Binding Naming, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Film: Názov (rok), napr. Creep (2004). Seriál: číslo epizódy, napr. S01E04." />
                                                <TextBlock Text="{Binding NamingSuggestion}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cieľ v knižnici" Binding="{Binding Target}" Width="1.5*" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Target}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="*" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Aj tak">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ProcessAnyway, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      Visibility="{Binding CanProcessAnyway, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Spracovať aj bez povinnej stopy šablóny" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

