<Window x:Class="Universum.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Universum.App.Pages"
        xmlns:app="clr-namespace:Universum.App"
        xmlns:jobs="clr-namespace:Universum.App.Jobs"
        xmlns:loc="clr-namespace:Universum.App.Localization"
        xmlns:player="clr-namespace:Universum.App.Player"
        Title="{loc:T 'UNIVERSUM'}" Icon="pack://application:,,,/Assets/universum.ico" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/Shared.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/MediaPages.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/JobsPages.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/NewsPages.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/AgendaPages.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/HomePages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- the templates whose events are handled in MainWindow.xaml.cs stay here; the others are in Templates/*.xaml -->
            <!-- owner, 29. 10. 2026: a chosen row of any table stays readable – a light blue with dark text, never the theme's
                 dark selection (the tables of Premiéry and Novinky have their own) -->
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#CFE3F8" />
                        <Setter Property="BorderBrush" Value="#CFE3F8" />
                        <Setter Property="Foreground" Value="#141414" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <DataTemplate DataType="{x:Type pages:RulesPageViewModel}">
                <Grid Margin="32,24,32,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:T 'Vymazať frontu'}" Command="{Binding ClearCommand}" Padding="12,6" Margin="8,0,0,0"
                                ToolTip="{loc:T 'Zabudne otvorený, ešte nespracovaný súbor (na disku sa nič nezmení)'}" />
                        <Button DockPanel.Dock="Right" Content="{loc:T 'Otvoriť súbor…'}" Command="{Binding OpenCommand}" Padding="16,6" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Single spracovanie'}" />
                                <ContentControl Content="{Binding DataContext.TrayService, RelativeSource={RelativeSource AncestorType=Window}}" ContentTemplate="{DynamicResource TrayAutoSwitch}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="16,0,0,4" />
                            </StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,8,0,12">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                        <TextBlock Text="{Binding Issues}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </StackPanel>
                    <!-- owner, 29. 10. 2026: the tracks in the order of the result; dragged by the grip (or the arrows) within their type -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False"
                              AllowDrop="True" DragOver="OnRuleDragOver" Drop="OnRuleDrop">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="{Binding Type, Converter={StaticResource TrackTypeBrush}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemovedByLanguage}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:T 'Poradie'}" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanMove, Converter={StaticResource BoolToVisibility}}">
                                            <Border Background="Transparent" Cursor="SizeAll" Padding="3,2" ToolTip="{loc:T 'Chyťte a potiahnite stopu hore alebo dole (v rámci zvukov alebo titulkov)'}"
                                                    PreviewMouseLeftButtonDown="OnRuleGripDown" MouseMove="OnRuleGripMove">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="14" />
                                            </Border>
                                            <Button Command="{Binding MoveUpCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="{loc:T 'Posunúť stopu hore'}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10" />
                                            </Button>
                                            <Button Command="{Binding MoveDownCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="{loc:T 'Posunúť stopu dole'}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding PositionText}" />
                            <DataGridTemplateColumn Header="{loc:T 'Typ'}" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TypeChip}" Background="{Binding Type, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                            <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:T 'Kodek'}" Binding="{Binding Codec}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Codec}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{loc:T 'Jazyk (pred → po)'}" Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- owner, 29. 10. 2026: also a language written in the file can be corrected ("EN" that is Czech) -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding LanguageBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanguageAfter}" FontWeight="SemiBold" Visibility="{Binding CanChooseLanguage, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" Visibility="{Binding CanChooseLanguage, Converter={StaticResource BoolToVisibility}}"
                                                      ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="Name" MinWidth="160" ToolTip="{loc:T 'Jazyk stopy – neurčený, alebo nesprávny jazyk zapísaný v súbore'}" />
                                            <TextBlock Text="{Binding LanguageNote}" FontSize="11" TextWrapping="Wrap" MaxWidth="260" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasLanguageNote, Converter={StaticResource BoolToVisibility}}" />
                                            <CheckBox Visibility="{Binding CanKeep, Converter={StaticResource BoolToVisibility}}" IsChecked="{Binding KeepChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="11.5" Margin="0,2,0,0" ToolTip="{loc:T 'Tieto titulky ponechať, hoci ich jazyk nie je v zozname titulkov (Nastavenia)'}">
                                                <TextBlock Text="{Binding ResultNote}" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="260" />
                                            </CheckBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:T 'Názov (pred → po)'}" Width="*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding NameBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding NameAfter}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding CanName, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <!-- owner, 30. 10. 2026: Track name – the name can be written or added to -->
                                            <TextBox Text="{Binding EditedName, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" MinWidth="120"
                                                     Visibility="{Binding CanName, Converter={StaticResource BoolToVisibility}}"
                                                     ToolTip="{loc:T 'Názov stopy vo výsledku – môžete ho prepísať alebo doň dopísať (potvrdí sa po opustení poľa); prázdny = bez názvu'}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:T 'Default'}" Binding="{Binding DefaultAfter}" />
                            <DataGridTextColumn Header="{loc:T 'Enabled'}" Binding="{Binding EnabledAfter}" />
                            <!-- owner, 30. 10. 2026: forced also by the small amount of subtitles – UNIVERSUM's suggestion, changed here -->
                            <DataGridTemplateColumn Header="{loc:T 'Forced'}" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsForced, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Margin="0,0,4,0"
                                                          Visibility="{Binding IsSubtitles, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="{loc:T 'Forced titulky (aktívne len CZ, inak SK; ostatné dostanú len názov Forced)'}" />
                                                <TextBlock Text="{Binding ForcedAfter}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ForcedNote}" FontSize="11" TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- owner, 1. 11. 2026: WebVTT, ASS … written as SRT inside the result, only when ticked -->
                            <DataGridTemplateColumn Header="{loc:T 'Na SRT'}" Width="Auto" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding ToSrt, UpdateSourceTrigger=PropertyChanged}" MinWidth="0"
                                                      Visibility="{Binding CanConvertToSrt, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="{loc:T 'Titulky sa vo výsledku zapíšu ako SRT; stopa pôvodného formátu v ňom nebude (originál sa nemení)'}" />
                                            <TextBlock Text="{Binding ToSrtHint}" FontSize="11" TextWrapping="Wrap" MaxWidth="220" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:T 'Iné príznaky'}" Binding="{Binding OtherFlagsAfter}" />
                            <DataGridTextColumn Header="{loc:T 'Rola'}" Binding="{Binding Role}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{loc:T 'Originál:'}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                <RadioButton Content="{loc:T 'zachovať'}" IsChecked="{Binding KeepOriginal}" Margin="0,0,16,0" GroupName="original" />
                                <RadioButton Content="{loc:T 'vymazať (zatiaľ vypnuté)'}" IsChecked="{Binding DeleteOriginal}" Margin="0,0,24,0" GroupName="original"
                                             ToolTip="{loc:T 'Single spracovanie originály vždy zachová – mazanie originálov je len v Hromadnom spracovaní.'}" ToolTipService.ShowOnDisabled="True" IsEnabled="False" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,8,0">
                                    <Run Text="{loc:T 'Knižnica:'}" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="{loc:T 'Priečinok…'}" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,4" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <RadioButton Content="{loc:T 'film'}" IsChecked="{Binding IsMovie}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <RadioButton Content="{loc:T 'seriál'}" IsChecked="{Binding IsSeries}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,20,0" />
                                <TextBlock Text="{loc:T 'Titul:'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,6,0"
                                         ToolTip="{loc:T 'Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB'}" />
                                <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                                <ContentControl Content="{Binding Tray}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="220" Margin="0,0,16,0"
                                          IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="{loc:T 'Potvrdiť titul'}" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                        Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:T 'Doplnok:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" Width="130" VerticalAlignment="Center"
                                              ToolTip="{loc:T 'Doplnok k názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie.'}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:T 'Epizóda:'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="{loc:T 'napr. S01E04'}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}">
                                <Run Text="{loc:T 'Cieľ:'}" FontWeight="SemiBold" /> <Run Text="{Binding Target, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap">
                                <Run Text="{Binding Tmdb.Message, Mode=OneWay}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" />
                            </TextBlock>
                            <!-- owner, 7. 11. 2026: Ponechať MP4 – shown for an MP4; the same switch as in Hromadné and Nastavenia -->
                            <CheckBox Content="{loc:T 'MP4 ponechať ako MP4 (len hlavička)'}" IsChecked="{Binding KeepMp4}" Margin="0,6,0,0" IsEnabled="{Binding IsIdle}"
                                      Visibility="{Binding IsMp4, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="{loc:T 'Súbor ostane MP4 – UNIVERSUM upraví len jeho hlavičku (jazyky, názvy, predvolené stopy, Forced, titulky pre nepočujúcich, komentár, poradie, názov; odstránené titulky), obraz a zvuk sa nedotknú. Ak treba zmenu, ktorú MP4 neudrží (odstrániť zvuk, pridať stopu…), zapíše sa ako MKV.'}" />
                            <!-- owner, 2. 11. 2026: the file in the studios and back with their edits (also a file of a MEGA batch) -->
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{loc:T 'Titulky v štúdiu'}" Command="{Binding EditInStudioCommand}" Padding="10,3" Margin="0,0,6,0"
                                        ToolTip="{loc:T 'Otvorí súbor v Úprave titulkostopy – časy, jazyk, Forced, pridané titulky; Uložiť do úlohy vás vráti sem'}" />
                                <Button Content="{loc:T 'Zvuk v štúdiu'}" Command="{Binding EditSoundInStudioCommand}" Padding="10,3" Margin="0,0,6,0"
                                        ToolTip="{loc:T 'Otvorí súbor v Úprave audiostopy – posun, FPS, kodek, hlasitosť, dabing; Uložiť do úlohy vás vráti sem'}" />
                                <Button Content="{loc:T 'Obraz v štúdiu'}" Command="{Binding EditPictureInStudioCommand}" Padding="10,3" Margin="0,0,12,0"
                                        ToolTip="{loc:T 'Otvorí súbor v Úprave videostopy – strih, pomer strán, otočenie, výška, kodek; Uložiť do úlohy vás vráti sem'}" />
                                <TextBlock Text="{Binding StudioText}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
                            </WrapPanel>
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{loc:T 'Vrátiť späť'}" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                    <Button Content="{loc:T 'Revízia'}" Command="{Binding ReviseCommand}" Margin="0,0,8,0" Padding="16,6"
                                            Visibility="{Binding CanRevise, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{loc:T 'Výsledok už v knižnici je – spracovať znova ako novú verziu: nová sa zapíše a overí, až potom ide doterajšia do Koša'}" />
                                    <Button Content="{loc:T 'Do fronty'}" Command="{Binding QueueCommand}" Margin="0,0,8,0" Padding="16,6" ToolTip="{loc:T 'Pridá súbor do fronty úloh namiesto okamžitého spracovania'}" />
                                    <!-- owner, 1. 11. 2026: the file to MEGA spracovanie, written later; its original is kept -->
                                    <ComboBox ItemsSource="{Binding Mega.Targets}" SelectedItem="{Binding Mega.Selected}" DisplayMemberPath="Label" MaxWidth="200" Margin="0,0,4,0"
                                              VerticalAlignment="Center" ToolTip="{loc:T 'Do novej dávky MEGA spracovania, alebo doplniť čakajúcu dávku'}" />
                                    <Button Content="{Binding SendToMegaText}" Command="{Binding SendToMegaCommand}" Margin="0,0,8,0" Padding="16,6"
                                            ToolTip="{loc:T 'Súbor sa so všetkými rozhodnutiami zapíše neskôr v MEGA spracovaní (keď dávku spustíte alebo v nastavenom čase); originál ostane'}" />
                                    <Button Content="{loc:T 'Použiť pravidlá'}" Command="{Binding ApplyCommand}" Padding="16,6" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
            <!-- one multiplex settings: source files and tracks on the left, properties on the right, the output below -->
            <DataTemplate DataType="{x:Type pages:MuxSettingsViewModel}">
                <Grid x:Name="SettingsRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="400" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="250" MaxWidth="420" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="104" MinHeight="56" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="96" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{loc:T 'Vymazať všetko'}" Padding="10,3" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ClearSourcesCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                            ToolTip="{loc:T 'Odstráni všetky zdrojové súbory zo Zlučovania (na disku sa nič nezmení)'}" />
                                    <Button Content="{loc:T 'Informácie'}" Padding="10,3" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                            ToolTip="{loc:T 'Zobrazí vybraný zdrojový súbor (alebo súbor vybranej stopy) na stránke Informácie'}" ToolTipService.ShowOnDisabled="True" />
                                    <Button Content="{loc:T 'Odstrániť'}" Command="{Binding RemoveSourceCommand}" Padding="10,3"
                                            ToolTip="{loc:T 'Odstráni vybraný zdrojový súbor (aj jeho stopy), časť alebo pripojený súbor'}" ToolTipService.ShowOnDisabled="True" />
                                </StackPanel>
                                <TextBlock Text="{loc:T 'Zdrojové súbory'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,8,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SourceRows}" SelectedItem="{Binding SelectedSource}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                                <!-- right click (MKVToolNix GUI: the menu of Source files) -->
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T 'Pridať súbory…'}" Command="{Binding AddSourcesCommand}" />
                                        <MenuItem Header="{loc:T 'Pripojiť súbory…'}" Command="{Binding AppendFilesCommand}"
                                                  ToolTip="{loc:T 'Pripojí súbory na koniec vybraného súboru – pokračujú jeho stopami (napr. 2. časť filmu)'}" />
                                        <MenuItem Header="{loc:T 'Pridať súbory ako ďalšie časti…'}" Command="{Binding AddPartsCommand}"
                                                  ToolTip="{loc:T 'Súbory sa prečítajú ako jeden s vybraným súborom (napr. VTS_01_1.VOB, VTS_01_2.VOB)'}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T 'Odstrániť súbor'}" Command="{Binding RemoveSourceCommand}" />
                                        <MenuItem Header="{loc:T 'Odstrániť všetky súbory'}" Command="{Binding RemoveAllSourcesCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T 'Nastaviť názov výstupného súboru podľa vybraného súboru'}" Command="{Binding OutputFromSourceCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T 'Informácie o súbore'}" Command="{Binding SourceInfoCommand}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T 'Vybrať všetky stopy zo súboru'}" Command="{Binding TakeAllTracksOfSourceCommand}"
                                                  ToolTip="{loc:T 'Zaškrtne všetky stopy vybraného súboru'}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{loc:T 'Názov súboru'}" Width="2*" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- parts and appended files indented under their file, each file in its own colour -->
                                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                    <Setter Property="Margin" Value="18,0,0,0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                            Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Normal" />
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:T 'Kontajner'}" Binding="{Binding Container}" Width="100" MinWidth="70" />
                                    <DataGridTextColumn Header="{loc:T 'Veľkosť'}" Binding="{Binding Size}" Width="72" MinWidth="64" />
                                    <DataGridTextColumn Header="{loc:T 'Priečinok'}" Binding="{Binding Directory}" Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Directory}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                          ToolTip="{loc:T 'Ťahaním zmeníte výšku zoznamov'}" />
                            <DockPanel Grid.Row="3" Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <!-- owner, 1. 11. 2026: the languages also here – of the audio from its speech, of the subtitles from their text, with forced -->
                                    <Button Content="{loc:T 'Rozpoznať jazyk zvuku'}" Command="{Binding DetectAudioCommand}" Padding="10,3" Margin="0,0,6,0"
                                            ToolTip="{loc:T 'Vypočuje zvukové stopy bez jazyka (keď ho majú všetky, všetky): rýchly model, čeština × slovenčina presným modelom; jazyk sa zapíše do stopy'}" ToolTipService.ShowOnDisabled="True" />
                                    <Button Content="{loc:T 'Rozpoznať jazyk titulkov a Forced'}" Command="{Binding DetectSubtitlesCommand}" Padding="10,3" Margin="0,0,6,0"
                                            ToolTip="{loc:T 'Jazyk textových titulkov podľa ich textu; forced podľa názvu stopy alebo súboru a podľa počtu titulkov oproti najplnšej stope'}" ToolTipService.ShowOnDisabled="True" />
                                    <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopRecognitionCommand}" Padding="10,3" Margin="0,0,6,0"
                                            Visibility="{Binding IsRecognising, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{loc:T 'Pravidlá UNIVERSUM'}" Command="{Binding ApplyRulesCommand}" Padding="10,3" Margin="0,0,6,0"
                                            ToolTip="{loc:T 'Vyplní názvy, jazyky, príznaky a poradie vybraných stôp podľa pravidiel UNIVERSUM'}" ToolTipService.ShowOnDisabled="True" />
                                    <Button Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Command="{Binding MoveUpCommand}" Padding="9,5" Margin="0,0,4,0" ToolTip="{loc:T 'Posunúť vyššie (Ctrl+↑)'}" />
                                    <Button Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Command="{Binding MoveDownCommand}" Padding="9,5" ToolTip="{loc:T 'Posunúť nižšie (Ctrl+↓)'}" />
                                </StackPanel>
                                <TextBlock Text="{loc:T 'Stopy vo výstupe'}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           ToolTip="{loc:T 'V poradí, v akom budú vo výstupnom súbore; nezaškrtnuté stopy sa nevezmú'}" />
                                <StackPanel VerticalAlignment="Center" Margin="12,0,8,0" Visibility="{Binding IsRecognising, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar Height="4" Maximum="1" Value="{Binding RecognitionProgress, Mode=OneWay}" />
                                    <TextBlock Text="{Binding RecognitionText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid Grid.Row="4" ItemsSource="{Binding TrackRows}" SelectedItem="{Binding SelectedTrackItem}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                                      AllowDrop="True" DragOver="OnMuxTrackDragOver" Drop="OnMuxTrackDrop">
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Up" Modifiers="Control" Command="{Binding MoveUpCommand}" />
                                    <KeyBinding Key="Down" Modifiers="Control" Command="{Binding MoveDownCommand}" />
                                </DataGrid.InputBindings>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="Background" Value="{Binding Kind, Converter={StaticResource TrackTypeBrush}}" />
                                        <Style.Triggers>
                                            <!-- the tracks of an appended file: under the track they continue, not editable -->
                                            <DataTrigger Binding="{Binding IsMain}" Value="False">
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Setter Property="ToolTip" Value="{Binding Explanation}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- owner, 1. 11. 2026: moved by hand as in Hromadné spracovanie – the grip dragged (within the type) or the arrows -->
                                    <DataGridTemplateColumn Header="{loc:T 'Poradie'}" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsMain, Converter={StaticResource BoolToVisibility}}">
                                                    <Border Background="Transparent" Cursor="SizeAll" Padding="3,2" ToolTip="{loc:T 'Chyťte a potiahnite stopu hore alebo dole (v rámci zvukov alebo titulkov)'}"
                                                            PreviewMouseLeftButtonDown="OnMuxGripDown" MouseMove="OnMuxGripMove">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="14" />
                                                    </Border>
                                                    <Button Command="{Binding DataContext.MoveRowUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                            Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="{loc:T 'Posunúť stopu hore'}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding DataContext.MoveRowDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                            Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="{loc:T 'Posunúť stopu dole'}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:T 'Vziať'}" Width="84" MinWidth="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Margin="0,0,2,0"
                                                              IsEnabled="{Binding IsMain}" ToolTip="{loc:T 'Vziať túto stopu do výstupu'}" />
                                                    <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="{Binding Source}"
                                                            Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                                    <TextBlock Text="{Binding Position}" VerticalAlignment="Center" ToolTip="{loc:T 'Poradie vo výstupe'}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:T 'Typ'}" Width="78" MinWidth="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                                    <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:T 'Kodek'}" Binding="{Binding Codec}" Width="86" MinWidth="60">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Codec}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{loc:T 'Jazyk'}" Binding="{Binding Language.Display}" Width="110" MinWidth="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{loc:T 'Názov'}" Binding="{Binding Name}" Width="*" MinWidth="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Header="{loc:T 'Default'}" Binding="{Binding IsDefault, Mode=OneWay}" Width="66" MinWidth="66" />
                                    <DataGridCheckBoxColumn Header="{loc:T 'Forced'}" Binding="{Binding IsForced, Mode=OneWay}" Width="64" MinWidth="64" />
                                    <DataGridTextColumn Header="{loc:T 'Ďalšie'}" Binding="{Binding FlagMarks}" Width="0.6*" MinWidth="56">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding FlagMarks}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- what the rules would still change, on one line (all in the tooltip) -->
                            <DockPanel Grid.Row="5" Margin="0,4,0,0" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding FindingsText}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ItemsControl ItemsSource="{Binding Findings}" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DockPanel>
                        </Grid>
                        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext" ToolTip="{loc:T 'Ťahaním zmeníte šírku panelov'}" />
                        <!-- Properties: of the selected track or source file; below them the output's title, chapters and attachments -->
                        <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Vlastnosti'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource Hint}" Visibility="{Binding ShowsNothing, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap"
                                               Text="{loc:T 'Vyberte stopu alebo zdrojový súbor – jeho vlastnosti sa zobrazia tu.'}" />
                                    <StackPanel DataContext="{Binding SelectedTrack}" Visibility="{Binding DataContext.ShowsTrack, ElementName=SettingsRoot, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                            </Border>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}">
                                                <Run Text="{Binding Codec, Mode=OneWay}" /> <Run Text="{Binding Properties, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <CheckBox Content="{loc:T 'Vziať túto stopu do výstupu'}" IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                        <TextBlock Text="{loc:T 'Názov stopy'}" Margin="0,2,0,2" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{loc:T 'Jazyk'}" Margin="0,8,0,2" />
                                        <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Display" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{loc:T 'Príznaky'}" Margin="0,10,0,2" FontWeight="SemiBold" />
                                        <CheckBox Content="{loc:T 'Predvolená stopa (Default)'}" IsChecked="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Content="{loc:T 'Zapnutá (Enabled)'}" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Content="{loc:T 'Vynútené zobrazenie (Forced)'}" IsChecked="{Binding IsForced, UpdateSourceTrigger=PropertyChanged}" />
                                        <!-- owner, 1. 11. 2026: WebVTT, ASS … written as SRT inside the result, only when ticked -->
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding CanConvertToSrt, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox Content="{loc:T 'Previesť na SRT'}" IsChecked="{Binding ToSrt, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="{loc:T 'Titulky sa vo výsledku zapíšu ako SRT; stopa pôvodného formátu v ňom nebude (originál sa nemení)'}" />
                                            <TextBlock Text="{Binding ToSrtHint}" Style="{StaticResource Hint}" FontSize="11" Margin="26,0,0,0" />
                                        </StackPanel>
                                        <Expander Header="{loc:T 'Ďalšie príznaky a rozšírené vlastnosti'}" Margin="0,8,0,0"
                                                  IsExpanded="{Binding DataContext.ShowAdvanced, ElementName=SettingsRoot}">
                                            <StackPanel Margin="0,6,0,0">
                                                <CheckBox Content="{loc:T 'Pre nepočujúcich (SDH)'}" IsChecked="{Binding IsHearingImpaired, UpdateSourceTrigger=PropertyChanged}" />
                                                <CheckBox Content="{loc:T 'Pre nevidiacich (audio popis)'}" IsChecked="{Binding IsVisualImpaired, UpdateSourceTrigger=PropertyChanged}" />
                                                <CheckBox Content="{loc:T 'Popis deja textom'}" IsChecked="{Binding IsTextDescriptions, UpdateSourceTrigger=PropertyChanged}" />
                                                <CheckBox Content="{loc:T 'Pôvodný jazyk diela'}" IsChecked="{Binding IsOriginal, UpdateSourceTrigger=PropertyChanged}" />
                                                <CheckBox Content="{loc:T 'Komentár'}" IsChecked="{Binding IsCommentary, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{loc:T 'Oneskorenie (ms, záporné = skôr)'}" Margin="0,10,0,2" />
                                                <TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{loc:T 'Predvolené trvanie / FPS (napr. 25p, 24000/1001p)'}" Margin="0,8,0,2" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding DefaultDuration, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{loc:T 'Kompresia'}" Margin="0,8,0,2" />
                                                <ComboBox ItemsSource="{Binding CompressionChoices}" SelectedItem="{Binding Compression}" DisplayMemberPath="Text" HorizontalAlignment="Stretch" />
                                                <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                    <CheckBox Content="{loc:T 'Opraviť časové údaje bitstreamu'}" IsChecked="{Binding FixBitstreamTiming, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                                    <TextBlock Text="{loc:T 'Pomer strán obrazu (napr. 16/9)'}" Margin="0,8,0,2" />
                                                    <TextBox Text="{Binding AspectRatio, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="{loc:T 'Orez v pixeloch (vľavo,hore,vpravo,dole)'}" Margin="0,8,0,2" TextWrapping="Wrap" />
                                                    <TextBox Text="{Binding Cropping, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding IsTextSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{loc:T 'Kódovanie znakov titulkov'}" Margin="0,8,0,2" />
                                                    <ComboBox IsEditable="True" Text="{Binding SubtitleCharset, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"
                                                              ToolTip="{loc:T 'Prázdne = podľa súboru; pre staré české a slovenské titulky zvyčajne cp1250'}">
                                                        <ComboBoxItem Content="cp1250" />
                                                        <ComboBoxItem Content="iso-8859-2" />
                                                        <ComboBoxItem Content="utf-8" />
                                                        <ComboBoxItem Content="cp1252" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap">
                                            <Run Text="{loc:T 'Zo súboru'}" /> <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="{loc:T ', ID stopy'}" /> <Run Text="{Binding Track.Id, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- a track of an appended file: what it continues; the main track is the one edited -->
                                    <StackPanel DataContext="{Binding SelectedAppendedTrack}" Visibility="{Binding DataContext.ShowsAppendedTrack, ElementName=SettingsRoot, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                            </Border>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Codec, Mode=OneWay}" /> <Run Text="{Binding Properties, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                            <TextBlock Text="{loc:T 'Pripojená časť'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                        <Button Content="{loc:T 'Upraviť hlavnú stopu'}" Command="{Binding DataContext.SelectMainTrackCommand, ElementName=SettingsRoot}" HorizontalAlignment="Left" Padding="10,3" />
                                    </StackPanel>
                                    <StackPanel DataContext="{Binding SelectedSource}" Visibility="{Binding DataContext.ShowsSource, ElementName=SettingsRoot, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding Role, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Container, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Input.Details}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                        <TextBlock Text="{loc:T 'Zo súboru vziať aj'}" FontWeight="SemiBold" Margin="0,4,0,2" />
                                        <CheckBox Content="{loc:T 'Kapitoly'}" IsChecked="{Binding Input.KeepChapters, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Input.HasChapters}" />
                                        <CheckBox Content="{loc:T 'Prílohy (písma, obrázky)'}" IsChecked="{Binding Input.KeepAttachments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Input.HasAttachments}" />
                                        <CheckBox Content="{loc:T 'Tagy'}" IsChecked="{Binding Input.KeepTags, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Input.HasTags}" />
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="{loc:T 'Pripojený súbor pokračuje stopami súboru, ku ktorému patrí (názvy, jazyky a príznaky má od neho); ďalšie časti sa čítajú ako jeden súbor. Pravým tlačidlom na súbore otvoríte ďalšie možnosti.'}" />
                                    </StackPanel>
                                    <Separator Margin="0,12,0,4" />
                                    <Expander Header="{loc:T 'Výstup: názov, kapitoly, prílohy'}">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="{loc:T 'Názov (title) výstupného súboru'}" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{loc:T 'Kapitoly zo súboru (XML, OGM .txt, cue)'}" Margin="0,8,0,2" TextWrapping="Wrap" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClearChaptersCommand}" Padding="8,3" Margin="4,0,0,0" ToolTip="{loc:T 'Bez súboru s kapitolami'}" />
                                                <Button DockPanel.Dock="Right" Content="{loc:T 'Vybrať…'}" Command="{Binding ChooseChaptersCommand}" Padding="8,3" Margin="4,0,0,0" />
                                                <TextBox Text="{Binding ChaptersFile, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{loc:T 'Pridajú sa ku kapitolám zo zdrojov, pri ktorých sú zaškrtnuté'}" />
                                            </DockPanel>
                                            <TextBlock Text="{loc:T 'Nové prílohy (písma, obrázky)'}" Margin="0,8,0,2" />
                                            <ListBox ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}" MaxHeight="80" MinHeight="28" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="{loc:T 'Pridať…'}" Command="{Binding AddAttachmentCommand}" Padding="10,3" Margin="0,0,6,0" />
                                                <Button Content="{loc:T 'Odstrániť'}" Command="{Binding RemoveAttachmentCommand}" Padding="10,3" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <!-- the output: title (TMDB), name by the rules, beside the source or in the library -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <WrapPanel DataContext="{Binding Library}">
                            <RadioButton Content="{loc:T 'film'}" IsChecked="{Binding IsMovie}" GroupName="muxKind" VerticalAlignment="Center" Margin="0,0,10,4" MinWidth="0" />
                            <RadioButton Content="{loc:T 'seriál'}" IsChecked="{Binding IsSeries}" GroupName="muxKind" VerticalAlignment="Center" Margin="0,0,16,4" MinWidth="0" />
                            <TextBlock Text="{loc:T 'Titul:'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,4" />
                            <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,6,4"
                                     ToolTip="{loc:T 'Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj adresa TMDB (/movie/ = film, /tv/ = seriál)'}" />
                            <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,4" />
                            <ContentControl Content="{Binding Tray}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,12,4"
                                      IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{loc:T 'Potvrdiť titul'}" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                    Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="{loc:T 'Doplnok:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" Width="130" VerticalAlignment="Center"
                                          ToolTip="{loc:T 'Doplnok k názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie.'}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}" Margin="0,0,12,4">
                                <TextBlock Text="{loc:T 'Epizóda:'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="{loc:T 'napr. S01E04 (špeciály S00E01)'}" />
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" TextWrapping="NoWrap" Margin="0,0,0,4">
                                <Run Text="{Binding Tmdb.Message, Mode=OneWay}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" />
                            </TextBlock>
                        </WrapPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{loc:T 'Výstupný súbor:'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{loc:T 'Vybrať…'}" Command="{Binding ChooseOutputCommand}" Padding="10,3" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="{loc:T 'Vybrať priečinok a meno výstupného súboru'}" />
                                <CheckBox Content="{loc:T 'Do knižnice'}" IsChecked="{Binding UseLibrary}" IsEnabled="{Binding CanUseLibrary}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="0"
                                          ToolTip="{loc:T 'Výsledok pôjde do knižnice (MOVIES / TVSHOWS) s názvom podľa pravidiel; cesta sa potom nedá upravovať.'}" ToolTipService.ShowOnDisabled="True" />
                                <Button Content="{loc:T 'Knižnica…'}" Command="{Binding Library.ChooseOutputDirectoryCommand}" Padding="10,3" Margin="4,0,0,0" ToolTip="{Binding Library.OutputDescription}" />
                                <Button Content="{loc:T 'Resetovať'}" Command="{Binding ResetOutputCommand}" Padding="10,3" Margin="6,0,0,0"
                                        ToolTip="{loc:T 'Späť na predvolený výstup: vedľa prvého zdroja, s názvom podľa pravidiel, ak je zadaný titul'}" />
                            </StackPanel>
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OutputEditable}" ToolTip="{Binding OutputPath}" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ProgressBar Width="140" Height="6" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding OutputNote}" Style="{StaticResource Hint}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <!-- owner, 7. 11. 2026: Ponechať MP4 – one MP4 whose header only changes stays MP4 -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMp4, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox Content="{loc:T 'MP4 ponechať ako MP4'}" IsChecked="{Binding KeepMp4}" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="0"
                                              ToolTip="{loc:T 'Jedno MP4 so všetkými zvukmi, ktorému sa mení len hlavička (jazyky, názvy, predvolené stopy, Forced, titulky pre nepočujúcich, komentár, poradie, názov; vynechané titulky), sa zapíše ako MP4 – hlavičku upraví UNIVERSUM, obraz a zvuk sa nedotknú. Pri zlučovaní viacerých súborov, vynechaní zvuku, kapitolách alebo vlastnostiach stopy vznikne MKV. Náhľad je vždy MKV.'}" />
                                    <TextBlock Text="{Binding Mp4Note}" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Mp4Note}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Problems}" />
                                <TextBlock Text="{Binding Result}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Result}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- owner, 1. 11. 2026: a preview first (UNIVERSUM's folder of previews, never the output), then the final result to MEGA -->
                        <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="6" Background="#144A7BD9" BorderThickness="1" BorderBrush="#334A7BD9">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ComboBox ItemsSource="{Binding Mega.Targets}" SelectedItem="{Binding Mega.Selected}" DisplayMemberPath="Label" MaxWidth="200" Margin="0,0,4,0"
                                              ToolTip="{loc:T 'Do novej dávky MEGA spracovania, alebo doplniť čakajúcu dávku'}" />
                                    <Button Content="{loc:T 'Odoslať do MEGA'}" Command="{Binding SendToMegaCommand}" Padding="12,4" FontWeight="SemiBold"
                                            ToolTip="{loc:T 'Výsledok (celý, nie náhľad) sa zapíše neskôr v MEGA spracovaní – keď dávku spustíte alebo v nastavenom čase. Zdrojové súbory ostanú.'}" />
                                </StackPanel>
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="{loc:T 'Náhľad:'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding Source={x:Static pages:MuxSettingsViewModel.PreviewRanges}}" SelectedItem="{Binding PreviewRange}" Width="270" Margin="0,0,6,2" />
                                        <Button Content="{loc:T 'Vytvoriť náhľad'}" Command="{Binding PreviewCommand}" Padding="10,3" Margin="0,0,6,2"
                                                ToolTip="{loc:T 'Zapíše výsledok do priečinka náhľadov UNIVERSUM (nie do výstupného priečinka) – úseky sú hotové za chvíľu, celý film trvá ako zlučovanie'}" />
                                        <Button Content="{loc:T 'Zastaviť'}" Command="{Binding CancelPreviewCommand}" Padding="10,3" Margin="0,0,6,2"
                                                Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}" />
                                        <ProgressBar Width="120" Height="6" Maximum="1" Value="{Binding PreviewProgress, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,2"
                                                     Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{loc:T 'Prehrať náhľad'}" Command="{Binding PlayPreviewCommand}" Padding="10,3" Margin="0,0,6,2"
                                                ToolTip="{loc:T 'V prehrávači UNIVERSUM so zvukmi a titulkami výsledku'}" />
                                        <Button Content="{loc:T 'V inom prehrávači'}" Command="{Binding OpenPreviewCommand}" Padding="10,3" Margin="0,0,6,2"
                                                ToolTip="{loc:T 'Otvorí náhľad v prehrávači, ktorý má Windows pre MKV'}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding PreviewText}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:T 'Nastavenia sa od náhľadu zmenili – vytvorte nový náhľad.'}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding PreviewIsOld, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type pages:SubtitlesPageViewModel}">
                <!-- owner, 30. 10. 2026: Úprava titulkostopy – the film plays with the subtitles being edited, other subtitles to compare -->
                <Grid Margin="24,16,24,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{loc:T 'Vyčistiť'}" Command="{Binding ClearCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="{loc:T 'Zabudne otvorené video a titulky – na disku sa nič nezmení'}" />
                            <Button Content="{loc:T 'Otvoriť video…'}" Command="{Binding OpenVideoCommand}" Padding="16,6" Margin="0,0,8,0" />
                            <Button Content="{loc:T 'Otvoriť titulky…'}" Command="{Binding OpenSubtitlesCommand}" Padding="16,6"
                                    ToolTip="{loc:T 'Súbory titulkov (SRT, ASS/SSA, WebVTT, TTML, SAMI, SubViewer, MicroDVD, MPL2, TMPlayer) – uložia sa ako nové SRT'}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Úprava titulkostopy'}" />
                                <ContentControl Content="{Binding DataContext.TrayService, RelativeSource={RelativeSource AncestorType=Window}}" ContentTemplate="{DynamicResource TrayAutoSwitch}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="16,0,0,4" />
                            </StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="420" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="430" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.2*" MinHeight="200" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="150" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                    <WrapPanel>
                                        <CheckBox Content="{loc:T 'Porovnať s:'}" IsChecked="{Binding Compare}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  ToolTip="{loc:T 'Iné titulky hore na obraze (žlté), so svojimi zmenami'}" />
                                        <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding CompareRow}" Width="190" Margin="0,0,16,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Language.Display, Mode=OneWay}" /> – <Run Text="{Binding Source, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" DataContext="{Binding SelectedRow}" Margin="0,0,12,0">
                                            <TextBlock Text="{loc:T 'Posun:'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                                            <Button Content="−1000" Command="{Binding DelayStepCommand}" CommandParameter="-1000" Padding="6,2" Margin="0,0,3,0" />
                                            <Button Content="−100" Command="{Binding DelayStepCommand}" CommandParameter="-100" Padding="6,2" Margin="0,0,4,0" />
                                            <TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" Width="70" TextAlignment="Right" />
                                            <TextBlock Text="{loc:T 'ms'}" VerticalAlignment="Center" Margin="3,0,4,0" />
                                            <Button Content="+100" Command="{Binding DelayStepCommand}" CommandParameter="100" Padding="6,2" Margin="0,0,3,0" />
                                            <Button Content="+1000" Command="{Binding DelayStepCommand}" CommandParameter="1000" Padding="6,2" />
                                        </StackPanel>
                                        <Button Content="{loc:T 'Titulok začína teraz'}" Command="{Binding StartsNowCommand}" Padding="10,2" Margin="0,0,6,0"
                                                ToolTip="{loc:T 'Najbližší titulok vybraných titulkov sa posunie tak, aby začínal práve teraz (posun sa zmení o rozdiel)'}" />
                                        <Button Content="{loc:T '1. bod'}" Command="{Binding MarkFirstCommand}" Padding="8,2" Margin="0,0,4,0"
                                                ToolTip="{loc:T 'Synchronizácia podľa dvoch titulkov: najbližší titulok patrí sem (na začiatku filmu)'}" />
                                        <Button Content="{loc:T '2. bod'}" Command="{Binding MarkSecondCommand}" Padding="8,2"
                                                ToolTip="{loc:T '…a druhý titulok ku koncu filmu – vypočíta rýchlosť a posun'}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <player:PlayerView DataContext="{Binding Player}" />
                            </DockPanel>
                            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2,0,2" />
                            <TabControl Grid.Row="2">
                                <TabItem Header="{loc:T 'Stopy titulkov'}">
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Visibility="{Binding HasFound, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:T 'Externé titulky pri videu (podľa názvu, slov názvu a čísla epizódy):'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Found}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2">
                                                                <Button DockPanel.Dock="Left" Content="{loc:T 'Pridať'}" Command="{Binding AddCommand}" Padding="10,2" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
