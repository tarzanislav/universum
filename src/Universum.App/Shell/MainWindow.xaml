                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- what the tools are doing now -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14" BorderBrush="#66A78BE6">
