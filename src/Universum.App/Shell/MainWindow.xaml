                                                <Button Content="{loc:T 'Skontrolovať titulky videa'}" Command="{Binding CheckTracksCommand}" Padding="12,4"
                                                        ToolTip="{loc:T 'Porovná každú titulkovú stopu videa so zvukom: sedí, mešká, ide skôr, iné FPS'}" />
                                            </WrapPanel>
                                            <WrapPanel Margin="0,8,0,0">
                                                <TextBlock Text="{loc:T 'Napasovať vybrané automaticky:'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <CheckBox Content="{loc:T 'podľa zvuku'}" IsChecked="{Binding SyncByAudio}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                          ToolTip="{loc:T 'Kde sa vo filme hovorí – osem častí filmu, aj iné FPS (25 ↔ 23,976 …)'}" />
                                                <CheckBox Content="{loc:T 'podľa titulkov:'}" IsChecked="{Binding SyncBySubtitles}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                          ToolTip="{loc:T 'Iné titulky, ktoré k filmu sedia (aj v inom jazyku)'}" />
                                                <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SyncReference}" Width="200" Margin="0,0,8,0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <Run Text="{Binding Language.Display, Mode=OneWay}" /> – <Run Text="{Binding Source, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Content="{loc:T 'Napasovať'}" Command="{Binding SyncCommand}" Padding="12,4" Margin="0,0,8,0"
                                                        ToolTip="{loc:T 'Nastaví rýchlosť (alebo zmenu FPS) a posun vybraných titulkov, keď je výsledok istý; oboje naraz = istota, keď sa zhodnú'}" />
                                                <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopSyncCommand}" Padding="12,4" Margin="0,0,8,0"
                                                        ToolTip="{loc:T 'Zastaví čítanie zvuku filmu'}" />
                                                <Button Content="{loc:T 'Použiť návrh'}" Command="{Binding ApplyProposalCommand}" Padding="12,4"
                                                        Visibility="{Binding HasProposal, Converter={StaticResource BoolToVisibility}}"
                                                        ToolTip="{loc:T 'Neistý výsledok sa sám nepoužije – nastaví ho až toto tlačidlo; overte ho prehraním'}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{loc:T 'Časy titulkov'}">
