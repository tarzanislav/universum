                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- quick starts -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14" BorderBrush="#66F2C14E">
                    <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2EF2C14E" Offset="0" />
                                <GradientStop Color="#1AF28CB0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Rýchle akcie'}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Command="{Binding AddToMuxCommand}" Margin="0,0,8,8" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T 'Pridať súbory do Zlučovania…'}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BatchFolderCommand}" Margin="0,0,8,8" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T 'Hromadné spracovanie priečinka…'}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SingleFileCommand}" Margin="0,0,8,8" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T 'Single spracovanie súboru…'}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding InfoFileCommand}" Margin="0,0,8,8" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T 'Informácie o súbore…'}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"
                                   Text="{loc:T 'Súbory sa dajú poslať aj z Prieskumníka: pravé tlačidlo → UNIVERSUM (vo Windows 11 pod „Zobraziť ďalšie možnosti“).'}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Nastavenia'}" />
                <TextBlock Style="{StaticResource Hint}" Text="{loc:T 'Knižnica a profil pravidiel UNIVERSUM. Predvolený profil zodpovedá špecifikácii (čeština a slovenčina).'}" Margin="0,0,0,16" />
                <!-- owner, 8. 11. 2026 ("v nastaveniach chaos – prerob"): every disk with its input and output side by side -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel DataContext="{Binding Disks}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{loc:T '+ Pridať disk…'}" Command="{Binding AddInputCommand}" Padding="12,5" VerticalAlignment="Top"
                                        ToolTip="{loc:T 'Vyberte vstupný priečinok (zdroj) na ďalšom disku – výstup mu potom vytvoríte jedným klikom.'}" />
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Priečinky na diskoch'}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="{loc:T 'Každý disk má svoj blok: vstup (sem prichádzajú filmy a epizódy – UNIVERSUM ich len číta) a výstup (knižnica s MOVIES, TVSHOWS a POSTER). Filmy zo vstupu sa zapíšu do výstupu na tom istom disku. V priečinkoch sa nikdy nič nemaže.'}" />
                                </StackPanel>
                            </DockPanel>
                            <!-- owner, 8. 11. 2026 ("jeden orámovaný blok, kde bude všetko o jednom disku", "nápis DISK D: alebo DISK E:"):
                                 a framed block per disk – its input and output one under the other, each with the same button -->
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Free}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="18" FontWeight="Bold">
                                                        <Run Text="{Binding DiskTitle, Mode=OneWay}" />
                                                        <Run Text="{Binding MainCaption, Mode=OneWay}" Foreground="#C08A00" FontSize="14" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{loc:T 'VSTUP (zdroj)'}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding InputText}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Button Grid.Column="2" Content="{loc:T 'Zmeniť…'}" Command="{Binding ChangeInputCommand}" Padding="12,3" MinWidth="110"
                                                            ToolTip="{loc:T 'Iný vstupný priečinok (zdroj) tohto disku'}" />
                                                    <TextBlock Grid.Row="1" Text="{loc:T 'VÝSTUP (knižnica)'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputText}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,10,0" />
                                                    <Grid Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                                        <Button Content="{loc:T 'Zmeniť…'}" Command="{Binding ChangeOutputCommand}" Padding="12,3" MinWidth="110"
                                                                ToolTip="{loc:T 'Iný výstupný priečinok (knižnica) tohto disku'}" Visibility="{Binding NeedsOutput, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <Button Content="{loc:T 'Vytvoriť výstup'}" Command="{Binding CreateOutputCommand}" Padding="12,3" MinWidth="110"
                                                                ToolTip="{Binding SuggestedOutput}" Visibility="{Binding NeedsOutput, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Text="{Binding Flow}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="{loc:T 'Je to zdroj – presunúť do Vstup'}" Command="{Binding OutputToInputCommand}" Padding="10,3" Margin="0,0,6,0"
                                                            Visibility="{Binding OutputLooksLikeSource, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{loc:T 'V tomto výstupe sú filmy mimo MOVIES a TVSHOWS – vyzerá ako zdrojový priečinok. Stane sa vstupom disku; nič sa v ňom nezmení.'}" />
                                                    <Button Content="{loc:T 'Odobrať priečinky navyše'}" Command="{Binding RemoveExtrasCommand}" Padding="10,3" Margin="0,0,6,0"
                                                            Visibility="{Binding HasExtras, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="{loc:T '★ Nastaviť ako hlavný'}" Command="{Binding MakeMainCommand}" Padding="10,3" Margin="0,0,6,0"
                                                            Visibility="{Binding CanMakeMain, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{loc:T 'Výstup tohto disku bude hlavný – pôjdu sem súbory z diskov bez vlastného výstupu.'}" />
                                                    <Button Content="{loc:T 'Odobrať disk'}" Command="{Binding RemoveCommand}" Padding="10,3"
                                                            Visibility="{Binding IsMain, Converter={StaticResource InverseBoolToVisibility}}"
                                                            ToolTip="{loc:T 'Priečinky tohto disku sa prestanú používať – nič v nich sa nezmení ani nezmaže.'}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:T 'Zatiaľ žiadne priečinky – pridajte vstupný a výstupný priečinok.'}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <CheckBox Content="{loc:T 'Súbor zo vstupu zapísať do výstupu na tom istom disku (bez kopírovania)'}" IsChecked="{Binding OutputBySourceDisk}"
                                          ToolTip="{loc:T 'Vypnuté: všetko do hlavného výstupu (★)'}" />
                                <CheckBox Content="{loc:T 'Sledovať vstupné priečinky – upozorniť na nové filmy a epizódy'}" IsChecked="{Binding WatchInput}" Margin="0,6,0,0"
                                          ToolTip="{loc:T 'Keď sa do vstupného priečinka dokopíruje film alebo epizóda, hore sa ukáže upozornenie s tlačidlom Do Hromadného spracovania. Nič sa nespracuje samo.'}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:T 'Na koľkých diskoch naraz:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding ParallelDiskChoices}" SelectedItem="{Binding ParallelDisks}" Width="70"
                                              ToolTip="{loc:T 'Na každom disku vždy len jeden súbor (inak by sa spomaľovali); prekódovanie zvuku a obrazu len jedno naraz a s nižšou prioritou – počítač ostane použiteľný. 1 = jeden súbor po druhom.'}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{loc:T 'Vo vstupe dajte filmy do MOVIES a seriály do TVSHOWS (každý seriál do vlastného priečinka). Filmy idú do MOVIES\\Názov (rok), seriály do TVSHOWS\\Názov (rok)\\Season 01 – podľa pravidiel Jellyfin. MOVIES a TVSHOWS UNIVERSUM nikdy nemaže.'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- owner, 1. 11. 2026: where Zlučovanie writes its previews – never the output folders -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="{loc:T 'Zmeniť…'}" Command="{Binding ChoosePreviewFolderCommand}" Padding="10,3" Margin="6,0,0,0" />
                                <Button Content="{loc:T 'Otvoriť'}" Command="{Binding OpenPreviewFolderCommand}" Padding="10,3" Margin="6,0,0,0" />
                                <Button Content="{loc:T 'Vymazať náhľady'}" Command="{Binding ClearPreviewsCommand}" Padding="10,3" Margin="6,0,0,0"
                                        ToolTip="{loc:T 'Vymaže náhľady Zlučovania v tomto priečinku (len súbory „… – náhľad …“, ktoré vytvoril UNIVERSUM)'}" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{loc:T 'Priečinok náhľadov Zlučovania:'}" FontWeight="SemiBold" /> <Run Text="{Binding PreviewFolder, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding PreviewFolderNote}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Jazyk rozhrania (platí po reštarte)'}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding UiLanguages}" SelectedValue="{Binding UiLanguage}" SelectedValuePath="Code" DisplayMemberPath="Name"
                                  Width="200" HorizontalAlignment="Left" Margin="0,6,0,0"
                                  ToolTip="{loc:T 'Slovenčina / Čeština / English – menu, nadpisy stránok, Nastavenia a tlačidlá; ostatné texty zatiaľ po slovensky'}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Zvukové upozornenie'}" FontWeight="SemiBold" />
                        <CheckBox Content="{loc:T 'Prehrať zvuk, keď sú hotové všetky úlohy (Hromadné spracovanie, Fronta úloh)'}" IsChecked="{Binding FinishSound}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{loc:T 'Zvuky Windows: Hviezdička, keď je všetko hotové; Výkričník, keď niečo zlyhalo. Hlasitosť a zvuky sa menia v nastaveniach zvuku Windows.'}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'TMDB – názvy filmov a seriálov'}" FontWeight="SemiBold" />
