                                <DataGridTemplateColumn Header="Jazyk" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding FileLanguage}" Visibility="{Binding NeedsLanguage, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Center" />
                                                <ComboBox Visibility="{Binding NeedsLanguage, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding LanguageChoices}"
                                                          DisplayMemberPath="SlovakName" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Pôvod" Width="1.2*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="11.5" />
                                                <TextBlock Text="{Binding Suggested}" FontWeight="SemiBold" FontSize="11.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Forced" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Visibility="{Binding IsSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                <CheckBox IsThreeState="True" IsChecked="{Binding Forced, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="zaškrtnuté = forced, prázdne = nie, plné pole = podľa súboru" />
                                                <TextBlock Text="{Binding ForcedHint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="2" Margin="0,10,0,6">
                            <Button DockPanel.Dock="Right" Content="Informácie" Command="{Binding ShowInfoCommand}" Padding="10,3"
                                    ToolTip="Zobrazí vybraný súbor na stránke Informácie" ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Text="Súbory skupiny – výsledok simulácie" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="3" ItemsSource="{Binding FileRows}" SelectedItem="{Binding SelectedFile}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
