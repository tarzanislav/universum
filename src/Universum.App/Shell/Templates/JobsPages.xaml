<!-- UNIVERSUM – Fronta úloh, výstup, spracované tituly, záznamy spracovania, vstupný priečinok (14. 11. 2026, step 2 of the review of the code: the templates of MainWindow.xaml by pages) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:Universum.App.Pages"
                    xmlns:app="clr-namespace:Universum.App"
                    xmlns:jobs="clr-namespace:Universum.App.Jobs"
                    xmlns:loc="clr-namespace:Universum.App.Localization"
                    xmlns:player="clr-namespace:Universum.App.Player">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate DataType="{x:Type jobs:JobQueuePageViewModel}">
        <Grid Margin="32,24,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Fronta úloh'}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding State}" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                <Button Content="{loc:T 'Spustiť'}" Command="{Binding StartCommand}" Padding="14,4" Margin="0,0,8,0" />
                <Button Content="{loc:T 'Zastaviť po aktuálnej'}" Command="{Binding StopCommand}" Padding="12,4" Margin="0,0,16,0" />
                <Button Content="{loc:T 'Zrušiť'}" Command="{Binding CancelCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="{loc:T 'Zruší bežiacu úlohu (originál ostane nezmenený) alebo vyradí čakajúcu'}" />
                <Button Content="{loc:T 'Spustiť znova'}" Command="{Binding RetryCommand}" Padding="12,4" Margin="0,0,8,0" />
                <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="{loc:T 'Čakajúcu úlohu skôr'}" />
                <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" Margin="0,0,16,0" ToolTip="{loc:T 'Čakajúcu úlohu neskôr'}" />
                <Button Content="{loc:T 'Výstup…'}" Command="{Binding OutputCommand}" Padding="12,4" Margin="0,0,8,0" />
                <Button Content="{loc:T 'Vrátiť späť'}" Command="{Binding UndoCommand}" Padding="12,4" Margin="0,0,16,0" ToolTip="{loc:T 'Vráti úpravu hlavičky, ktorú urobila táto úloha'}" />
                <Button Content="{loc:T 'Odstrániť'}" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,8,0" />
                <Button Content="{loc:T 'Vyčistiť dokončené'}" Command="{Binding ClearCommand}" Padding="12,4" />
            </WrapPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                    <DataGridTextColumn Header="{loc:T 'Úloha'}" Binding="{Binding Description}" Width="2*" />
                    <DataGridTemplateColumn Header="{loc:T 'Stav'}" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock x:Name="state" Text="{Binding Status}" />
                                    <ProgressBar Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                        <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="state" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                        <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:T 'Výsledok'}" Binding="{Binding Outcome}" Width="3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Outcome}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{loc:T 'Pridaná'}" Binding="{Binding Added}" />
                    <DataGridTextColumn Header="{loc:T 'Trvanie'}" Binding="{Binding Duration}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <CheckBox Content="{loc:T 'Spustiť frontu hneď po pridaní úlohy'}" IsChecked="{Binding AutoStart}" />
                <CheckBox Content="{loc:T 'Zvukové upozornenie, keď sú hotové všetky úlohy'}" IsChecked="{Binding FinishSound}" Margin="0,4,0,0"
                          ToolTip="{loc:T 'Zvuk Windows: Hviezdička, keď je všetko hotové; Výkričník, keď niečo zlyhalo (aj Hromadné spracovanie)'}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type jobs:JobOutputPageViewModel}">
        <Grid Margin="32,24,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Job}" DisplayMemberPath="Display" Width="360" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Výstup úloh'}" />
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,6,0,10">
                <TextBlock Text="{Binding Job.Description}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:T 'Čas'}" Binding="{Binding Time}" />
                    <DataGridTemplateColumn Header="{loc:T 'Druh'}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="kind" Text="{Binding Severity}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:T 'Správa'}" Binding="{Binding Text}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <!-- Záznamy spracovania (owner, 31. 10. 2026): every run in words; ticked ones or all can be deleted -->
    <!-- owner, 7. 11. 2026: Spracované tituly – the films and series written into the libraries, export and import -->
    <DataTemplate DataType="{x:Type pages:ProcessedTitlesPageViewModel}">
        <Grid Margin="32,24,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button Content="{loc:T 'Načítať z knižnice'}" Command="{Binding ScanCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="{loc:T 'Doplní filmy a seriály, ktoré už sú vo výstupných priečinkoch (MOVIES, TVSHOWS) – aj tie spracované skôr'}" />
                    <Button Content="{loc:T 'Exportovať…'}" Command="{Binding ExportCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="{loc:T 'JSON na neskorší import alebo CSV pre Excel'}" />
                    <Button Content="{loc:T 'Importovať…'}" Command="{Binding ImportCommand}" Padding="12,4"
                            ToolTip="{loc:T 'Spojí exportovaný zoznam s týmto – nič sa neprepíše, epizódy sa doplnia'}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Spracované tituly'}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,10" />
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="{loc:T 'Hľadať:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                <ComboBox ItemsSource="{Binding KindChoices}" SelectedIndex="{Binding KindFilter}" Width="130" />
            </WrapPanel>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Titles}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:T 'Titul'}" Binding="{Binding Display, Mode=OneWay}" Width="*" />
                    <DataGridTextColumn Header="{loc:T 'Druh'}" Binding="{Binding Kind, Mode=OneWay}" Width="80" />
                    <DataGridTextColumn Header="{loc:T 'Český názov'}" Binding="{Binding CzechName, Mode=OneWay}" Width="180" />
                    <DataGridTextColumn Header="{loc:T 'Anglický názov'}" Binding="{Binding EnglishName, Mode=OneWay}" Width="180" />
                    <DataGridTextColumn Header="{loc:T 'Známe aj ako'}" Binding="{Binding Names, Mode=OneWay}" Width="200" />
                    <DataGridTextColumn Header="{loc:T 'Epizódy'}" Binding="{Binding Episodes, Mode=OneWay}" Width="260" />
                    <DataGridTextColumn Header="{loc:T 'Súbory'}" Binding="{Binding Files, Mode=OneWay}" Width="70" />
                    <DataGridTextColumn Header="{loc:T 'Naposledy'}" Binding="{Binding Last, Mode=OneWay}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type jobs:ProcessingLogsPageViewModel}">
        <Grid Margin="32,24,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button Content="{loc:T 'Zmazať označené'}" Command="{Binding DeleteCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="{loc:T 'Zmaže zaškrtnuté záznamy (alebo vybraný, keď nie je nič zaškrtnuté) – filmy sa nemenia'}" />
                    <Button Content="{loc:T 'Zmazať všetky'}" Command="{Binding DeleteAllCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="{loc:T 'Priečinok záznamov'}" Command="{Binding OpenFolderCommand}" Padding="12,4" />
                </WrapPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Záznamy spracovania'}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,10" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox ItemsSource="{Binding Logs}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="{loc:T 'Označiť na zmazanie'}" />
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding When, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Kind, Mode=OneWay}" /></TextBlock>
                                    <TextBlock x:Name="summary" Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                    <Setter TargetName="summary" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="summary" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="{loc:T 'len súbory s problémom'}" IsChecked="{Binding OnlyProblems}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="headline" Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,4" />
                                            <ItemsControl ItemsSource="{Binding Problems}" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <TextBlock TextWrapping="Wrap"><Run Text="{loc:T 'Čo sa stalo: '}" FontWeight="SemiBold" /><Run Text="{Binding What, Mode=OneWay}" /></TextBlock>
                                                            <TextBlock TextWrapping="Wrap"><Run Text="{loc:T 'Čo s tým: '}" FontWeight="SemiBold" /><Run Text="{Binding Advice, Mode=OneWay}" /></TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{loc:T 'Čo sa urobilo:'}" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Done}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="8,1,0,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Right" Content="{loc:T 'Ukázať'}" Command="{Binding OpenCommand}" CommandParameter="{Binding File.Source}" Padding="8,1" Margin="8,0,0,0"
                                                        ToolTip="{loc:T 'Otvorí priečinok s originálom v Prieskumníkovi'}" />
                                                <TextBlock Text="{Binding Source}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                                <Button DockPanel.Dock="Right" Content="{loc:T 'Ukázať'}" Command="{Binding OpenCommand}" CommandParameter="{Binding File.Result}" Padding="8,1" Margin="8,0,0,0"
                                                        ToolTip="{loc:T 'Otvorí priečinok s výsledkom v Prieskumníkovi'}" />
                                                <TextBlock Text="{Binding Result}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Expander Header="{loc:T 'Technické podrobnosti (výstup nástrojov)'}" Margin="0,4,0,0" Visibility="{Binding HasTechnical, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" BorderThickness="0" Margin="0,4,0,0" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter TargetName="headline" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="headline" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </DataTemplate>
    <!-- the input folder, the same on every page that shows it -->
    <DataTemplate DataType="{x:Type pages:InputFolderViewModel}">
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:T 'Zmeniť…'}" Command="{Binding ChooseCommand}" Padding="10,3" Margin="8,0,6,0" />
                    <Button Content="{loc:T 'Otvoriť'}" Command="{Binding OpenCommand}" Padding="10,3" ToolTip="{loc:T 'Otvoriť v Prieskumníkovi'}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}">
                        <Run Text="{loc:T 'Vstupný priečinok: '}" FontWeight="SemiBold" /><Run Text="{Binding Display, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SortingHint}" Style="{StaticResource Hint}" FontSize="11.5" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
