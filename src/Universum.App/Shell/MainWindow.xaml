<Window x:Class="Universum.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Universum.App.Pages"
        xmlns:jobs="clr-namespace:Universum.App.Jobs"
        Title="UNIVERSUM" Icon="pack://application:,,,/Assets/universum.ico" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <!-- owner, 29. 10. 2026: a chosen row of any table stays readable – a light blue with dark text, never the theme's
             dark selection (the tables of Premiéry and Novinky have their own) -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE3F8" />
                    <Setter Property="BorderBrush" Value="#CFE3F8" />
                    <Setter Property="Foreground" Value="#141414" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- the tables of Premiéry and Novinky: sharp text, links right after the title, optional posters, Vybrané and a note -->
        <Style x:Key="NewsCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="NewsSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NewsLink" TargetType="Button">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NewsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="MinRowHeight" Value="40" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Language" Value="sk-SK" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="CellStyle">
                <Setter.Value>
                    <!-- a chosen row stays readable: the tab's pastel colour, never the dark selection of the theme -->
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NewsHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <!-- today's rows tinted and bold; a chosen title gets a stripe of the tab's colour on the left -->
        <Style x:Key="NewsRowBase" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.SelectedTab.Tint, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="NewsTitleCell">
            <DockPanel Margin="6,4">
                <Border DockPanel.Dock="Left" CornerRadius="4" Margin="0,0,10,0" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Width="{Binding DataContext.PosterWidth, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue=38}"
                        Height="{Binding DataContext.PosterHeight, RelativeSource={RelativeSource AncestorType=DataGrid}, FallbackValue=57}"
                        Visibility="{Binding DataContext.ShowPosters, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="4">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Poster.Image}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" VerticalAlignment="Center" ToolTip="{Binding Caption}">
                            <Hyperlink Command="{Binding OpenTmdbCommand}"><Run Text="{Binding Caption, Mode=OneWay}" /></Hyperlink>
                        </TextBlock>
                        <Button Content="TMDB" Command="{Binding OpenTmdbCommand}" Style="{StaticResource NewsLink}" ToolTip="Otvoriť na TMDB" />
                        <Button Content="HISTRA" Command="{Binding OpenHistraCommand}" Style="{StaticResource NewsLink}" ToolTip="Otvoriť na HISTRA" />
                        <Button Content="Zdroj" Command="{Binding OpenSourceCommand}" Style="{StaticResource NewsLink}" ToolTip="Otvoriť v zdroji"
                                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding LocalTitle}" Style="{StaticResource NewsSubtitle}" />
                    <TextBlock Text="{Binding Rhythm, FallbackValue=''}" Style="{StaticResource NewsSubtitle}" FontWeight="SemiBold"
                               Foreground="{Binding DataContext.SelectedTab.Accent, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <TextBlock Text="{Binding Streaming, FallbackValue=''}" Style="{StaticResource NewsSubtitle}" FontWeight="SemiBold" Foreground="#2F9461"
                               ToolTip="Kde sa dá titul legálne pozerať (SK, CZ) – údaje JustWatch cez TMDB" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="NewsChosenCell">
            <CheckBox IsChecked="{Binding IsChosen, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                      ToolTip="Vybrané – titul, na ktorý sa teším (zobrazíte ich voľbou Zobraziť vybrané)" />
        </DataTemplate>
        <!-- a note: its text, and its links as words beside it (the address hides in the word; owner, 29. 10. 2026) -->
        <DataTemplate x:Key="NewsNoteCell">
            <DockPanel Margin="4,3" VerticalAlignment="Center">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Links}" VerticalAlignment="Center" MaxWidth="240" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,1,2,1" Margin="4,1,0,1" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    ToolTip="{Binding ToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                        <Hyperlink Command="{Binding OpenCommand}"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                                    </TextBlock>
                                    <Button Content="×" Command="{Binding RemoveCommand}" Padding="5,0" MinWidth="0" MinHeight="0" Margin="3,0,0,0"
                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip="Odstrániť odkaz z poznámky" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=LostFocus}" MinHeight="30" MinWidth="60" TextWrapping="Wrap" pages:NoteLinks.AskName="True"
                         ToolTip="Poznámka k titulu – uloží sa, keď pole opustíte. Vložená webová adresa sa zmení na slovo-odkaz vedľa poznámky." />
            </DockPanel>
        </DataTemplate>
        <!-- MEGA spracovanie (owner, 29. 10. 2026): batches written later, each with its start -->
        <DataTemplate DataType="{x:Type pages:MegaPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="150" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="MEGA spracovanie" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button Content="Spustiť teraz" Command="{Binding StartCommand}" Padding="14,4" Margin="0,0,8,0" ToolTip="Pridá vybranú dávku do Fronty úloh a spustí ju" />
                    <Button Content="Upraviť v Hromadnom spracovaní" Command="{Binding EditCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="Otvorí dávku so všetkými rozhodnutiami v Hromadnom spracovaní – opravíte ju a dáte Uložiť do dávky" />
                    <Button Content="Znova preskočené a chybné" Command="{Binding RetryCommand}" Padding="12,4" Margin="0,0,16,0"
                            ToolTip="Súbory dokončenej dávky, ktoré sa preskočili, nepodarili alebo zrušili, sa znova skontrolujú a zapíšu" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="Dávku vyššie (poradie pre „po predchádzajúcej dávke“)" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" Margin="0,0,16,0" ToolTip="Dávku nižšie" />
                    <Button Content="Odstrániť dávku" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="Súbory sa nemenia; nezapísané sa v Hromadnom spracovaní znova ukážu ako voľné" />
                    <Button Content="Vyčistiť dokončené" Command="{Binding ClearFinishedCommand}" Padding="12,4" />
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dávka" Binding="{Binding Label}" />
                        <DataGridTextColumn Header="Čo obsahuje" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Súbory" Binding="{Binding Count}" Width="Auto" />
                        <DataGridTemplateColumn Header="Spustiť" Width="Auto" MinWidth="330">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSchedule}">
                                        <ComboBox ItemsSource="{Binding StartChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                  SelectedValue="{Binding Start, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" FontSize="12" />
                                        <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" FontSize="12" Width="120"
                                                    Visibility="{Binding IsAt, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBox Text="{Binding Time, UpdateSourceTrigger=LostFocus}" Margin="6,0,0,0" Width="56" FontSize="12" VerticalContentAlignment="Center"
                                                 Visibility="{Binding IsAt, Converter={StaticResource BoolToVisibility}}" ToolTip="Čas spustenia, napr. 2:00" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="*" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="3" Margin="0,12,0,6">
                    <Button DockPanel.Dock="Right" Content="Vybrať súbor z dávky" Command="{Binding RemoveFileCommand}" Padding="12,4"
                            ToolTip="Súbor sa nemení; v Hromadnom spracovaní sa znova ukáže ako voľný" />
                    <TextBlock Text="Súbory vybranej dávky" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid Grid.Row="4" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Súbor" Binding="{Binding Name}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Folder}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cieľ v knižnici" Binding="{Binding Target}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Target}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="Auto" MinWidth="90" />
                        <DataGridTextColumn Header="Poznámka" Binding="{Binding Note}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:PlaceholderPageViewModel}">
            <StackPanel Margin="32">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" MaxWidth="640" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{Binding Stage, StringFormat='Pripravuje sa – {0}.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pages:InfoPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- the files of the multiplexer and the batch: one click shows each -->
                <Border Width="280" Margin="0,0,16,0" Style="{StaticResource Card}" Padding="8"
                        Visibility="{Binding HasKnownFiles, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Súbory v práci" FontWeight="SemiBold" Margin="4,0,0,2" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12" Margin="4,0,0,6" TextWrapping="Wrap"
                                   Text="Zo Zlučovania a z Hromadného spracovania – kliknutím zobrazíte informácie." />
                        <ListBox ItemsSource="{Binding KnownFiles}" SelectedItem="{Binding SelectedKnown}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding Path}" Margin="0,1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                        <TextBlock Style="{StaticResource PageTitle}" Text="Informácie o súbore" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{Binding FileName}" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="2" Margin="0,4,0,12">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="{Binding Kind, Converter={StaticResource TrackTypeBrush}}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTemplateColumn Header="Typ" Width="74" SortMemberPath="Type">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                            <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" />
                            <DataGridTextColumn Header="Jazyk" Binding="{Binding Language}" />
                            <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="*" />
                            <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="Forced" Binding="{Binding IsForced, Mode=OneWay}" />
                            <DataGridTextColumn Header="Ďalšie príznaky" Binding="{Binding FlagMarks}" />
                            <DataGridTextColumn Header="Vlastnosti" Binding="{Binding Properties}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:RulesPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Vymazať frontu" Command="{Binding ClearCommand}" Padding="12,6" Margin="8,0,0,0"
                            ToolTip="Zabudne otvorený, ešte nespracovaný súbor (na disku sa nič nezmení)" />
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Single spracovanie" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <TextBlock Text="{Binding Issues}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
                <!-- owner, 29. 10. 2026: the tracks in the order of the result; dragged by the grip (or the arrows) within their type -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False"
                          AllowDrop="True" DragOver="OnRuleDragOver" Drop="OnRuleDrop">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="{Binding Type, Converter={StaticResource TrackTypeBrush}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRemovedByLanguage}" Value="True">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Poradie" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanMove, Converter={StaticResource BoolToVisibility}}">
                                        <Border Background="Transparent" Cursor="SizeAll" Padding="3,2" ToolTip="Chyťte a potiahnite stopu hore alebo dole (v rámci zvukov alebo titulkov)"
                                                PreviewMouseLeftButtonDown="OnRuleGripDown" MouseMove="OnRuleGripMove">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="14" />
                                        </Border>
                                        <Button Command="{Binding MoveUpCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu hore">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10" />
                                        </Button>
                                        <Button Command="{Binding MoveDownCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu dole">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding PositionText}" />
                        <DataGridTemplateColumn Header="Typ" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TypeChip}" Background="{Binding Type, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                        <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Codec}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Jazyk (pred → po)" Width="175">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- owner, 29. 10. 2026: also a language written in the file can be corrected ("EN" that is Czech) -->
                                    <StackPanel>
                                        <TextBlock Text="{Binding LanguageBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding LanguageAfter}" FontWeight="SemiBold" Visibility="{Binding CanChooseLanguage, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ComboBox Visibility="{Binding CanChooseLanguage, Converter={StaticResource BoolToVisibility}}"
                                                  ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="SlovakName" MinWidth="160" ToolTip="Jazyk stopy – neurčený, alebo nesprávny jazyk zapísaný v súbore" />
                                        <CheckBox Visibility="{Binding CanKeep, Converter={StaticResource BoolToVisibility}}" IsChecked="{Binding KeepChecked, UpdateSourceTrigger=PropertyChanged}"
                                                  FontSize="11.5" Margin="0,2,0,0" ToolTip="Tieto titulky ponechať, hoci ich jazyk nie je v zozname titulkov (Nastavenia)">
                                            <TextBlock Text="{Binding ResultNote}" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="260" />
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Názov (pred → po)" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NameBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NameAfter}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultAfter}" />
                        <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledAfter}" />
                        <DataGridTextColumn Header="Forced" Binding="{Binding ForcedAfter}" />
                        <DataGridTextColumn Header="Iné príznaky" Binding="{Binding OtherFlagsAfter}" />
                        <DataGridTextColumn Header="Rola" Binding="{Binding Role}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <WrapPanel>
