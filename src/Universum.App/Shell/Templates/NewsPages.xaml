                                                                    </Border>
                                                                </Border>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" CornerRadius="9" Padding="5,1"
                                                                        Background="#E0F2B34E" ToolTip="{loc:T 'Odporúčané'}"
                                                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="★" FontSize="12" Foreground="#141414" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- the logo, on a dark ground (its transparency is seen) -->
                                <CheckBox Content="{loc:T 'Logo názvu – clearlogo.png (priehľadné)'}" IsChecked="{Binding ExtraLogo}" FontWeight="SemiBold" Margin="0,6,0,4" />
                                <ItemsControl ItemsSource="{Binding Logos}" IsEnabled="{Binding ExtraLogo}" Margin="22,0,0,0"
                                              Visibility="{Binding HasLogos, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding SelectCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,10,10" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Width="176">
                                                            <Grid>
                                                                <Border x:Name="Frame" Width="176" Height="76" CornerRadius="6" BorderThickness="3" BorderBrush="Transparent" Background="#2A2A2E">
                                                                    <Image Source="{Binding Thumb.Image}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Border>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" CornerRadius="9" Padding="5,1"
                                                                        Background="#E0F2B34E" ToolTip="{loc:T 'Odporúčané'}"
                                                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="★" FontSize="12" Foreground="#141414" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- the seasons (a series): each ticked or not -->
                                <CheckBox Content="{loc:T 'Plagáty sérií – season01-poster.jpg … (hlavný priečinok seriálu)'}" IsChecked="{Binding ExtraSeasons}" IsEnabled="{Binding IsSeries}"
                                          FontWeight="SemiBold" Margin="0,6,0,4" />
                                <ItemsControl ItemsSource="{Binding Seasons}" IsEnabled="{Binding ExtraSeasons}" Margin="22,0,0,0"
                                              Visibility="{Binding HasSeasons, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="78" Margin="0,0,10,10">
                                                <Border Width="78" Height="117" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.35" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border CornerRadius="5">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Thumb.Image}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" MinWidth="0" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox Content="{loc:T 'Obrázky epizód – …-thumb.jpg pri epizódach (seriál)'}" IsChecked="{Binding ExtraEpisodes}" IsEnabled="{Binding IsSeries}"
                                          FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0"
                                           Text="{loc:T 'Bez náhľadov (môže ich byť stovky); do priečinkov sérií vedľa epizód – pri spracovanom seriáli s rovnakým menom ako epizóda.'}" />
                                <TextBlock Text="{Binding ExtrasSizeText}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <CheckBox Content="{loc:T 'Zlúčiť ďalšie obrázky z TMDB s filmom/seriálom'}" IsChecked="{Binding ExtrasMerge}" Margin="0,10,0,0"
                                          ToolTip="{loc:T 'Obrázky pôjdu k spracovanému filmu (MOVIES) alebo seriálu (TVSHOWS); keď je zatiaľ len na vstupe, počkajú, kým ho UNIVERSUM spracuje'}" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0"
                                           Text="Bez zaškrtnutia: POSTER\Názov (rok). So zaškrtnutím: k výstupu – film do MOVIES\Názov (rok), seriál do TVSHOWS\Názov (rok), obrázky epizód do jeho Season. Existujúce súbory sa premenujú na …-povodny." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding ProcessExtrasCommand}" Padding="14,6" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:T 'Spracovať ďalšie TMDB obrázky'}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{loc:T 'Otvoriť priečinok POSTER'}" Command="{Binding OpenPosterFolderCommand}" Padding="12,6" />
                                </StackPanel>
                                <TextBlock Text="{Binding ExtrasResult}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:InterestsPageViewModel}">
        <DockPanel Margin="24,20,24,12">
            <!-- a pastel banner, the controls, the chips of the sources -->
            <StackPanel DockPanel.Dock="Top">
                <Border CornerRadius="14" Padding="22,14" Margin="0,0,0,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#55F28C7C" Offset="0" />
                            <GradientStop Color="#55F2B34E" Offset="0.3" />
                            <GradientStop Color="#5563C48F" Offset="0.55" />
                            <GradientStop Color="#556FA8E8" Offset="0.8" />
                            <GradientStop Color="#55A78BE6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding RefreshCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="{loc:T 'Načíta zdroje hneď (inak pri prvom spustení dňa)'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:T 'Obnoviť'}" />
                                </StackPanel>
                            </Button>
                            <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopCommand}" Padding="12,5" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:T 'Zaujímavosti'}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:T 'Novinky, recenzie a zaujímavosti zo sveta filmu – preložené do vášho jazyka, celé články u ich autorov.'}" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel Margin="0,0,0,6">
                    <TextBox DockPanel.Dock="Right" Width="170" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="{loc:T 'Hľadať v nadpisoch a úvodoch (bez diakritiky)'}" />
                    <TextBlock DockPanel.Dock="Right" Text="{loc:T 'Hľadať:'}" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton Content="{loc:T 'Dnes'}" IsChecked="{Binding ShowToday}" GroupName="InterestPeriod" MinWidth="0" Margin="0,0,16,0" />
                        <RadioButton Content="{loc:T 'Tento týždeň'}" IsChecked="{Binding ShowWeek}" GroupName="InterestPeriod" MinWidth="0" Margin="0,0,16,0" />
                        <RadioButton Content="{loc:T 'Všetko (História)'}" IsChecked="{Binding ShowAll}" GroupName="InterestPeriod" MinWidth="0" Margin="0,0,24,0" />
                        <CheckBox Content="{loc:T 'Len obľúbené ★'}" IsChecked="{Binding OnlyFavorites}" MinWidth="0" Margin="0,0,16,0" />
                        <CheckBox Content="{loc:T 'Zobraziť originál'}" IsChecked="{Binding ShowOriginal}" MinWidth="0" />
                    </WrapPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ChooseCommand}" Margin="0,0,6,6" Cursor="Hand" ToolTip="{loc:T 'Len články tohto zdroja (znova kliknúť = všetky)'}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Chip" CornerRadius="12" Padding="12,3" BorderThickness="1.5" BorderBrush="{Binding Accent}" Background="{Binding Tint}">
                                            <TextBlock x:Name="Label" Text="{Binding Text}" FontWeight="SemiBold" FontSize="12" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{Binding Accent}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="2,0,0,4" />
                <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="2,0,0,6"
                           Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Attribution}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="2,8,0,0" />
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- the newest article big -->
                        <Border DataContext="{Binding Featured}" CornerRadius="14" BorderThickness="2" BorderBrush="{Binding Accent}" Background="{Binding Tint}"
                                Padding="14" Margin="0,0,10,14" Visibility="{Binding DataContext.IsEmpty, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource InverseBoolToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="360" Height="200" CornerRadius="10" Margin="0,0,18,0" Background="{Binding Accent}"
                                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                    <Border CornerRadius="10">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border CornerRadius="10" Background="{Binding Accent}" Padding="10,2" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Source}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding LanguageText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,10" MaxHeight="110" TextTrimming="WordEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{loc:T 'Čítať celý článok'}" Command="{Binding OpenCommand}" Padding="14,5" Margin="0,0,8,0" />
                                        <Button Command="{Binding FavoriteCommand}" Padding="10,5" Margin="0,0,8,0" ToolTip="{loc:T 'Obľúbené'}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="☆" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="★" />
                                                                <Setter Property="Foreground" Value="#E8A33A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Content="{loc:T 'Originál / preklad'}" Command="{Binding ToggleOriginalCommand}" Padding="10,5" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- the other articles as colourful cards -->
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Margin="0,0,12,12" CornerRadius="12" BorderThickness="1.5" BorderBrush="{Binding Accent}" Background="{Binding Tint}">
                                        <StackPanel>
                                            <Border Height="150" CornerRadius="11,11,0,0" Background="{Binding Accent}" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                                <Border CornerRadius="11,11,0,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <StackPanel Margin="12,10,12,12">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border CornerRadius="9" Background="{Binding Accent}" Padding="8,1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Source}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                                    </Border>
                                                    <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="64" TextTrimming="WordEllipsis" />
                                                <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="88" TextTrimming="WordEllipsis" Margin="0,6,0,8"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LanguageText}" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="{loc:T 'Čítať'}" Command="{Binding OpenCommand}" Padding="10,2" Margin="0,0,6,0" />
                                                        <Button Command="{Binding FavoriteCommand}" Padding="8,2" Margin="0,0,6,0" ToolTip="{loc:T 'Obľúbené'}">
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="☆" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                <Setter Property="Text" Value="★" />
                                                                                <Setter Property="Foreground" Value="#E8A33A" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                        <Button Content="{loc:T 'Originál'}" Command="{Binding ToggleOriginalCommand}" Padding="8,2" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{loc:T 'Zobraziť ďalšie'}" Command="{Binding MoreCommand}" HorizontalAlignment="Center" Padding="16,6" Margin="0,4,0,12"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
