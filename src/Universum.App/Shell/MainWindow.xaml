<Window x:Class="Universum.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Universum.App.Pages"
        Title="UNIVERSUM" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <DataTemplate DataType="{x:Type pages:PlaceholderPageViewModel}">
            <StackPanel Margin="32">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" MaxWidth="640" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{Binding Stage, StringFormat='Pripravuje sa – {0}.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pages:InfoPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="Informácie o súbore" />
                </DockPanel>
                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{Binding FileName}" Margin="0,8,0,0" />
                <StackPanel Grid.Row="2" Margin="0,4,0,12">
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" />
                        <DataGridTextColumn Header="Jazyk" Binding="{Binding Language}" />
                        <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="*" />
                        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="Forced" Binding="{Binding IsForced, Mode=OneWay}" />
                        <DataGridTextColumn Header="Vlastnosti" Binding="{Binding Properties}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:RulesPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Pravidlá UNIVERSUM" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <TextBlock Text="{Binding Issues}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Codec}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Jazyk (pred → po)" Width="175">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <StackPanel Visibility="{Binding NeedsLanguage, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="{Binding LanguageBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanguageAfter}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <ComboBox Visibility="{Binding NeedsLanguage, Converter={StaticResource BoolToVisibility}}"
                                                  ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="SlovakName" MinWidth="160" ToolTip="Neurčený jazyk – vyberte, v akom jazyku stopa je" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Názov (pred → po)" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NameBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NameAfter}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultAfter}" />
                        <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledAfter}" />
                        <DataGridTextColumn Header="Forced" Binding="{Binding ForcedAfter}" />
                        <DataGridTextColumn Header="Rola" Binding="{Binding Role}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Originál:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                            <RadioButton Content="zachovať" IsChecked="{Binding KeepOriginal}" Margin="0,0,16,0" GroupName="original" />
                            <RadioButton Content="vymazať (do Koša)" IsChecked="{Binding DeleteOriginal}" Margin="0,0,24,0" GroupName="original" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,8,0">
                                <Run Text="Výsledok:" /> <Run Text="{Binding TargetDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="Priečinok…" Command="{Binding ChooseTargetDirectoryCommand}" Margin="0,0,8,0" Padding="10,4" />
                            <Button Content="Vedľa originálu" Command="{Binding ClearTargetDirectoryCommand}" Padding="10,4" />
                        </WrapPanel>
                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Vrátiť späť" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="Použiť pravidlá" Command="{Binding ApplyCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:BatchPageViewModel}">
            <Grid Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="aj podpriečinky" IsChecked="{Binding Recursive}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Priečinok…" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" Padding="12,5" />
                        <Button Content="Analyzovať" Command="{Binding AnalyzeCommand}" Padding="16,5" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Hromadné spracovanie" />
                        <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,6,0,8">
                    <Button DockPanel.Dock="Right" Content="Upratať zvyšky" Command="{Binding CleanupCommand}" Padding="10,3"
                            ToolTip="Dočasné súbory po prerušenom spracovaní presunie do Koša" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Skupina" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="Súbory" Binding="{Binding Count}" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Signature}" TextWrapping="Wrap" Margin="8,0,8,6" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Rozpoznať jazyk titulkov" Command="{Binding DetectSubtitlesCommand}" Margin="0,0,8,0" Padding="10,3"
                                        ToolTip="Prečíta textové titulky prvého súboru skupiny (číta celý súbor, môže chvíľu trvať)" />
                                <Button Content="Potvrdiť návrhy" Command="{Binding ConfirmSuggestionsCommand}" Padding="10,3" />
                            </StackPanel>
                            <TextBlock Text="Stopy skupiny – rozhodnutie platí pre všetky jej súbory" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding SlotRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stopa" Binding="{Binding Slot}" />
                                <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="90" />
                                <DataGridTextColumn Header="Názov v súbore" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="Jazyk" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding FileLanguage}" Visibility="{Binding NeedsLanguage, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Center" />
                                                <ComboBox Visibility="{Binding NeedsLanguage, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding LanguageChoices}"
                                                          DisplayMemberPath="SlovakName" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Pôvod" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="11.5" />
                                                <TextBlock Text="{Binding Suggested}" FontWeight="SemiBold" FontSize="11.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Forced" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Visibility="{Binding IsSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                <CheckBox IsThreeState="True" IsChecked="{Binding Forced, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="zaškrtnuté = forced, prázdne = nie, plné pole = podľa súboru" />
                                                <TextBlock Text="{Binding ForcedHint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Súbory skupiny – výsledok simulácie" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <DataGrid Grid.Row="3" ItemsSource="{Binding FileRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Súbor" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="Výsledok" Binding="{Binding Status}" />
                                <DataGridTextColumn Header="Prečo na kontrolu" Binding="{Binding Reasons}" Width="*" />
                                <DataGridTemplateColumn Header="Aj tak">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ProcessAnyway, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      Visibility="{Binding CanProcessAnyway, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Spracovať aj bez povinnej stopy šablóny" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Bez šablóny" Command="{Binding RulesOnlyCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Zo skupiny" Command="{Binding TemplateFromGroupCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Upraviť…" Command="{Binding EditTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Načítať…" Command="{Binding LoadTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Uložiť…" Command="{Binding SaveTemplateCommand}" Padding="10,3" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="Šablóna:" FontWeight="SemiBold" /> <Run Text="{Binding TemplateDescription, Mode=OneWay}" />
                            </TextBlock>
                            <CheckBox Content="stopy mimo šablóny odstrániť" IsChecked="{Binding RemoveUnlisted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Originál:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton Content="zachovať" IsChecked="{Binding KeepOriginal}" GroupName="batchOriginal" Margin="0,0,12,0" />
                            <RadioButton Content="vymazať (do Koša)" IsChecked="{Binding DeleteOriginal}" GroupName="batchOriginal" Margin="0,0,20,0" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Run Text="Výsledok:" /> <Run Text="{Binding TargetDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="Priečinok…" Command="{Binding ChooseTargetDirectoryCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Vedľa originálov" Command="{Binding ClearTargetDirectoryCommand}" Padding="10,3" />
                        </WrapPanel>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Uložiť správu…" Command="{Binding SaveReportCommand}" Margin="0,0,6,0" Padding="10,4" />
                                <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="0,0,6,0" Padding="10,4" />
                                <Button Content="Zastaviť" Command="{Binding StopCommand}" Margin="0,0,6,0" Padding="10,4"
                                        ToolTip="Dokončí rozpracované súbory a ďalej nepokračuje" />
                                <Button Content="Spustiť" Command="{Binding RunCommand}" Padding="18,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Simulation}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding RunState}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Background="{DynamicResource LayerFillColorDefaultBrush}">
            <TextBlock DockPanel.Dock="Top" Text="UNIVERSUM" FontSize="20" FontWeight="SemiBold" Margin="20,20,20,16" />
            <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl Grid.Column="1" Content="{Binding SelectedTool.Page}" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Otvoriť v MKVToolNix GUI" Command="{Binding OpenMkvToolNixGuiCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="MKVToolNix…" Command="{Binding SetupCommand}" Padding="12,4" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}">
                    <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MkvToolNixStatus, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
