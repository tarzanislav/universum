                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T 'Rozpoznať jazyk audiostôp vybraných súborov'}" Command="{Binding DetectAudioSelectedCommand}" />
                                        <MenuItem Header="{loc:T 'Informácie o súbore'}" Command="{Binding ShowInfoCommand}" />
                                        <MenuItem Header="{loc:T 'Upraviť v štúdiu (titulky)'}" Command="{Binding EditInStudioCommand}" />
                                        <MenuItem Header="{loc:T 'Upraviť v štúdiu (zvuk)'}" Command="{Binding EditSoundInStudioCommand}" />
                                        <MenuItem Header="{loc:T 'Upraviť v štúdiu (obraz)'}" Command="{Binding EditPictureInStudioCommand}" />
                                        <MenuItem Header="{loc:T 'Vrátiť originály na pôvodné miesto'}" Command="{Binding UndoMovedCommand}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:T 'Súbor'}" Binding="{Binding FileName}" Width="*" MinWidth="110" />
