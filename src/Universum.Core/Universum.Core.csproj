<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tool-independent core of UNIVERSUM: media model, rules, planning and the MKVToolNix backend.
       Only the .NET base library is used, so the core builds and is tested on Windows and Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Universum.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Universum.Tests" />
  </ItemGroup>
</Project>
