                            <RadioButton Content="vymazať (zatiaľ vypnuté)" IsChecked="{Binding DeleteOriginal}" Margin="0,0,24,0" GroupName="original"
                                         ToolTip="Zatiaľ vypnuté: kým program v praxi neodladíme, originály sa vždy zachovajú." ToolTipService.ShowOnDisabled="True" IsEnabled="False" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,8,0">
                                <Run Text="Knižnica:" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="Priečinok…" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,4" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton Content="film" IsChecked="{Binding IsMovie}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <TextBlock Text="Titul:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,6,0"
                                     ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
                            <Button Content="TMDB" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="220" Margin="0,0,16,0"
                                      IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Potvrdiť titul" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                    Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Epizóda:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="napr. S01E04" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}">
                            <Run Text="Cieľ:" FontWeight="SemiBold" /> <Run Text="{Binding Target, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap">
                            <Run Text="{Binding Tmdb.Message, Mode=OneWay}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" />
                        </TextBlock>
                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Vrátiť späť" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="Do fronty" Command="{Binding QueueCommand}" Margin="0,0,8,0" Padding="16,6" ToolTip="Pridá súbor do fronty úloh namiesto okamžitého spracovania" />
                                <Button Content="Použiť pravidlá" Command="{Binding ApplyCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:MultiplexerPageViewModel}">
            <Grid Margin="24,12,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Zlučovanie" Margin="0,0,16,4" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <pages:MuxTabStrip Grid.Row="1" Margin="0,4,0,0" />
                <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="0,8,8,8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                    <ContentControl Content="{Binding Current}" />
                </Border>
                <!-- status line as in MKVToolNix: the queue and the progress of the running job -->
                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Pridať súbory…" Command="{Binding AddFilesCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Spustiť zlučovanie" Command="{Binding Current.StartCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Do fronty" Command="{Binding Current.QueueCommand}" Padding="14,6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QueueStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ProgressBar Width="140" Height="6" Maximum="1" Value="{Binding QueueProgress, Mode=OneWay}" VerticalAlignment="Center"
                                     Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>
        <!-- one multiplex settings: source files and tracks on the left, properties on the right, the output below -->
        <DataTemplate DataType="{x:Type pages:MuxSettingsViewModel}">
            <Grid x:Name="SettingsRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="400" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="250" MaxWidth="420" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" MinHeight="56" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="96" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Vymazať všetko" Padding="10,3" Margin="0,0,6,0"
                                        Command="{Binding DataContext.ClearSourcesCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                        ToolTip="Odstráni všetky zdrojové súbory zo Zlučovania (na disku sa nič nezmení)" />
                                <Button Content="Informácie" Padding="10,3" Margin="0,0,6,0"
                                        Command="{Binding DataContext.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                        ToolTip="Zobrazí vybraný zdrojový súbor (alebo súbor vybranej stopy) na stránke Informácie" ToolTipService.ShowOnDisabled="True" />
                                <Button Content="Odstrániť" Command="{Binding RemoveSourceCommand}" Padding="10,3"
                                        ToolTip="Odstráni vybraný zdrojový súbor (aj jeho stopy), časť alebo pripojený súbor" ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                            <TextBlock Text="Zdrojové súbory" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,8,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SourceRows}" SelectedItem="{Binding SelectedSource}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                            <!-- right click (MKVToolNix GUI: the menu of Source files) -->
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Pridať súbory…" Command="{Binding AddSourcesCommand}" />
                                    <MenuItem Header="Pripojiť súbory…" Command="{Binding AppendFilesCommand}"
                                              ToolTip="Pripojí súbory na koniec vybraného súboru – pokračujú jeho stopami (napr. 2. časť filmu)" />
                                    <MenuItem Header="Pridať súbory ako ďalšie časti…" Command="{Binding AddPartsCommand}"
                                              ToolTip="Súbory sa prečítajú ako jeden s vybraným súborom (napr. VTS_01_1.VOB, VTS_01_2.VOB)" />
                                    <Separator />
                                    <MenuItem Header="Odstrániť súbor" Command="{Binding RemoveSourceCommand}" />
                                    <MenuItem Header="Odstrániť všetky súbory" Command="{Binding RemoveAllSourcesCommand}" />
                                    <Separator />
                                    <MenuItem Header="Nastaviť názov výstupného súboru podľa vybraného súboru" Command="{Binding OutputFromSourceCommand}" />
                                    <Separator />
                                    <MenuItem Header="Informácie o súbore" Command="{Binding SourceInfoCommand}" />
                                    <Separator />
                                    <MenuItem Header="Vybrať všetky stopy zo súboru" Command="{Binding TakeAllTracksOfSourceCommand}"
                                              ToolTip="Zaškrtne všetky stopy vybraného súboru" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Názov súboru" Width="2*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- parts and appended files indented under their file, each file in its own colour -->
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                <Setter Property="Margin" Value="18,0,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kontajner" Binding="{Binding Container}" Width="100" MinWidth="70" />
                                <DataGridTextColumn Header="Veľkosť" Binding="{Binding Size}" Width="72" MinWidth="64" />
                                <DataGridTextColumn Header="Priečinok" Binding="{Binding Directory}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Directory}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Ťahaním zmeníte výšku zoznamov" />
                        <DockPanel Grid.Row="3" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Pravidlá UNIVERSUM" Command="{Binding ApplyRulesCommand}" Padding="10,3" Margin="0,0,6,0"
                                        ToolTip="Vyplní názvy, jazyky, príznaky a poradie vybraných stôp podľa pravidiel UNIVERSUM" ToolTipService.ShowOnDisabled="True" />
                                <Button Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Command="{Binding MoveUpCommand}" Padding="9,5" Margin="0,0,4,0" ToolTip="Posunúť vyššie (Ctrl+↑)" />
                                <Button Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Command="{Binding MoveDownCommand}" Padding="9,5" ToolTip="Posunúť nižšie (Ctrl+↓)" />
                            </StackPanel>
                            <TextBlock Text="Stopy vo výstupe" FontWeight="SemiBold" VerticalAlignment="Center"
                                       ToolTip="V poradí, v akom budú vo výstupnom súbore; nezaškrtnuté stopy sa nevezmú" />
                        </DockPanel>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding TrackRows}" SelectedItem="{Binding SelectedTrackItem}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Up" Modifiers="Control" Command="{Binding MoveUpCommand}" />
                                <KeyBinding Key="Down" Modifiers="Control" Command="{Binding MoveDownCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="{Binding Kind, Converter={StaticResource TrackTypeBrush}}" />
                                    <Style.Triggers>
                                        <!-- the tracks of an appended file: under the track they continue, not editable -->
                                        <DataTrigger Binding="{Binding IsMain}" Value="False">
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="ToolTip" Value="{Binding Explanation}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Vziať" Width="84" MinWidth="84">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Margin="0,0,2,0"
                                                          IsEnabled="{Binding IsMain}" ToolTip="Vziať túto stopu do výstupu" />
                                                <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="{Binding Source}"
                                                        Background="{Binding ColorIndex, Converter={StaticResource FileColor}}" />
                                                <TextBlock Text="{Binding Position}" VerticalAlignment="Center" ToolTip="Poradie vo výstupe" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Typ" Width="78" MinWidth="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}">
                                                <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="86" MinWidth="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Codec}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Jazyk" Binding="{Binding Language.Display}" Width="110" MinWidth="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="*" MinWidth="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Name}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" Width="66" MinWidth="66" />
                                <DataGridCheckBoxColumn Header="Forced" Binding="{Binding IsForced, Mode=OneWay}" Width="64" MinWidth="64" />
                                <DataGridTextColumn Header="Ďalšie" Binding="{Binding FlagMarks}" Width="0.6*" MinWidth="56">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding FlagMarks}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- what the rules would still change, on one line (all in the tooltip) -->
                        <DockPanel Grid.Row="5" Margin="0,4,0,0" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FindingsText}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ItemsControl ItemsSource="{Binding Findings}" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DockPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext" ToolTip="Ťahaním zmeníte šírku panelov" />
                    <!-- Properties: of the selected track or source file; below them the output's title, chapters and attachments -->
                    <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Vlastnosti" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Hint}" Visibility="{Binding ShowsNothing, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap"
                                           Text="Vyberte stopu alebo zdrojový súbor – jeho vlastnosti sa zobrazia tu." />
                                <StackPanel DataContext="{Binding SelectedTrack}" Visibility="{Binding DataContext.ShowsTrack, ElementName=SettingsRoot, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel Margin="0,0,0,6">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TypeChip}" Background="{Binding Kind, Converter={StaticResource TrackTypeBrush}, ConverterParameter=chip}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Type}" Foreground="#1F1F1F" FontSize="12" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}">
                                            <Run Text="{Binding Codec, Mode=OneWay}" /> <Run Text="{Binding Properties, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
