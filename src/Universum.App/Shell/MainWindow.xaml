                                                <DataGridTextColumn Header="{loc:T 'Formát'}" Binding="{Binding Format, Mode=OneWay}" IsReadOnly="True" />
                                                <DataGridTextColumn Header="{loc:T 'Titulkov'}" Binding="{Binding Count, Mode=OneWay}" IsReadOnly="True" />
                                                <DataGridTextColumn Header="{loc:T 'Zmeny'}" Binding="{Binding Summary, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Grid.Row="2" Margin="0,8,0,4">
                                            <WrapPanel>
                                                <Button Content="{loc:T 'Pridať externé titulky…'}" Command="{Binding AddExternalCommand}" Padding="12,4" Margin="0,0,8,0"
