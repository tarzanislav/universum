                            <Button Content="Prijať návrhy názvov" Command="{Binding ConfirmTitlesCommand}" Padding="10,3"
                                    ToolTip="Druh, názvy a čísla epizód odhadnuté z mien súborov a priečinkov (nie otázky Season 00 / Season 01)" />
                            <Button Content="Špeciály do Season 00" Command="{Binding AnswerSpecialsCommand}" Padding="10,3" Margin="6,0,0,0"
