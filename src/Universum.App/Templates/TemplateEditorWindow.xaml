<Window x:Class="Universum.App.Templates.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNIVERSUM – šablóna" Width="760" Height="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Názov:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,10,0,10"
                   Text="Poradie riadkov určuje poradie jazykov v súboroch. Súbor, ktorému chýba voliteľná stopa, šablóne stále vyhovuje; ak chýba povinná, ide na kontrolu. Príznaky Default, Enabled a Forced vždy určia pravidlá UNIVERSUM." />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Typ" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TypeChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                      SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Jazyk" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="SlovakName"
                                      SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Variant" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RoleChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                      SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Povinná" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Required, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Pridať" Command="{Binding AddCommand}" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="Odstrániť" Command="{Binding RemoveCommand}" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="Hore" Command="{Binding UpCommand}" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="Dole" Command="{Binding DownCommand}" Margin="0,0,24,0" Padding="12,4" />
            <CheckBox Content="Stopy mimo šablóny odstrániť" IsChecked="{Binding RemoveUnlisted}" VerticalAlignment="Center" />
        </WrapPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Použiť" IsDefault="True" Click="OnOk" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Zrušiť" IsCancel="True" Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>
