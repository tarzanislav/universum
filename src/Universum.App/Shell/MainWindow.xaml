                            <RadioButton Content="vymazať" IsChecked="{Binding DeleteOriginal}" GroupName="batchOriginal" Margin="0,0,20,0"
                                         ToolTip="Pri zmene len hlavičky na tom istom disku sa originál presunie do knižnice, inak ide do Koša" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Run Text="Knižnica:" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="Priečinok…" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" />
