<Window x:Class="Universum.App.Setup.MkvToolNixSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNIVERSUM – MKVToolNix" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource PageTitle}" Text="MKVToolNix" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                   Text="UNIVERSUM pracuje so súbormi MKV výhradne cez oficiálne nástroje MKVToolNix. Inštalátor sa stiahne len z mkvtoolnix.download a spustí sa až po overení kontrolného súčtu a podpisu vydavateľa." />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <ProgressBar Margin="0,12,0,0" Height="4" Maximum="1" Value="{Binding Progress}"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
        <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Right">
            <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Mám ho inde – vybrať priečinok…" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Zavrieť" IsCancel="True" Click="OnClose" Padding="16,6" />
        </WrapPanel>
    </StackPanel>
</Window>
