<!-- UNIVERSUM – Príručky, Prehľad, Nastavenia (14. 11. 2026, step 2 of the review of the code: the templates of MainWindow.xaml by pages) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:Universum.App.Pages"
                    xmlns:app="clr-namespace:Universum.App"
                    xmlns:jobs="clr-namespace:Universum.App.Jobs"
                    xmlns:loc="clr-namespace:Universum.App.Localization"
                    xmlns:player="clr-namespace:Universum.App.Player">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Universum;component/Shell/Templates/Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- owner, 31. 10. 2026: Návod of a group – the contents with search on the left, the guide on the right -->
    <DataTemplate DataType="{x:Type pages:GuidePageViewModel}">
        <Grid Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:T 'Obsah'}" FontWeight="SemiBold" FontSize="15" Foreground="{Binding Accent}" Margin="2,6,0,8" />
                <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="6,4"
                         ToolTip="{loc:T 'Hľadať v návode (aj bez diakritiky)'}" />
                <Button DockPanel.Dock="Bottom" Content="{loc:T 'Tlač a export…'}" Command="{Binding PrintCommand}" Margin="0,10,0,0" Padding="10,4" HorizontalAlignment="Left"
                        ToolTip="{loc:T 'Návod vytlačiť alebo uložiť ako PDF či HTML'}" />
                <TextBlock DockPanel.Dock="Top" Text="{loc:T 'Nič sa nenašlo.'}" Style="{StaticResource Hint}" Margin="2,0,0,6"
                           Visibility="{Binding NothingFound, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding GoCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand">
                                    <Border x:Name="Row" Padding="8,5" Margin="0,1" CornerRadius="6" Background="Transparent">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#1F808080" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14,6,6">
                <FlowDocumentScrollViewer Document="{Binding Document}" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Focusable="False" />
            </Border>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:DashboardPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" MaxWidth="1100" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Dashboard'}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16">
                    <Run Text="{Binding Greeting, Mode=OneWay}" /><Run Text="{loc:T ' – prehľad dňa a toho, čo UNIVERSUM práve robí.'}" />
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.3*" MinWidth="380" />
                    </Grid.ColumnDefinitions>
                    <!-- today: time, date, name day -->
                    <Border Style="{StaticResource Card}" Padding="20,16" BorderBrush="#66F2A07C">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#40FFB38A" Offset="0" />
                                <GradientStop Color="#26F28CB0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{loc:T 'Dnes'}" FontWeight="SemiBold" Foreground="#D9673A" />
                            <TextBlock Text="{Binding TimeText}" FontSize="46" FontWeight="Light" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DateText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NameDayText}" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding TomorrowText}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DayInfo}" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- weather of the town in the settings (Open-Meteo, named below) -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16" BorderBrush="#665BA8E0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4D7CC4F5" Offset="0" />
                                <GradientStop Color="#26A78BE6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="{loc:T 'Obnoviť'}" Command="{Binding RefreshWeatherCommand}" Padding="10,3"
                                        Visibility="{Binding HasPlace, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{loc:T 'Počasie'}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding PlaceText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" FontSize="11.5" VerticalAlignment="Bottom">
                                    <Hyperlink Command="{Binding OpenWeatherSiteCommand}" ToolTip="{loc:T 'https://open-meteo.com – údaje pod licenciou CC BY 4.0'}">
                                        <Run Text="{Binding WeatherAttribution, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{Binding WeatherMessage}" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,12,0" />
                            </DockPanel>
                            <StackPanel>
                                <Button Content="{loc:T 'Nastaviť mesto…'}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,12,0,0"
                                        Visibility="{Binding HasPlace, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel Visibility="{Binding HasWeather, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding WeatherSymbol}" FontFamily="Segoe UI Symbol" FontSize="44" VerticalAlignment="Center" Margin="0,0,14,0"
                                                   Foreground="#F2A33A" />
                                        <TextBlock Text="{Binding TemperatureText}" FontSize="44" FontWeight="Light" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WeatherDescription}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding WeatherDetail}" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding WeatherDays}" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Background="#337CC4F5" Margin="0,0,6,0" Padding="10,4" ToolTip="{Binding Description}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Temperatures}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Rain}" Style="{StaticResource Hint}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
                <!-- POZNÁMKY: the coming week of the calendar; the open tasks, a task in one line and the pinned notes -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20,14" BorderBrush="#66D46A8C">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2ED46A8C" Offset="0" />
                                <GradientStop Color="#1AA78BE6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{loc:T 'Kalendár'}" Command="{Binding Agenda.OpenCalendarCommand}" Padding="10,2" />
                                <Button DockPanel.Dock="Right" Content="+" Command="{Binding Agenda.NewEventCommand}" Padding="10,2" Margin="0,0,6,0" FontWeight="Bold"
                                        ToolTip="{loc:T 'Nová udalosť dnes'}" />
                                <TextBlock Text="{loc:T 'Kalendár – najbližších 7 dní'}" FontWeight="SemiBold" FontSize="15" Foreground="#B8466E" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{loc:T 'Na najbližších 7 dní nie je v kalendári nič – udalosť pridáte tlačidlom +.'}" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Visibility="{Binding Agenda.NoCalendar, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Agenda.Calendar}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding OpenCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand" ToolTip="{Binding ToolTip}">
                                            <Grid Margin="0,2" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Day" Text="{Binding Day}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding FirstOfDay, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                                <DockPanel Grid.Column="2">
                                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding Color}" Margin="0,2,8,2" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource NewsSubtitle}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="Day" Property="Foreground" Value="#B8466E" />
                                                <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14" BorderBrush="#66E09A3E">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2EE09A3E" Offset="0" />
                                <GradientStop Color="#1AC9A227" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="{loc:T 'Plánované úlohy'}" Command="{Binding Agenda.OpenTasksCommand}" Padding="10,2" />
                                <TextBlock Text="{loc:T 'Úlohy'}" FontWeight="SemiBold" FontSize="15" Foreground="#B5731F" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Text="{Binding Agenda.QuickText, UpdateSourceTrigger=PropertyChanged}" Padding="8,4">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding Agenda.AddCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{Binding Agenda.QuickHint}" Style="{StaticResource Hint}" FontSize="11.5" Margin="2,2,0,6" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:T 'Žiadna otvorená úloha na najbližších 7 dní.'}" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Visibility="{Binding Agenda.NoTasks, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Agenda.Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsDone}" MinWidth="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      ToolTip="{loc:T 'Hotovo'}" />
                                            <TextBlock x:Name="Due" DockPanel.Dock="Right" Text="{Binding Due}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock DockPanel.Dock="Left" Text="!" Foreground="#D9534F" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center"
                                                       Visibility="{Binding High, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Command="{Binding OpenCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand" VerticalAlignment="Center">
                                                <TextBlock Background="Transparent" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Tags, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                </TextBlock>
                                            </Button>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Late}" Value="True">
                                                <Setter TargetName="Due" Property="Foreground" Value="#D9534F" />
                                                <Setter TargetName="Due" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="12" Margin="0,4,0,0" Visibility="{Binding Agenda.HasMoreTasks, Converter={StaticResource BoolToVisibility}}">
                                <Hyperlink Command="{Binding Agenda.OpenTasksCommand}"><Run Text="{Binding Agenda.MoreTasks, Mode=OneWay}" /></Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding Agenda.Status}" Style="{StaticResource NewsSubtitle}" Margin="0,4,0,0" />
                            <!-- the pinned notes -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding Agenda.HasNotes, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="{loc:T 'Poznámky'}" Command="{Binding Agenda.OpenNotesCommand}" Padding="10,2" />
                                    <TextBlock Text="{loc:T 'Pripnuté poznámky'}" FontWeight="SemiBold" FontSize="14" Foreground="#9A7A10" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Agenda.Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding OpenCommand}" Template="{StaticResource CalendarDayButton}" Cursor="Hand">
                                                <DockPanel Margin="0,2" Background="Transparent">
                                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding Color}" Margin="0,2,8,2" />
                                                    <TextBlock DockPanel.Dock="Right" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding HasRecording, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- this week: episodes of the chosen series and premieres, films premiering -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20,14" BorderBrush="#6663C48F">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3363C48F" Offset="0" />
                                <GradientStop Color="#1F6FA8E8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{loc:T 'Novinky – Seriály'}" Command="{Binding Week.OpenNewsCommand}" Padding="10,2" />
                                <TextBlock Text="{loc:T 'Tento týždeň – seriály'}" FontWeight="SemiBold" FontSize="15" Foreground="#2F9461" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{loc:T 'Žiadne epizódy vybraných seriálov ani premiéry seriálov – seriály, ktoré sledujete, zaškrtnite v Novinkách v stĺpci Vybrané.'}"
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Week.NoEpisodes, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Week.Episodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Day" Text="{Binding Day}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="★" Foreground="#E8A33A" Visibility="{Binding Chosen, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="Day" Property="Foreground" Value="#2F9461" />
                                                <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14" BorderBrush="#66F28C7C">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#33F28C7C" Offset="0" />
                                <GradientStop Color="#1FF2C14E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{loc:T 'Premiéry'}" Command="{Binding Week.OpenPremieresCommand}" Padding="10,2" />
                                <TextBlock Text="{loc:T 'Tento týždeň – filmy'}" FontWeight="SemiBold" FontSize="15" Foreground="#C9573F" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{loc:T 'Tento týždeň nemá premiéru žiadny sledovaný film.'}" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Visibility="{Binding Week.NoFilms, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Week.Films}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Day" Text="{Binding Day}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="★" Foreground="#E8A33A" Visibility="{Binding Chosen, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="Day" Property="Foreground" Value="#C9573F" />
                                                <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- where the chosen titles can be watched legally; chosen titles already in the input folder -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20,14" BorderBrush="#664FB8B8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#334FB8B8" Offset="0" />
                                <GradientStop Color="#1F63C48F" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{loc:T 'Skontrolovať'}" Command="{Binding Week.CheckWatchCommand}" Padding="10,2"
                                        ToolTip="{loc:T 'Zistí hneď, kde sa dajú vybrané tituly pozerať (inak raz denne pri spustení)'}" />
                                <TextBlock Text="{loc:T 'Kde pozerať – vybrané tituly'}" FontWeight="SemiBold" FontSize="15" Foreground="#2E8F8F" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{loc:T 'Vybrané tituly zatiaľ nie sú na streamovacích službách na Slovensku ani v Česku (alebo ešte neboli skontrolované).'}"
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Week.NoOffers, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Week.Offers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Background="#2E8F8F" Padding="7,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{loc:T 'NOVÉ'}" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Where}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Week.WatchStatus}" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Week.WatchAttribution}" Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14" BorderBrush="#669CC25A">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#339CC25A" Offset="0" />
                                <GradientStop Color="#1FF2C14E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{loc:T 'Pripravené vo vstupnom priečinku'}" FontWeight="SemiBold" FontSize="15" Foreground="#5E8A2A" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:T 'Vo vstupnom priečinku zatiaľ nie je žiadna epizóda seriálu z Noviniek ani vybraný film – UNIVERSUM ho stráži pri každom spustení.'}"
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding Week.HasFound, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Week.Found}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
