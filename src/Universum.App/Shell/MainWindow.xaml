                                    <CheckBox Content="Vziať túto stopu do výstupu" IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                    <TextBlock Text="Názov stopy" Margin="0,2,0,2" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Jazyk" Margin="0,8,0,2" />
                                    <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Display" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Príznaky" Margin="0,10,0,2" FontWeight="SemiBold" />
                                    <CheckBox Content="Predvolená stopa (Default)" IsChecked="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Zapnutá (Enabled)" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Vynútené zobrazenie (Forced)" IsChecked="{Binding IsForced, UpdateSourceTrigger=PropertyChanged}" />
                                    <Expander Header="Ďalšie príznaky a rozšírené vlastnosti" Margin="0,8,0,0"
                                              IsExpanded="{Binding DataContext.ShowAdvanced, ElementName=SettingsRoot}">
                                        <StackPanel Margin="0,6,0,0">
                                            <CheckBox Content="Pre nepočujúcich (SDH)" IsChecked="{Binding IsHearingImpaired, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Pre nevidiacich (audio popis)" IsChecked="{Binding IsVisualImpaired, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Popis deja textom" IsChecked="{Binding IsTextDescriptions, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Pôvodný jazyk diela" IsChecked="{Binding IsOriginal, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Komentár" IsChecked="{Binding IsCommentary, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Oneskorenie (ms, záporné = skôr)" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Predvolené trvanie / FPS (napr. 25p, 24000/1001p)" Margin="0,8,0,2" TextWrapping="Wrap" />
                                            <TextBox Text="{Binding DefaultDuration, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Kompresia" Margin="0,8,0,2" />
                                            <ComboBox ItemsSource="{Binding CompressionChoices}" SelectedItem="{Binding Compression}" DisplayMemberPath="Text" HorizontalAlignment="Stretch" />
                                            <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                <CheckBox Content="Opraviť časové údaje bitstreamu" IsChecked="{Binding FixBitstreamTiming, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                                <TextBlock Text="Pomer strán obrazu (napr. 16/9)" Margin="0,8,0,2" />
                                                <TextBox Text="{Binding AspectRatio, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Orez v pixeloch (vľavo,hore,vpravo,dole)" Margin="0,8,0,2" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding Cropping, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsTextSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Kódovanie znakov titulkov" Margin="0,8,0,2" />
                                                <ComboBox IsEditable="True" Text="{Binding SubtitleCharset, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"
