                                <ItemsControl ItemsSource="{Binding Week.Offers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Border DockPanel.Dock="Right" CornerRadius="8" Background="#2E8F8F" Padding="7,0" VerticalAlignment="Center"
