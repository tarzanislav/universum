<Window x:Class="Universum.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Universum.App.Pages"
        xmlns:jobs="clr-namespace:Universum.App.Jobs"
        Title="UNIVERSUM" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <DataTemplate DataType="{x:Type pages:PlaceholderPageViewModel}">
            <StackPanel Margin="32">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" MaxWidth="640" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{Binding Stage, StringFormat='Pripravuje sa – {0}.'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type pages:InfoPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="Informácie o súbore" />
                </DockPanel>
                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{Binding FileName}" Margin="0,8,0,0" />
                <StackPanel Grid.Row="2" Margin="0,4,0,12">
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" />
                        <DataGridTextColumn Header="Jazyk" Binding="{Binding Language}" />
                        <DataGridTextColumn Header="Názov" Binding="{Binding Name}" Width="*" />
                        <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="Forced" Binding="{Binding IsForced, Mode=OneWay}" />
                        <DataGridTextColumn Header="Vlastnosti" Binding="{Binding Properties}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:RulesPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Pravidlá UNIVERSUM" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <TextBlock Text="{Binding Issues}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Codec}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Jazyk (pred → po)" Width="175">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <StackPanel Visibility="{Binding NeedsLanguage, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="{Binding LanguageBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanguageAfter}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <ComboBox Visibility="{Binding NeedsLanguage, Converter={StaticResource BoolToVisibility}}"
                                                  ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="SlovakName" MinWidth="160" ToolTip="Neurčený jazyk – vyberte, v akom jazyku stopa je" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Názov (pred → po)" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NameBefore}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NameAfter}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultAfter}" />
                        <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledAfter}" />
                        <DataGridTextColumn Header="Forced" Binding="{Binding ForcedAfter}" />
                        <DataGridTextColumn Header="Rola" Binding="{Binding Role}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Originál:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                            <RadioButton Content="zachovať" IsChecked="{Binding KeepOriginal}" Margin="0,0,16,0" GroupName="original" />
                            <RadioButton Content="vymazať" IsChecked="{Binding DeleteOriginal}" Margin="0,0,24,0" GroupName="original"
                                         ToolTip="Pri zmene len hlavičky na tom istom disku sa originál presunie do knižnice, inak ide do Koša" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,8,0">
                                <Run Text="Knižnica:" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="Priečinok…" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,4" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton Content="film" IsChecked="{Binding IsMovie}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="kind" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <TextBlock Text="Titul:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,6,0"
                                     ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
                            <Button Content="TMDB" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="220" Margin="0,0,16,0"
                                      IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Epizóda:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="napr. S01E04" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}">
                            <Run Text="Cieľ:" FontWeight="SemiBold" /> <Run Text="{Binding Target, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap">
                            <Run Text="{Binding Tmdb.Message, Mode=OneWay}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" />
                        </TextBlock>
                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Vrátiť späť" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="Do fronty" Command="{Binding QueueCommand}" Margin="0,0,8,0" Padding="16,6" ToolTip="Pridá súbor do fronty úloh namiesto okamžitého spracovania" />
                                <Button Content="Použiť pravidlá" Command="{Binding ApplyCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:MultiplexerPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Pridať súbory…" Command="{Binding AddFilesCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Odstrániť vstup" Command="{Binding RemoveInputCommand}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="Nové" Command="{Binding ClearCommand}" Padding="12,6" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Zlučovanie" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="130" Margin="0,10,0,0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                        <DataGridTextColumn Header="Vstupný súbor" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="Obsah" Binding="{Binding Details}" Width="2*" />
                        <DataGridTemplateColumn Header="Kapitoly" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding KeepChapters, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasChapters}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Prílohy" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding KeepAttachments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasAttachments}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tagy" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding KeepTags, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasTags}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Grid.Row="2" Margin="0,10,0,6">
                    <TextBlock Text="Stopy vo výstupe (poradie zhora nadol)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Pravidlá UNIVERSUM" Command="{Binding ApplyRulesCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="Vyplní názvy, jazyky, príznaky a poradie vybraných stôp podľa pravidiel UNIVERSUM" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="Posunúť vyššie (Ctrl+↑)" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" ToolTip="Posunúť nižšie (Ctrl+↓)" />
                </WrapPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding MoveUpCommand}" />
                        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding MoveDownCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Vziať" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" />
                        <DataGridTextColumn Header="Zo súboru" Binding="{Binding Source}" Width="*" MinWidth="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Source}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="70" />
                        <DataGridTemplateColumn Header="Názov" Width="1.5*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Jazyk" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Display" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Default" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Enabled" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Forced" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsForced, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Výstupný súbor:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" />
                            <Button Grid.Column="2" Content="Uložiť ako…" Command="{Binding ChooseOutputCommand}" Padding="12,4" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Text="Názov (title):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" />
                            <TextBlock Grid.Row="2" Text="Kapitoly zo súboru:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ChaptersFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6"
                                     ToolTip="Kapitoly XML, OGM (.txt) alebo cue – pridajú sa ku kapitolám zo vstupov, ktoré sú zaškrtnuté" />
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Vybrať…" Command="{Binding ChooseChaptersCommand}" Padding="12,4" Margin="0,0,6,0" />
                                <Button Content="✕" Command="{Binding ClearChaptersCommand}" Padding="8,4" ToolTip="Bez súboru s kapitolami" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Nové prílohy:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,8,0" />
                            <ListBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}" MaxHeight="70" MinHeight="30" Margin="0,0,8,0" />
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Pridať…" Command="{Binding AddAttachmentCommand}" Padding="12,4" Margin="0,0,6,0" />
                                <Button Content="✕" Command="{Binding RemoveAttachmentCommand}" Padding="8,4" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                            <TextBlock Text="Kontrola" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Do fronty" Command="{Binding QueueCommand}" Padding="16,6" Margin="0,0,8,0" />
                                <Button Content="Spustiť zlučovanie" Command="{Binding StartCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:HeaderEditorPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Otvoriť súbor…" Command="{Binding OpenCommand}" Padding="16,6" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Úprava hlavičky" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    </StackPanel>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <TextBlock Text="Názov (title):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="380" Margin="0,0,20,0"
                             ToolTip="Názov celého súboru, ktorý ukazujú prehrávače; prázdny ho odstráni" />
                    <CheckBox Content="Odstrániť tagy" IsChecked="{Binding RemoveTags}" IsEnabled="{Binding HasTags}" VerticalAlignment="Center" Margin="0,0,20,0"
                              ToolTip="Globálne tagy aj tagy stôp (názvy, štatistiky, údaje o kódovaní)" />
                    <Button Content="Pravidlá UNIVERSUM" Command="{Binding ApplyRulesCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="Vyplní názvy, jazyky, príznaky a poradie podľa pravidiel UNIVERSUM – potom sa dá ďalej upraviť" />
                    <Button Content="Obnoviť zo súboru" Command="{Binding ResetCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="Posunúť vyššie (Ctrl+↑) – zvuk medzi zvukom, titulky medzi titulkami" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" ToolTip="Posunúť nižšie (Ctrl+↓)" />
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding MoveUpCommand}" />
                        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding MoveDownCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="70" />
                        <DataGridTemplateColumn Header="Názov" Width="2*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Before}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Jazyk" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Display" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Default" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Enabled" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Forced" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsForced, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vynechať" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsRemoved, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRemove}" HorizontalAlignment="Center"
                                              ToolTip="Stopa sa do výsledku nedostane (zapíše sa nový súbor)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Zmeny" Binding="{Binding Changes}" Width="*" MinWidth="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Before}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                            <TextBlock Text="Kontrola" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Vrátiť späť" Command="{Binding UndoCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="Do fronty" Command="{Binding QueueCommand}" Margin="0,0,8,0" Padding="16,6" ToolTip="Pridá zmenu do fronty úloh namiesto okamžitého uloženia" />
                                <Button Content="Uložiť" Command="{Binding SaveCommand}" Padding="16,6" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Method}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type jobs:JobQueuePageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Fronta úloh" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding State}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button Content="Spustiť" Command="{Binding StartCommand}" Padding="14,4" Margin="0,0,8,0" />
                    <Button Content="Zastaviť po aktuálnej" Command="{Binding StopCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <Button Content="Zrušiť" Command="{Binding CancelCommand}" Padding="12,4" Margin="0,0,8,0" ToolTip="Zruší bežiacu úlohu (originál ostane nezmenený) alebo vyradí čakajúcu" />
                    <Button Content="Spustiť znova" Command="{Binding RetryCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,4,0" ToolTip="Čakajúcu úlohu skôr" />
                    <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="10,4" Margin="0,0,16,0" ToolTip="Čakajúcu úlohu neskôr" />
                    <Button Content="Výstup…" Command="{Binding OutputCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Vrátiť späť" Command="{Binding UndoCommand}" Padding="12,4" Margin="0,0,16,0" ToolTip="Vráti úpravu hlavičky, ktorú urobila táto úloha" />
                    <Button Content="Odstrániť" Command="{Binding RemoveCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Vyčistiť dokončené" Command="{Binding ClearCommand}" Padding="12,4" />
                </WrapPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                        <DataGridTextColumn Header="Úloha" Binding="{Binding Description}" Width="2*" />
                        <DataGridTemplateColumn Header="Stav" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock x:Name="state" Text="{Binding Status}" />
                                        <ProgressBar Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="state" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                            <Setter TargetName="state" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Výsledok" Binding="{Binding Outcome}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Outcome}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Pridaná" Binding="{Binding Added}" />
                        <DataGridTextColumn Header="Trvanie" Binding="{Binding Duration}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <CheckBox Content="Spustiť frontu hneď po pridaní úlohy" IsChecked="{Binding AutoStart}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type jobs:JobOutputPageViewModel}">
            <Grid Margin="32,24,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Job}" DisplayMemberPath="Display" Width="360" VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="Výstup úloh" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,6,0,10">
                    <TextBlock Text="{Binding Job.Description}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserReorderColumns="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Čas" Binding="{Binding Time}" />
                        <DataGridTemplateColumn Header="Druh" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="kind" Text="{Binding Severity}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="kind" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="kind" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Správa" Binding="{Binding Text}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:BatchPageViewModel}">
            <Grid Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="aj podpriečinky" IsChecked="{Binding Recursive}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Priečinok…" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" Padding="12,5" />
                        <Button Content="Analyzovať" Command="{Binding AnalyzeCommand}" Padding="16,5" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Hromadné spracovanie" />
                        <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,6,0,8">
                    <Button DockPanel.Dock="Right" Content="Upratať zvyšky" Command="{Binding CleanupCommand}" Padding="10,3"
                            ToolTip="Dočasné súbory po prerušenom spracovaní presunie do Koša" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False">
