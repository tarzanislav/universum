                                                        ToolTip="{loc:T 'Podľa titulu (s TMDB ID presne) a epizódy; účet a API kľúč v Nastaveniach'}" />
                                                <TextBlock Text="{loc:T 'titulky.com (CZ/SK):'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Content="{loc:T 'Hľadať v prehliadači'}" Command="{Binding SearchTitulkyCommand}" Padding="12,3" Margin="0,0,20,0"
