                            <DataGridTextColumn Header="Skupina" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="Súbory" Binding="{Binding Count}" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding State}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Signature}" TextWrapping="Wrap" Margin="8,0,8,6" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
