                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Day" Text="{Binding Day}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="★" Foreground="#E8A33A" Visibility="{Binding Chosen, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Day" Property="Foreground" Value="#2F9461" />
                                                    <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14" BorderBrush="#66F28C7C">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#33F28C7C" Offset="0" />
                                    <GradientStop Color="#1FF2C14E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Premiéry" Command="{Binding Week.OpenPremieresCommand}" Padding="10,2" />
                                    <TextBlock Text="Tento týždeň – filmy" FontWeight="SemiBold" FontSize="15" Foreground="#C9573F" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Tento týždeň nemá premiéru žiadny sledovaný film." Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Visibility="{Binding Week.NoFilms, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Week.Films}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Day" Text="{Binding Day}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="★" Foreground="#E8A33A" Visibility="{Binding Chosen, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Day" Property="Foreground" Value="#C9573F" />
                                                    <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
