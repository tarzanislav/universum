<Window x:Class="Universum.App.Pages.HistraImportWindow"
        xmlns:loc="clr-namespace:Universum.App.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:T 'UNIVERSUM – import listov z HISTRA'}" Width="720" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{loc:T 'Import listov z HISTRA'}" FontWeight="SemiBold" FontSize="18" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" Margin="0,4,0,10" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:T 'Vybrať všetky'}" Command="{Binding AllCommand}" Margin="8,0,8,0" Padding="10,4" />
                    <Button Content="{loc:T 'Nevybrať nič'}" Command="{Binding NoneCommand}" Padding="10,4" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="{loc:T 'Hľadať list:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hľadať list podľa názvu (bez diakritiky)" />
            </DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding ImportText}" Click="OnImport" IsDefault="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="{loc:T 'Zrušiť'}" IsCancel="True" Padding="16,6" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Visible}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding IsChecked}" VerticalContentAlignment="Top">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="12" Margin="0,1,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding Posters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="46" Height="69" CornerRadius="4" Margin="0,0,6,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <Border CornerRadius="4">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding MoreText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
