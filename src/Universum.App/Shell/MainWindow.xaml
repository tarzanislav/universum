                            <Button Content="Zo skupiny" Command="{Binding TemplateFromGroupCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Upraviť…" Command="{Binding EditTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Načítať…" Command="{Binding LoadTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="Uložiť…" Command="{Binding SaveTemplateCommand}" Padding="10,3" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="Šablóna:" FontWeight="SemiBold" /> <Run Text="{Binding TemplateDescription, Mode=OneWay}" />
                            </TextBlock>
                            <CheckBox Content="stopy mimo šablóny odstrániť" IsChecked="{Binding RemoveUnlisted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

