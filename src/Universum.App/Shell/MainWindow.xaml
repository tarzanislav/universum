                                <Button Content="{loc:T 'TMDB'}" Command="{Binding FilmTmdb.SearchCommand}" ToolTip="{Binding FilmTmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0"
