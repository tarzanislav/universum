                            <RadioButton Content="zachovať" IsChecked="{Binding KeepOriginal}" GroupName="batchOriginal" Margin="0,0,12,0" IsEnabled="{Binding IsIdle}" />
                            <RadioButton Content="zmazať automaticky" IsChecked="{Binding DeleteAutomatically}" GroupName="batchOriginal" Margin="0,0,12,0" IsEnabled="{Binding IsIdle}"
                                         ToolTip="Každý originál ide do Koša hneď po zapísaní a overení nového súboru v knižnici – priebežne, súbor po súbore" />
                            <RadioButton Content="zmazať ručne" IsChecked="{Binding DeleteManually}" GroupName="batchOriginal" Margin="0,0,8,0" IsEnabled="{Binding IsIdle}"
                                         ToolTip="Počas spracovania sa nič nemaže; po dokončení pošle originály do Koša tlačidlo Zmazať originály" />
                            <Button Content="{Binding DeleteOriginalsText}" Command="{Binding DeleteOriginalsCommand}" Padding="10,3" Margin="0,0,20,0"
                                    Visibility="{Binding CanDeleteOriginals, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Originály spracovaných súborov do Koša Windows – len tie, ktorých výsledok je v knižnici a ktoré sa od spracovania nezmenili" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Run Text="Knižnica:" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="{loc:T 'Priečinok…'}" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton Content="filmy" IsChecked="{Binding IsMovies}" GroupName="batchKind" VerticalAlignment="Center" Margin="0,0,12,0"
                                         IsEnabled="{Binding CanChooseKind}" />
                            <RadioButton Content="seriál" IsChecked="{Binding IsSeries}" GroupName="batchKind" VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsEnabled="{Binding CanChooseKind}" />
                            <TextBlock Text="{Binding KindNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="{loc:T 'Potvrdiť'}" Command="{Binding ConfirmKindCommand}" Padding="10,3" Margin="0,0,20,0"
                                    Visibility="{Binding KindNeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Druh (filmy alebo seriál) je odhadnutý z mien súborov – potvrďte ho, alebo zvoľte druhý" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Seriál:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SeriesTitle, UpdateSourceTrigger=LostFocus}" Width="230" Margin="0,0,6,0"
                                         ToolTip="Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB" />
                                <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,6,0"
                                          IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="TMDB ID:" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <TextBox Text="{Binding SeriesTmdbId, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                         ToolTip="Číslo seriálu na TMDB (napr. 227191) alebo adresa themoviedb.org/tv/… – názov sa načíta presne podľa neho" />
                                <TextBlock Text="{Binding OtherSeries}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap" MaxWidth="360"
                                           ToolTip="Epizódy ďalších seriálov poslané z Noviniek spolu s prvým – každá ide do priečinka svojho seriálu (vidno v stĺpci Cieľ v knižnici)" />
                                <TextBlock Text="{Binding SeriesSuggestion}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="420" />
                                <Button Content="{loc:T 'Potvrdiť seriál'}" Command="{Binding ConfirmSeriesCommand}" Padding="10,3" Margin="0,0,12,0"
                                        Visibility="{Binding SeriesNeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="HISTRA tento seriál nepotvrdila – potvrďte ho, ak je správny (alebo zadajte iný)" />
                            </StackPanel>
                            <!-- owner, 30. 10. 2026: films have the same row as a series – title, TMDB, TMDB ID -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMovies, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Film:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding FilmTitle, UpdateSourceTrigger=LostFocus}" Width="230" Margin="0,0,6,0" IsEnabled="{Binding CanNameFilm}"
