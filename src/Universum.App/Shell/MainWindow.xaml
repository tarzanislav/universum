                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- the buttons wrap under the title when the pane is narrow -->
                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Stopy skupiny" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4"
                                       ToolTip="Rozhodnutie platí pre všetky súbory skupiny" />
                            <WrapPanel HorizontalAlignment="Right">
                                <!-- owner, 28. 10.: everything, the group, or only chosen films (a menu opened by the button) -->
                                <Button Content="{loc:T 'Rozpoznať jazyk audiostôp ▾'}" Click="OnSpeechMenu" Margin="0,0,8,4" Padding="10,3"
                                        ToolTip="Vypočuje si niekoľko úsekov z rôznych miest filmu a navrhne jazyk reči (whisper.cpp, všetko len v počítači; pár sekúnd na stopu). Vyberte, ktoré súbory.">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Vybrané súbory (v zozname, Ctrl / Shift)" Command="{Binding DetectAudioSelectedCommand}" />
                                            <MenuItem Header="Celá skupina – filmy každý zvlášť, seriál jedna epizóda" Command="{Binding DetectAudioCommand}" />
                                            <MenuItem Header="Všetky skupiny" Command="{Binding DetectAudioAllCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="{loc:T 'Prečítať titulky znova'}" Command="{Binding DetectSubtitlesCommand}" Margin="0,0,8,4" Padding="10,3"
                                        ToolTip="Jazyk každej textovej titulkovej stopy UNIVERSUM číta po analýze sám – niekoľko častí filmu ako pri zvuku (forced titulky tam, kde ich súbor má podľa indexu). Tu ho prečíta znova pre vybranú skupinu." />
                                <Button Content="{loc:T 'Potvrdiť návrhy'}" Command="{Binding ConfirmSuggestionsCommand}" Margin="0,0,0,4" Padding="10,3" />
                            </WrapPanel>
                        </DockPanel>
                        <!-- owner, 29. 10. 2026: the tracks in the order of the result; dragged by the grip (or the arrows) within their type -->
                        <DataGrid Grid.Row="3" Margin="0,6,0,0" MinHeight="110" ItemsSource="{Binding SlotRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False"
                                  AllowDrop="True" DragOver="OnSlotDragOver" Drop="OnSlotDrop">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="{Binding Key.Type, Converter={StaticResource TrackTypeBrush}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemovedByLanguage}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Poradie" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="Transparent" Cursor="SizeAll" Padding="3,2" ToolTip="Chyťte a potiahnite stopu hore alebo dole (v rámci zvukov alebo titulkov)"
                                                        PreviewMouseLeftButtonDown="OnSlotGripDown" MouseMove="OnSlotGripMove">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="14" />
                                                </Border>
                                                <Button Command="{Binding MoveUpCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu hore">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="10" />
                                                </Button>
                                                <Button Command="{Binding MoveDownCommand}" Padding="4,1" Margin="2,0,0,0" MinWidth="0" ToolTip="Posunúť stopu dole">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Stopa" Binding="{Binding Slot}" />
                                <DataGridTextColumn Header="Kodek" Binding="{Binding Codec}" Width="70" />
                                <DataGridTextColumn Header="Názov v súbore" Binding="{Binding Name}" Width="*" MinWidth="80" />
                                <!-- owner, 30. 10. 2026: Track name – written for the whole group, it wins over the rules' name -->
                                <DataGridTemplateColumn Header="Názov stopy" Width="*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TrackName, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanName}" VerticalAlignment="Center"
                                                     ToolTip="Názov stopy vo výsledku pre celú skupinu – môžete ho prepísať alebo doň dopísať (potvrdí sa po opustení poľa); prázdny = bez názvu" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Jazyk" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- owner, 29. 10. 2026: also a language written in the file can be corrected ("EN" that is Czech) -->
                                            <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="SlovakName"
                                                      SelectedItem="{Binding ChosenLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Jazyk stopy pre celú skupinu – aj keď je v súbore zapísaný iný (nesprávny) jazyk" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Pôvod" Width="1.2*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="11.5" />
                                                <TextBlock Text="{Binding Suggested}" FontWeight="SemiBold" FontSize="11.5" />
                                                <CheckBox Visibility="{Binding CanKeep, Converter={StaticResource BoolToVisibility}}" IsChecked="{Binding Kept, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="11.5" Margin="0,2,0,0" ToolTip="Tieto titulky ponechať, hoci ich jazyk nie je v zozname titulkov (Nastavenia)">
                                                    <TextBlock Text="{Binding ResultNote}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                </CheckBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Forced" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Visibility="{Binding IsSubtitles, Converter={StaticResource BoolToVisibility}}">
                                                <CheckBox IsThreeState="True" IsChecked="{Binding Forced, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="zaškrtnuté = forced, prázdne = nie, plné pole = podľa súboru" />
                                                <TextBlock Text="{Binding ForcedHint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,8"
                        Visibility="{Binding ShowPanels, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{loc:T 'Bez šablóny'}" Command="{Binding RulesOnlyCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="{loc:T 'Zo skupiny'}" Command="{Binding TemplateFromGroupCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="{loc:T 'Upraviť…'}" Command="{Binding EditTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="{loc:T 'Načítať…'}" Command="{Binding LoadTemplateCommand}" Margin="0,0,6,0" Padding="10,3" />
                            <Button Content="{loc:T 'Uložiť…'}" Command="{Binding SaveTemplateCommand}" Padding="10,3" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="Šablóna:" FontWeight="SemiBold" /> <Run Text="{Binding TemplateDescription, Mode=OneWay}" />
                            </TextBlock>
                            <CheckBox Content="stopy mimo šablóny odstrániť" IsChecked="{Binding RemoveUnlisted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8"
                        Visibility="{Binding ShowPanels, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Originál:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
