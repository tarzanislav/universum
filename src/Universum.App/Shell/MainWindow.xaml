                                                    <ControlTemplate>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,1">
                                                            <Button DockPanel.Dock="Left" Content="{loc:T 'Stiahnuť'}" Padding="8,1" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.DownloadOnlineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="{loc:T 'Stiahnuté a preložené titulky sa uložia vedľa videa ako „Názov videa.jazyk.srt“ (nikdy cez existujúci súbor) – Single aj Hromadné spracovanie ich potom nájdu samo.'}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{loc:T 'Text z obrázkov (OCR)'}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                                       Text="{loc:T 'Obrázkové titulky (PGS z Blu-ray, VobSub z DVD) vybranej stopy UNIVERSUM prečíta vlastným rozpoznávaním textu: písmená porovná s písmami Windows, pochybné slová opraví podľa jazyka a tvary, ktoré nepozná, sa opýta – raz za film, zapamätá si ich aj pre ďalšie filmy. Text sa uloží vedľa videa ako „Názov videa.jazyk.srt“ (nikdy cez existujúci súbor, originál ostane) a pridá sa ako nová titulková stopa; časy sú pôvodné časy obrázkov.'}" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="{loc:T 'Rozpoznať text'}" Command="{Binding ReadTextCommand}" Padding="12,3" Margin="0,0,8,0"
                                                        ToolTip="{loc:T 'Vyberte v zozname stopu s obrázkovými titulkami (PGS) – stopu videa alebo súbor .sup'}" />
                                                <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopReadingTextCommand}" Padding="12,3" Margin="0,0,16,0" />
                                                <CheckBox Content="{loc:T 'Opraviť text podľa jazyka'}" IsChecked="{Binding OcrCheckText}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                          ToolTip="{loc:T 'Slová, ktorými si čítanie nebolo isté, opraví podľa slovníka z vašich titulkov a slov, ktoré vo filme prečítalo isto; každú opravu môžete vrátiť'}" />
                                                <Button Content="{loc:T 'Naučiť slovník z titulkov…'}" Command="{Binding LearnLexiconCommand}" Padding="12,3"
                                                        ToolTip="{loc:T 'Vyberte priečinok s vašimi textovými titulkami (SRT, ASS, VTT, SUB), napr. knižnicu – UNIVERSUM si z nich zapamätá slová každého jazyka (len v tomto počítači, každý súbor raz)'}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding LexiconSummary}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding OcrStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <StackPanel Visibility="{Binding HasOcrCorrections, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                                                <TextBlock Text="{loc:T 'Opravené podľa jazyka (Vrátiť dá späť slovo, ako sa prečítalo – v novej stope, ako zmena v Časoch titulkov):'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding OcrCorrections}" MaxHeight="180" Margin="0,4,0,0">
                                                    <ItemsControl.Template>
                                                        <ControlTemplate>
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <ItemsPresenter />
                                                            </ScrollViewer>
                                                        </ControlTemplate>
                                                    </ItemsControl.Template>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,1">
                                                                <Button DockPanel.Dock="Left" Content="{loc:T 'Vrátiť'}" Padding="8,1" Margin="0,0,8,0" Command="{Binding RevertCommand}" CommandParameter="{Binding}" />
                                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Border Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" BorderBrush="#C8C8C8" BorderThickness="1"
                                                    CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding OcrQuestion.Title}" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border Background="#282828" Padding="6" VerticalAlignment="Top">
                                                            <Image Source="{Binding OcrQuestion.Shape}" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Border>
                                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:T 'Čo je to? Písmeno – alebo viac písmen, keď sa dotýkajú (napr. „rn“):'}" TextWrapping="Wrap" MaxWidth="380" />
                                                            <TextBox x:Name="OcrAnswerBox" Text="{Binding OcrAnswer, UpdateSourceTrigger=PropertyChanged}" Width="120" FontSize="20"
                                                                     HorizontalAlignment="Left" Margin="0,4,0,0" IsVisibleChanged="OnOcrAnswerVisible">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Command="{Binding TeachCommand}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Text="{loc:T 'Kde vo filme stojí (zvýraznený):'}" Style="{StaticResource Hint}" Margin="0,8,0,2" />
                                                    <Border Background="#282828" Padding="4" HorizontalAlignment="Left">
                                                        <Image Source="{Binding OcrQuestion.Line}" MaxHeight="72" MaxWidth="900" Stretch="Uniform" />
                                                    </Border>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Content="{loc:T 'Ďalej'}" Command="{Binding TeachCommand}" Padding="12,3" Margin="0,0,8,0"
                                                                ToolTip="{loc:T 'Tvar je napísaný text (Enter); UNIVERSUM si ho zapamätá'}" />
                                                        <Button Content="{loc:T 'Nie je to písmeno'}" Command="{Binding SpeckCommand}" Padding="12,3" Margin="0,0,8,0"
                                                                ToolTip="{loc:T 'Škvrna alebo zvyšok obrysu – v texte sa vynechá'}" />
                                                        <Button Content="{loc:T 'Neviem'}" Command="{Binding SkipShapeCommand}" Padding="12,3" Margin="0,0,8,0"
                                                                ToolTip="{loc:T 'V texte bude „�“ – opravíte ho v Časoch titulkov'}" />
                                                        <Button Content="{loc:T 'Uložiť teraz'}" Command="{Binding FinishReadingCommand}" Padding="12,3"
                                                                ToolTip="{loc:T 'Ďalšie neznáme tvary sa už nepýta – v texte budú ako „�“'}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedRow}"
                                      Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <TextBlock Text="{loc:T 'Jazyk:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsPanel="{StaticResource VirtualList}" VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}" DisplayMemberPath="Display" Width="170" Margin="0,0,12,0" />
                                    <TextBlock Text="{loc:T 'Názov stopy:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="170"
                                             ToolTip="{loc:T 'Názov stopy vo výsledku – kým ho neprepíšete, dáva ho pravidlo (forced = „Forced“, inak bez názvu); môžete doň dopísať, prázdny = bez názvu'}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox Content="{loc:T 'Forced'}" IsChecked="{Binding Forced}" Margin="0,0,16,0" />
                                    <CheckBox Content="{loc:T 'Pre nepočujúcich (SDH)'}" IsChecked="{Binding HearingImpaired}" />
                                </WrapPanel>

                                <TextBlock Text="{loc:T 'Zmena FPS titulkov'}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Pôvodné FPS (titulky boli pre)'}" Style="{StaticResource Hint}" />
                                        <ListBox ItemsSource="{Binding Rates}" SelectedItem="{Binding FpsFrom}" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:T 'Nové FPS (video)'}" Style="{StaticResource Hint}" />
                                        <ListBox ItemsSource="{Binding Rates}" SelectedItem="{Binding FpsTo}" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                                                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{loc:T 'Zmena rýchlosti titulkov (percentá)'}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                                <Slider Minimum="-99" Maximum="100" Value="{Binding SpeedPercent}" TickFrequency="10" TickPlacement="BottomRight" SmallChange="0.1" LargeChange="1"
                                        ToolTip="{loc:T '+ = titulky rýchlejšie (časy kratšie), − = pomalšie (časy dlhšie)'}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="−1 %" Command="{Binding SpeedStepCommand}" CommandParameter="-1" Padding="8,2" Margin="0,0,4,0" />
                                    <Button Content="−0,1 %" Command="{Binding SpeedStepCommand}" CommandParameter="-0.1" Padding="8,2" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}" Width="80" TextAlignment="Right" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,8,0" />
                                    <Button Content="+0,1 %" Command="{Binding SpeedStepCommand}" CommandParameter="0.1" Padding="8,2" Margin="0,0,4,0" />
                                    <Button Content="+1 %" Command="{Binding SpeedStepCommand}" CommandParameter="1" Padding="8,2" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:T 'Od −99 % do +100 %: +100 % = titulky dvakrát rýchlejšie, −50 % = dvakrát pomalšie; aj desatinné čísla (napr. 4,271).'}" />

                                <TextBlock Text="{loc:T 'Posun (Delay v ms)'}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−1000" Command="{Binding DelayStepCommand}" CommandParameter="-1000" Padding="8,2" Margin="0,0,4,0" />
                                    <Button Content="−100" Command="{Binding DelayStepCommand}" CommandParameter="-100" Padding="8,2" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" Width="90" TextAlignment="Right" />
                                    <TextBlock Text="{loc:T 'ms'}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                    <Button Content="+100" Command="{Binding DelayStepCommand}" CommandParameter="100" Padding="8,2" Margin="0,0,4,0" />
                                    <Button Content="+1000" Command="{Binding DelayStepCommand}" CommandParameter="1000" Padding="8,2" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="{loc:T '1000 = 1 sekunda; kladné = titulky neskôr, záporné = skôr.'}" />

                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TimingExample}" TextWrapping="Wrap" />
                                        <Button Content="{loc:T 'Vynulovať časy'}" Command="{Binding ResetTimingCommand}" HorizontalAlignment="Left" Padding="10,2" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{loc:T 'Synchronizácia podľa dvoch titulkov'}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:T 'Kedy je titulok teraz a kedy má byť (z prehrávača) – pre jeden na začiatku a jeden na konci; vypočíta rýchlosť a posun.'}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{loc:T '1. titulok je v'}" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox Grid.Column="1" Text="{Binding FirstNow, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" />
                                    <TextBlock Grid.Column="2" Text="{loc:T 'má byť v'}" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox Grid.Column="3" Text="{Binding FirstTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="1" Text="{loc:T '2. titulok je v'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SecondNow, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:T 'má byť v'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SecondTarget, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{loc:T 'Vypočítať'}" Command="{Binding TwoPointsCommand}" Padding="10,2" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SyncNote}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:T 'Text titulkov'}" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,4" />
                                    <CheckBox Content="{loc:T 'Konvertovať do SRT (UTF-8)'}" IsChecked="{Binding ToSrt}" Visibility="{Binding CanConvert, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4" />
                                    <CheckBox Content="{loc:T 'Odstrániť prvky pre nepočujúcich ([hudba], (smiech), MENO:)'}" IsChecked="{Binding RemoveHearingImpaired}" Margin="0,0,0,4" />
                                    <CheckBox Content="{loc:T 'Odstrániť formátovanie (kurzíva, tučné)'}" IsChecked="{Binding RemoveFormatting}" Margin="0,0,0,4" />
                                    <CheckBox Content="{loc:T 'Opraviť prekrývanie a príliš krátke časy'}" IsChecked="{Binding FixTimes}" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{loc:T 'Externé textové titulky sa vždy uložia ako SRT v UTF-8. Pri stope videa sa pri zmene textu prečíta celá stopa (číta sa celý súbor).'}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Upraviť v štúdiu: a file of Hromadné spracovanie – the changes go back into the task -->
                            <DockPanel Visibility="{Binding IsTask, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="{loc:T 'Späť bez uloženia'}" Command="{Binding LeaveTaskCommand}" Padding="12,6" Margin="0,0,8,0" />
                                    <Button Content="{loc:T 'Uložiť do úlohy'}" Command="{Binding SaveToTaskCommand}" Padding="16,6" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding TaskText}" TextWrapping="Wrap" Margin="0,0,16,0" />
                            </DockPanel>
                            <StackPanel Visibility="{Binding IsTask, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                    <WrapPanel DataContext="{Binding Library}">
                                        <RadioButton Content="{loc:T 'film'}" IsChecked="{Binding IsMovie}" GroupName="subtitlesKind" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="0" />
                                        <RadioButton Content="{loc:T 'seriál'}" IsChecked="{Binding IsSeries}" GroupName="subtitlesKind" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="0" />
                                        <TextBlock Text="{loc:T 'Titul:'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,6,0"
                                                 ToolTip="{loc:T 'Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB'}" />
                                        <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                                        <ContentControl Content="{Binding Tray}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,16,0"
                                                  IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="{loc:T 'Potvrdiť titul'}" Command="{Binding Tmdb.ConfirmCommand}" Padding="10,3" Margin="0,0,12,0"
                                                Visibility="{Binding Tmdb.NeedsConfirmation, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tmdb.Warning}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="{loc:T 'Doplnok:'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox IsEditable="True" ItemsSource="{Binding AdditionChoices}" Text="{Binding Addition, UpdateSourceTrigger=LostFocus}" Width="130" VerticalAlignment="Center"
                                                      ToolTip="{loc:T 'Doplnok k názvu pred veľkostnú triedu – iná verzia titulu (napr. Directors Cut, Remaster, 2); písmená, číslice, medzery a pomlčky, najviac 30 znakov. Jellyfin ho ukáže ako názov verzie.'}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}" Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T 'Epizóda:'}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding EpisodeText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="{loc:T 'napr. S01E04'}" />
                                        </StackPanel>
                                        <Button Content="{loc:T 'Knižnica…'}" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" ToolTip="{Binding OutputDescription}" />
                                    </WrapPanel>
                                    <TextBlock TextTrimming="CharacterEllipsis" DataContext="{Binding Library}" ToolTip="{Binding Description}" Margin="0,4,0,4">
                                        <Run Text="{loc:T 'Výsledok (nový súbor v knižnici, originál ostane):'}" FontWeight="SemiBold" /> <Run Text="{Binding Description, Mode=OneWay}" />
                                        <Run Text="{Binding Tmdb.Message, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /> <Run Text="{Binding TitleNote, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <CheckBox Content="{loc:T 'Použiť pravidlá UNIVERSUM (poradie stôp, príznaky, Forced, odstránenie prázdnych)'}" IsChecked="{Binding UseRules}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Blocked}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                </StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{loc:T 'Uložiť'}" Command="{Binding SaveCommand}" Padding="16,6" VerticalAlignment="Top" />
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding OutputFormat}" Width="90" Margin="0,0,8,0" VerticalAlignment="Top"
                                              Visibility="{Binding IsFiles, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:T 'Formát nových súborov titulkov'}" />
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T 'Video: nový súbor v knižnici (mkvmerge, časy cez --sync). Súbory titulkov: nové SRT alebo WebVTT vedľa pôvodných. Originály ostanú nezmenené.'}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Result}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="{loc:T 'Uložiť prácu'}" Command="{Binding SaveWorkCommand}" Padding="10,2" Margin="0,0,6,0"
                                                    ToolTip="{loc:T 'Hodnoty všetkých titulkov tohto videa sa zapamätajú – pri ďalšom otvorení videa sa obnovia (nič sa nezapíše do súborov)'}" />
                                            <Button Content="{loc:T 'Zahodiť prácu'}" Command="{Binding DiscardWorkCommand}" Padding="10,2" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding WorkNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type pages:BatchPageViewModel}">
                <Grid Margin="24,20,24,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="{loc:T 'aj podpriečinky'}" IsChecked="{Binding Recursive}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Content="{loc:T 'rozpoznať jazyk zvuku'}" IsChecked="{Binding DetectAudioAfterAnalysis}" VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="{loc:T 'Hneď po analýze vypočuje audiostopy bez jazyka (seriál cez jednu epizódu); ručné Rozpoznať jazyk audiostôp ostáva'}" />
                            <Button Content="{loc:T 'Priečinok…'}" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" Padding="12,5" />
                            <Button Content="{loc:T 'Analyzovať'}" Command="{Binding AnalyzeCommand}" Padding="16,5" />
                            <Button Content="{loc:T 'Vymazať frontu'}" Command="{Binding ClearCommand}" Padding="12,5" Margin="8,0,0,0"
                                    ToolTip="{loc:T 'Zabudne analyzované, ešte nespracované súbory – aj poslané z Noviniek (na disku sa nič nezmení)'}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Hromadné spracovanie'}" />
                                <ContentControl Content="{Binding DataContext.TrayService, RelativeSource={RelativeSource AncestorType=Window}}" ContentTemplate="{DynamicResource TrayAutoSwitch}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="16,0,0,4" />
                            </StackPanel>
                            <!-- owner, 9. 11. 2026: all input folders at once (one on each disk), one of them, or a folder chosen -->
                            <ComboBox ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding FolderChoice}" DisplayMemberPath="Label" MinWidth="320" MaxWidth="700"
                                      HorizontalAlignment="Left" FontWeight="SemiBold" Margin="0,2,0,0"
                                      ToolTip="{loc:T 'Čo sa analyzuje: všetky vstupné priečinky naraz (každý súbor pôjde do výstupu na svojom disku), vstup jedného disku, alebo priečinok vybraný tlačidlom Priečinok…'}" />
                            <TextBlock Text="{Binding DiskHint}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                                       Visibility="{Binding HasDiskHint, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
