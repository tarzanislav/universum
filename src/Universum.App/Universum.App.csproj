<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Universum</AssemblyName>
    <RootNamespace>Universum.App</RootNamespace>
    <Description>UNIVERSUM – grafická nadstavba nad MKVToolNix</Description>
    <SatelliteResourceLanguages>sk</SatelliteResourceLanguages>
    <!-- WPF0001: ThemeMode (Fluent) is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- official TMDB logo (blue_short) from https://www.themoviedb.org/about/logos-attribution; the PNG is rendered
         from the unchanged SVG because WPF does not draw SVG -->
    <Resource Include="Assets\tmdb-logo.png" />
    <None Include="Assets\tmdb-logo.svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Universum.Core\Universum.Core.csproj" />
    <ProjectReference Include="..\Universum.Platform.Windows\Universum.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
