                    <!-- owner, 7. 11. 2026: the settings hidden – a line says so, with what is chosen, and shows them again -->
                    <DockPanel Grid.Row="4" Margin="0,8,0,0" Visibility="{Binding ShowPanels, Converter={StaticResource InverseBoolToVisibility}}">
