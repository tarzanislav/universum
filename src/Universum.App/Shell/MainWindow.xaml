                        <TextBlock Text="{Binding HiddenPanelsNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8"
                            Visibility="{Binding ShowPanels, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{loc:T 'Originál:'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <!-- owner, 30. 10. 2026: deleting originals – only here; always into the Recycle Bin -->
                                <RadioButton Content="{loc:T 'zachovať'}" IsChecked="{Binding KeepOriginal}" GroupName="batchOriginal" Margin="0,0,12,0" IsEnabled="{Binding IsIdle}" />
                                <RadioButton Content="{loc:T 'zmazať automaticky'}" IsChecked="{Binding DeleteAutomatically}" GroupName="batchOriginal" Margin="0,0,12,0" IsEnabled="{Binding IsIdle}"
                                             ToolTip="{loc:T 'Každý originál ide do Koša hneď po zapísaní a overení nového súboru v knižnici – priebežne, súbor po súbore'}" />
                                <RadioButton Content="{loc:T 'zmazať ručne'}" IsChecked="{Binding DeleteManually}" GroupName="batchOriginal" Margin="0,0,8,0" IsEnabled="{Binding IsIdle}"
                                             ToolTip="{loc:T 'Počas spracovania sa nič nemaže; po dokončení pošle originály do Koša tlačidlo Zmazať originály'}" />
                                <!-- owner, 2. 11. 2026: Superrýchle – a header-only file moved into the library and edited there -->
                                <RadioButton Content="{loc:T 'superrýchle'}" IsChecked="{Binding MoveIntoLibrary}" GroupName="batchOriginal" Margin="0,0,8,0" IsEnabled="{Binding IsIdle}"
                                             ToolTip="{loc:T 'Súbor, ktorému sa mení len hlavička a leží na disku výstupného priečinka, sa presunie do knižnice a upraví tam za pár sekúnd (originál sa stane výsledkom, Vrátiť originály ho dá späť); ostatné sa zapíšu nanovo a originál ide do Koša. Súbor s hard linkom, otvorený inde alebo na inom disku sa nepresúva.'}" />
                                <Button Content="{Binding UndoMovedText}" Command="{Binding UndoMovedCommand}" Padding="10,3" Margin="0,0,8,0"
                                        Visibility="{Binding MoveIntoLibrary, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{loc:T 'Originály presunuté do knižnice (superrýchle) vráti na pôvodné miesto s pôvodnou hlavičkou – vybrané súbory, inak všetky z posledného behu'}" ToolTipService.ShowOnDisabled="True" />
                                <!-- owner, 7. 11. 2026: Ponechať MP4 – the header of an MP4 edited by UNIVERSUM itself (with superrýchle in seconds) -->
                                <CheckBox Content="{loc:T 'MP4 ponechať ako MP4'}" IsChecked="{Binding KeepMp4}" VerticalAlignment="Center" Margin="0,0,20,0" IsEnabled="{Binding IsIdle}"
                                          ToolTip="{loc:T 'MP4, ktorému sa mení len hlavička (jazyky, názvy, predvolené stopy, Forced, titulky pre nepočujúcich, komentár, poradie, názov, odstránené titulky), ostane MP4 – hlavičku upraví UNIVERSUM sám, obraz a zvuk sa nedotknú; so superrýchle za pár sekúnd. Ak treba zmenu, ktorú MP4 neudrží (odstrániť zvuk, pridať stopu, kapitoly, strih…), zapíše sa ako MKV. Platí aj v Single spracovaní.'}" />
                                <Button Content="{Binding DeleteOriginalsText}" Command="{Binding DeleteOriginalsCommand}" Padding="10,3" Margin="0,0,20,0"
                                        Visibility="{Binding CanDeleteOriginals, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{loc:T 'Originály spracovaných súborov do Koša Windows – len tie, ktorých výsledok je v knižnici a ktoré sa od spracovania nezmenili'}" />
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Run Text="{loc:T 'Knižnica:'}" /> <Run Text="{Binding OutputDescription, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="{loc:T 'Priečinok…'}" Command="{Binding ChooseOutputDirectoryCommand}" Padding="10,3" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <RadioButton Content="{loc:T 'filmy'}" IsChecked="{Binding IsMovies}" GroupName="batchKind" VerticalAlignment="Center" Margin="0,0,12,0"
                                             IsEnabled="{Binding CanChooseKind}" />
                                <RadioButton Content="{loc:T 'seriál'}" IsChecked="{Binding IsSeries}" GroupName="batchKind" VerticalAlignment="Center" Margin="0,0,8,0"
                                             IsEnabled="{Binding CanChooseKind}" />
                                <TextBlock Text="{Binding KindNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="{loc:T 'Potvrdiť'}" Command="{Binding ConfirmKindCommand}" Padding="10,3" Margin="0,0,20,0"
                                        Visibility="{Binding KindNeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{loc:T 'Druh (filmy alebo seriál) je odhadnutý z mien súborov – potvrďte ho, alebo zvoľte druhý'}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:T 'Seriál:'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding SeriesTitle, UpdateSourceTrigger=LostFocus}" Width="230" Margin="0,0,6,0"
                                             ToolTip="{loc:T 'Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB'}" />
                                    <Button Content="{loc:T 'TMDB'}" Command="{Binding Tmdb.SearchCommand}" ToolTip="{Binding Tmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding Tmdb.Results}" SelectedItem="{Binding Tmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,6,0"
                                              IsDropDownOpen="{Binding Tmdb.IsOpen}" Visibility="{Binding Tmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{loc:T 'TMDB ID:'}" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <TextBox Text="{Binding SeriesTmdbId, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                             ToolTip="{loc:T 'Číslo seriálu na TMDB (napr. 227191) alebo adresa themoviedb.org/tv/… – názov sa načíta presne podľa neho'}" />
                                    <ContentControl Content="{Binding Tray}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SeriesTargetNote}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding OtherSeries}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                               ToolTip="{Binding OtherSeriesList}" />
                                    <TextBlock Text="{Binding SeriesSuggestion}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="420" />
                                    <Button Content="{loc:T 'Potvrdiť seriál'}" Command="{Binding ConfirmSeriesCommand}" Padding="10,3" Margin="0,0,12,0"
                                            Visibility="{Binding SeriesNeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{loc:T 'HISTRA tento seriál nepotvrdila – potvrďte ho, ak je správny (alebo zadajte iný)'}" />
                                </StackPanel>
                                <!-- owner, 30. 10. 2026: films have the same row as a series – title, TMDB, TMDB ID -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMovies, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:T 'Film:'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding FilmTitle, UpdateSourceTrigger=LostFocus}" Width="230" Margin="0,0,6,0" IsEnabled="{Binding CanNameFilm}"
                                             ToolTip="{loc:T 'Názov (rok), pri inom písme ako latinka anglický názov (rok) [tmdbid-ID]; aj ID alebo adresa TMDB. Platí pre film vybranej skupiny (aj jeho verzie).'}" />
                                    <Button Content="{loc:T 'TMDB'}" Command="{Binding FilmTmdb.SearchCommand}" ToolTip="{Binding FilmTmdb.Tooltip}" ToolTipService.ShowOnDisabled="True" Padding="10,3" Margin="0,0,6,0"
                                            IsEnabled="{Binding CanNameFilm}" />
                                    <ComboBox ItemsSource="{Binding FilmTmdb.Results}" SelectedItem="{Binding FilmTmdb.Selected}" DisplayMemberPath="Display" Width="200" Margin="0,0,6,0"
                                              IsDropDownOpen="{Binding FilmTmdb.IsOpen}" Visibility="{Binding FilmTmdb.HasResults, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{loc:T 'TMDB ID:'}" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <TextBox Text="{Binding FilmTmdbId, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,10,0" VerticalContentAlignment="Center" IsEnabled="{Binding CanNameFilm}"
                                             ToolTip="{loc:T 'Číslo filmu na TMDB (napr. 1629051) alebo adresa themoviedb.org/movie/… – názov sa načíta presne podľa neho, aj pri filme v inom písme'}" />
                                    <ContentControl Content="{Binding Tray}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FilmSuggestion}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="420" />
                                    <TextBlock Text="{Binding FilmHint}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="360" />
                                </StackPanel>
                                <Button Content="{loc:T 'Prijať návrhy názvov'}" Command="{Binding ConfirmTitlesCommand}" Padding="10,3"
                                        ToolTip="{loc:T 'Druh, názvy a čísla epizód odhadnuté z mien súborov a priečinkov (nie otázky Season 00 / Season 01)'}" />
                                <Button Content="{loc:T 'Prijať všetko v skupine'}" Command="{Binding AcceptGroupCommand}" Padding="10,3" Margin="6,0,0,0" FontWeight="SemiBold"
                                        ToolTip="{loc:T 'Pre vybranú skupinu naraz: druh, názov seriálu alebo filmu, čísla epizód aj jazyky stôp podľa návrhov (nie otázky Season 00 / bežná sezóna a návrhy s upozornením)'}" />
                                <Button Content="{loc:T 'Špeciály do Season 00'}" Command="{Binding AnswerSpecialsCommand}" Padding="10,3" Margin="6,0,0,0"
                                        Visibility="{Binding HasSpecialsQuestions, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{loc:T 'Odpoveď na otázku Season 00 alebo bežná sezóna: súbory z priečinka špeciálov (alebo s S00 v mene) idú do Season 00. Inak zadajte číslo epizódy pri súbore.'}" />
                            </WrapPanel>
                            <!-- the end of a run, boldly (owner, 29. 10. 2026) -->
                            <Border Margin="0,8,0,0" CornerRadius="6" Padding="14,8" Background="{Binding Finish.Background, FallbackValue=Transparent}"
                                    Visibility="{Binding HasFinish, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Finish.Icon}" FontSize="26" Foreground="White"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Finish.Title}" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Finish.Detail}" FontSize="13" Foreground="White" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{loc:T 'Uložiť správu…'}" Command="{Binding SaveReportCommand}" Margin="0,0,6,0" Padding="10,4" />
                                    <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" Margin="0,0,6,0" Padding="10,4" />
                                    <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopCommand}" Margin="0,0,6,0" Padding="10,4"
                                            ToolTip="{loc:T 'Dokončí rozpracované súbory a ďalej nepokračuje'}" />
                                    <ComboBox ItemsSource="{Binding MegaTargets}" SelectedItem="{Binding SelectedMegaTarget}" DisplayMemberPath="Label" MaxWidth="220" Margin="0,0,4,0"
                                              FontSize="12" Visibility="{Binding IsEditingMega, Converter={StaticResource InverseBoolToVisibility}}"
                                              ToolTip="{loc:T 'Kam idú pripravené súbory: nová dávka, alebo doplniť čakajúcu dávku'}" />
                                    <Button Content="{Binding SendToMegaText}" Command="{Binding SendToMegaCommand}" Margin="0,0,6,0" Padding="12,4"
                                            ToolTip="{loc:T 'Pripravené súbory uloží do dávky MEGA spracovania – zapíšu sa neskôr (keď dávku spustíte, po predchádzajúcej dávke alebo v nastavenom čase)'}" />
                                    <Button Content="{loc:T 'Spustiť'}" Command="{Binding RunCommand}" Padding="18,4" ToolTip="{loc:T 'Spustí spracovanie ako úlohu vo Fronte úloh (priebeh aj výstup každého súboru uvidíte aj tam)'}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Simulation}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RunState}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
            <!-- POZNÁMKY – Kalendár (owner, 31. 10. 2026): seven views, layers, the day's detail and the editor on the left -->
            <DataTemplate DataType="{x:Type pages:AgendaEditor}">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,0,0,8" Visibility="{Binding CanChangeKind, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton Content="{loc:T 'Udalosť'}" IsChecked="{Binding IsEvent}" GroupName="AgendaKind" MinWidth="0" Margin="0,0,14,0" />
                        <RadioButton Content="{loc:T 'Úloha'}" IsChecked="{Binding IsTask}" GroupName="AgendaKind" MinWidth="0" Margin="0,0,14,0" />
                        <RadioButton Content="{loc:T 'Poznámka'}" IsChecked="{Binding IsNote}" GroupName="AgendaKind" MinWidth="0" />
                    </WrapPanel>
                    <TextBlock Text="{loc:T 'Názov'}" Style="{StaticResource Hint}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <!-- an event: days, hours, repeat, reminder -->
                    <StackPanel Visibility="{Binding IsEvent, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Od'}" Style="{StaticResource Hint}" />
                                <DatePicker SelectedDate="{Binding StartDate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:T 'Do (viac dní)'}" Style="{StaticResource Hint}" />
                                <DatePicker SelectedDate="{Binding EndDate}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="{loc:T 'Celý deň'}" IsChecked="{Binding AllDay}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,6" Visibility="{Binding HasHours, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Čas od (20:00)'}" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:T 'Čas do'}" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:T 'Opakovanie'}" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding Source={x:Static pages:AgendaEditor.Repeats}}" SelectedItem="{Binding Repeat}" Margin="0,2,0,6" HorizontalAlignment="Stretch" />
                        <Grid Margin="0,0,0,6" Visibility="{Binding HasRepeat, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Každý(ch)'}" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:T 'Do dňa (nepovinné)'}" Style="{StaticResource Hint}" />
                                <DatePicker SelectedDate="{Binding UntilDate}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:T 'Pripomienka'}" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding Source={x:Static pages:AgendaEditor.Reminders}}" SelectedItem="{Binding Reminder}" Margin="0,2,0,6" HorizontalAlignment="Stretch" />
                        <!-- owner, 31. 10. 2026: what UNIVERSUM does by itself at this time -->
                        <TextBlock Text="{loc:T 'UNIVERSUM v tom čase vykoná'}" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding Source={x:Static pages:AgendaEditor.Actions}}" SelectedItem="{Binding Action}" Margin="0,2,0,6" HorizontalAlignment="Stretch" />
                        <StackPanel Visibility="{Binding IsMegaAction, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox ItemsSource="{Binding MegaBatches}" SelectedItem="{Binding MegaBatch}" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{loc:T 'V MEGA spracovaní nečaká žiadna dávka.'}" Style="{StaticResource Hint}" Foreground="#D9534F" Margin="0,0,0,6"
                                       Visibility="{Binding NoMegaBatch, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActionHint}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox Content="{loc:T 'Aj ako úloha (v Plánovaných úlohách)'}" IsChecked="{Binding AlsoTask}" Margin="0,0,0,6" />
                    </StackPanel>
                    <!-- a task: due day, priority, done -->
                    <StackPanel Visibility="{Binding IsTask, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Termín (prázdny = bez termínu)'}" Style="{StaticResource Hint}" />
                                <DatePicker SelectedDate="{Binding DueDate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:T 'Čas'}" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:T 'Priorita'}" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding Source={x:Static pages:AgendaEditor.Priorities}}" SelectedItem="{Binding Priority}" Margin="0,2,0,6" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <CheckBox Content="{loc:T 'Hotovo'}" IsChecked="{Binding Done}" Margin="0,0,0,6">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTask}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AlsoTask}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <!-- a note: pinned, on its day -->
                    <StackPanel Visibility="{Binding IsNote, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="{loc:T 'Pripnúť (hore v Poznámkach)'}" IsChecked="{Binding Pinned}" Margin="0,0,0,4" />
                        <CheckBox Content="{loc:T 'Ukázať v kalendári v tento deň'}" IsChecked="{Binding OnDay}" Margin="0,0,0,6" />
                    </StackPanel>
                    <!-- the checklist of a task -->
                    <StackPanel Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T 'Kontrolný zoznam'}" Style="{StaticResource Hint}" />
                        <ItemsControl ItemsSource="{Binding Checklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,0">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done}" MinWidth="0" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" Padding="6,2" Margin="4,0,0,0" ToolTip="{loc:T 'Odstrániť riadok'}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                        </Button>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Command="{Binding AddCheckCommand}" Padding="8,2" Margin="4,0,0,0" ToolTip="{loc:T 'Pridať riadok (Enter)'}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" />
                            </Button>
                            <TextBox Text="{Binding NewCheckText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:T 'Nový riadok kontrolného zoznamu – Enter ho pridá'}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCheckCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="{loc:T 'Text'}" Style="{StaticResource Hint}" />
                    <TextBox x:Name="AgendaText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" Margin="0,2,0,6" />
                    <!-- the links of the note, each on a row, to open them (owner, 7. 11. 2026) -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:T 'Odkazy'}" Style="{StaticResource Hint}" />
                        <ItemsControl ItemsSource="{Binding Links}" Focusable="False" />
                    </StackPanel>
                    <!-- the voice: Windows' voice typing, or a recording written down in the computer -->
                    <Border Padding="8,6" CornerRadius="6" Margin="0,0,0,6" Background="#10D46A8C" Visibility="{Binding HasVoice, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <WrapPanel>
                                <Button Click="OnDictateClick" Tag="{Binding ElementName=AgendaText}" Padding="8,3" Margin="0,0,6,4"
                                        ToolTip="{loc:T 'Hlasové písanie Windows (Win + H) – píše do textu poznámky; ide cez službu Microsoftu (internet)'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:T 'Diktovať (Win+H)'}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RecordCommand}" Padding="8,3" Margin="0,0,6,4"
                                        ToolTip="{loc:T 'Nahrá hlas z mikrofónu a prepíše ho v počítači (whisper.cpp) – bez internetu, nahrávka ostane pri poznámke'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding RecordText}" />
                                    </StackPanel>
                                </Button>
                                <ComboBox ItemsSource="{Binding Source={x:Static pages:AgendaEditor.VoiceLanguages}}" SelectedItem="{Binding VoiceLanguage}" Width="100" Margin="0,0,6,4"
                                          ToolTip="{loc:T 'Jazyk prepisu'}" />
                                <Button Command="{Binding PlayCommand}" Padding="8,3" Margin="0,0,0,4" ToolTip="{loc:T 'Prehrať nahrávku poznámky'}"
                                        Visibility="{Binding HasRecording, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" />
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding VoiceStatus}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:T 'Štítky (#kino #seriál)'}" Style="{StaticResource Hint}" />
                            <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:T 'Farba'}" Style="{StaticResource Hint}" />
                            <ComboBox ItemsSource="{Binding Source={x:Static pages:AgendaEditor.Colors}}" SelectedItem="{Binding Color}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Content="{loc:T 'Uložiť'}" Command="{Binding SaveCommand}" Padding="14,5" Margin="0,0,8,6" FontWeight="SemiBold" />
                        <Button Content="{loc:T 'Zrušiť'}" Command="{Binding CancelCommand}" Padding="12,5" Margin="0,0,8,6" />
                        <Button Content="{loc:T 'Do koša'}" Command="{Binding DeleteCommand}" Padding="12,5" Margin="0,0,0,6" ToolTip="{loc:T 'Záznam pôjde do koša – dá sa vrátiť'}"
                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type pages:HistraListsPageViewModel}">
                <DockPanel Margin="24,20,24,12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:T 'Listy z HISTRA'}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="{loc:T 'Vaše listy filmov a seriálov z histra.net. UNIVERSUM ich z HISTRA len číta (nič tam nezapisuje), uchováva ich len v tomto počítači a obnoví ich iba tlačidlom Synchronizovať.'}" />
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Command="{Binding ImportCommand}" Padding="12,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:T 'Importovať listy…'}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SyncCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="{loc:T 'Načíta všetky importované listy z HISTRA znova'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:T 'Synchronizovať'}" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{loc:T 'Zastaviť'}" Command="{Binding StopCommand}" Padding="12,5" Margin="0,0,16,0"
                                        Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBox DockPanel.Dock="Right" Width="240" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:T 'Hľadať film alebo seriál v listoch (český aj pôvodný názov, rok; bez diakritiky)'}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{loc:T 'Hľadať:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Status}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Requirement}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanUse}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- the detail of the chosen title: on the left, the lists on the right (owner, 31. 10. 2026) -->
                    <Border DockPanel.Dock="Left" Width="460" Margin="0,0,16,0" Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <!-- the title shown goes on: to TMDB poster, or to Single spracovanie (owner, 31. 10. 2026) -->
                            <DockPanel DockPanel.Dock="Top" Margin="18,8,8,0">
                                <Button DockPanel.Dock="Right" Padding="8,2" ToolTip="{loc:T 'Zavrieť'}" Command="{Binding CloseDetailCommand}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                                </Button>
                                <WrapPanel>
                                    <Button Command="{Binding ToPosterCommand}" Padding="10,4" Margin="0,0,8,6" ToolTip="{loc:T 'Otvorí film alebo seriál v kategórii TMDB Poster (potrebuje TMDB ID)'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:T 'Otvoriť v TMDB Poster'}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ToSingleCommand}" Padding="10,4" Margin="0,0,8,6"
                                            ToolTip="{loc:T 'Nájde film alebo seriál vo vstupnom priečinku: jeden súbor otvorí v Single spracovaní, viac epizód seriálu v Hromadnom spracovaní'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:T 'Do Single spracovania'}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="18,0,18,18">
                                    <ContentControl Content="{Binding Card}" />
                                    <StackPanel DataContext="{Binding Selected}" Visibility="{Binding HasOther, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{loc:T 'Ďalšie údaje z HISTRA'}" FontWeight="SemiBold" Margin="0,12,0,4" />
                                        <ItemsControl ItemsSource="{Binding Other}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,14,0,0" TextWrapping="Wrap"
                                               Text="{loc:T 'Údaje z HISTRA, detail (názvy, žáner, réžia, herci, kolekcia) z TMDB, ak je kľúč TMDB; hodnotenia IMDb, Rotten Tomatoes a Metacritic z OMDb, ak je jeho kľúč. ČSFD ID nie je v dátach – odkaz otvorí hľadanie.'}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <!-- no list yet -->
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20,16"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Zatiaľ tu nie je žiadny list'}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="{loc:T 'Kliknite na Importovať listy… – ukážu sa vaše listy z HISTRA s náhľadmi plagátov a vyberiete, ktoré má mať UNIVERSUM.'}" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Lists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14" Background="{Binding Tint}"
                                                AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="5" CornerRadius="8,0,0,8" Background="{Binding Accent}" />
                                                <!-- the order of the lists: drag by the grip, or the arrows -->
                                                <StackPanel DockPanel.Dock="Left" Margin="8,10,0,0" VerticalAlignment="Top">
                                                    <Border Background="Transparent" Cursor="SizeAll" Padding="4,2" ToolTip="{loc:T 'Chyťte a potiahnite list hore alebo dole'}"
                                                            PreviewMouseLeftButtonDown="OnListGripDown" MouseMove="OnListGripMove">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76F;" FontSize="16" HorizontalAlignment="Center" Foreground="{Binding Accent}" />
                                                    </Border>
                                                    <Button Command="{Binding MoveUpCommand}" Padding="6,2" Margin="0,4,0,0" MinWidth="0" ToolTip="{loc:T 'Posunúť list hore'}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding MoveDownCommand}" Padding="6,2" Margin="0,4,0,0" MinWidth="0" ToolTip="{loc:T 'Posunúť list dole'}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Margin="14,10,14,12">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding FilterResult}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <Button Content="{Binding ExpandText}" Command="{Binding ToggleCommand}" Padding="10,3" Margin="0,0,6,0"
                                                                    Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button Command="{Binding RemoveCommand}" Padding="8,3" ToolTip="{loc:T 'Odstrániť list z UNIVERSUM (v HISTRA ostane)'}">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Accent}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="12" />
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="{loc:T 'V HISTRA sa tento list pri poslednej synchronizácii nenašiel – tu ostáva jeho posledný obsah.'}"
                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                                                                       Visibility="{Binding Missing, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Visible}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,10,10" Cursor="Hand">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <StackPanel Width="96">
                                                                                <Border x:Name="Frame" Width="96" Height="144" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent"
                                                                                        Background="{Binding List.Tint}">
                                                                                    <Grid>
                                                                                        <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="6" FontSize="11.5" />
                                                                                        <Border CornerRadius="4">
                                                                                            <Border.Background>
                                                                                                <ImageBrush ImageSource="{Binding SmallPoster.Image}" Stretch="UniformToFill" />
                                                                                            </Border.Background>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Caption}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                                            </StackPanel>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{Binding List.Accent}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Background="{DynamicResource LayerFillColorDefaultBrush}">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T 'UNIVERSUM'}" FontSize="20" FontWeight="SemiBold" Margin="20,20,20,16" />
            <!-- Dashboard on its own, then the groups: framed, each with its own tint and a heading in its colour -->
            <ListBox ItemsSource="{Binding ToolsView}" SelectedItem="{Binding SelectedTool}" IsSynchronizedWithCurrentItem="False"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Border x:Name="Frame" Margin="8,4,8,1" Padding="0,0,0,2" CornerRadius="8" BorderThickness="1"
                                                    Background="{Binding Name.Background}" BorderBrush="{Binding Name.Border}">
                                                <StackPanel>
                                                    <TextBlock x:Name="Heading" Text="{Binding Name.Title}" Foreground="{Binding Name.Heading}"
                                                               FontSize="11.5" FontWeight="Bold" Margin="12,5,8,1" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Name.IsFramed}" Value="False">
                                                    <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Frame" Property="Margin" Value="0" />
                                                    <Setter TargetName="Frame" Property="BorderThickness" Value="0" />
                                                    <Setter TargetName="Frame" Property="Padding" Value="0" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <!-- compact rows: the whole rail (four groups) fits a window 740 px high without scrolling -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="MinHeight" Value="29" />
                        <Setter Property="Padding" Value="10,2" />
                        <Setter Property="Margin" Value="4,1" />
                        <Style.Triggers>
                            <!-- the guide of a group: a lower, quieter row so the rail stays short -->
                            <DataTrigger Binding="{Binding IsGuide}" Value="True">
                                <Setter Property="MinHeight" Value="23" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Opacity" Value="0.85" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,0">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- the live counts of POZNÁMKY -->
                            <Border Margin="8,0,0,0" CornerRadius="8" Padding="6,0" MinWidth="18" VerticalAlignment="Center" ToolTip="{Binding Badge.ToolTip}"
                                    Visibility="{Binding Badge.IsShown, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#40D46A8C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Badge.Alert}" Value="True">
                                                <Setter Property="Background" Value="#D9534F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Badge.Text}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Badge.Alert}" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <!-- owner, 31. 10. 2026: new films and episodes in the input folder – told, sent to Hromadné spracovanie on a click -->
            <Border DockPanel.Dock="Top" Margin="16,10,16,0" CornerRadius="8" Padding="14,8" Background="#336FA8E8"
                    Visibility="{Binding HasArrivals, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:T 'Do Hromadného spracovania'}" Command="{Binding ArrivalsToBatchCommand}" Padding="12,4" Margin="8,0,8,0" FontWeight="SemiBold" />
                        <Button Command="{Binding DismissArrivalsCommand}" Padding="8,4" ToolTip="{loc:T 'Skryť (súbory ostanú na vstupe)'}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ArrivalsText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArrivalsText}" />
                </DockPanel>
            </Border>
            <!-- owner, 31. 10. 2026: a reminder of the calendar -->
            <Border DockPanel.Dock="Top" Margin="16,10,16,0" CornerRadius="8" Padding="14,8" Background="#33D46A8C"
                    Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:T 'Otvoriť v kalendári'}" Command="{Binding OpenReminderCommand}" Padding="12,4" Margin="8,0,8,0" FontWeight="SemiBold" />
                        <Button Command="{Binding DismissReminderCommand}" Padding="8,4" ToolTip="{loc:T 'Skryť pripomienku'}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReminderText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReminderText}" FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding SelectedTool.Page}" />
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding UpdateBadge}" Command="{Binding ShowUpdatesCommand}" Margin="0,0,8,0" Padding="12,4"
                            ToolTip="{loc:T 'Aktualizácie MKVToolNix a UNIVERSUM'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:T 'Otvoriť v MKVToolNix GUI'}" Command="{Binding OpenMkvToolNixGuiCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="{loc:T 'MKVToolNix…'}" Command="{Binding SetupCommand}" Padding="12,4" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}">
                    <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MkvToolNixStatus, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
