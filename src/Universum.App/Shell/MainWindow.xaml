                                <Button DockPanel.Dock="Right" Content="{loc:T 'Obraz v štúdiu'}" Command="{Binding EditPictureInStudioCommand}" Padding="10,3" Margin="0,0,6,0"
                                        ToolTip="{loc:T 'Úprava videostopy: strih, pomer strán, otočenie, výška, kodek – zmeny sa uložia do úlohy (Hromadné aj MEGA)'}" ToolTipService.ShowOnDisabled="True" />
                                <Button DockPanel.Dock="Right" Content="{loc:T 'Zvuk v štúdiu'}" Command="{Binding EditSoundInStudioCommand}" Padding="10,3" Margin="0,0,6,0"
