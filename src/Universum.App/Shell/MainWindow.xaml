                                            <TextBlock Text="{Binding WeatherSymbol}" FontFamily="Segoe UI Symbol" FontSize="44" VerticalAlignment="Center" Margin="0,0,14,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding TemperatureText}" FontSize="44" FontWeight="Light" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeatherDescription}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WeatherDetail}" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding WeatherDays}" Margin="0,12,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="10,2" ToolTip="{Binding Description}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Temperatures}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Rain}" Style="{StaticResource Hint}" FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <!-- what the tools are doing now -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="UNIVERSUM teraz" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Status}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Attention}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="3" Content="Otvoriť" Command="{Binding OpenCommand}" Padding="10,2" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- quick starts -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="Rýchle akcie" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Command="{Binding AddToMuxCommand}" Margin="0,0,8,8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Margin="0,0,8,0" />
                                        <TextBlock Text="Pridať súbory do Zlučovania…" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding BatchFolderCommand}" Margin="0,0,8,8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                                        <TextBlock Text="Hromadné spracovanie priečinka…" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SingleFileCommand}" Margin="0,0,8,8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,0,8,0" />
                                        <TextBlock Text="Single spracovanie súboru…" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding InfoFileCommand}" Margin="0,0,8,8" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0" />
                                        <TextBlock Text="Informácie o súbore…" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"
                                       Text="Súbory sa dajú poslať aj z Prieskumníka: pravé tlačidlo → UNIVERSUM (vo Windows 11 pod „Zobraziť ďalšie možnosti“)." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Nastavenia" />
                    <TextBlock Style="{StaticResource Hint}" Text="Knižnica a profil pravidiel UNIVERSUM. Predvolený profil zodpovedá špecifikácii (čeština a slovenčina)." Margin="0,0,0,16" />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Priečinok…" Command="{Binding ChooseOutputDirectoryCommand}" Padding="12,5" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="Výstupný priečinok (knižnica)" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OutputDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Filmy idú do MOVIES\Názov (rok), seriály do TVSHOWS\Názov (rok)\Season 01 – podľa pravidiel Jellyfin. Priečinky MOVIES a TVSHOWS UNIVERSUM nikdy nemaže." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="TMDB – názvy filmov a seriálov" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="Vlastný bezplatný kľúč z themoviedb.org (Nastavenia účtu → API): API Key alebo API Read Access Token. Na TMDB sa posiela len názov alebo ID titulu." />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Overiť a uložiť" Command="{Binding SaveTmdbKeyCommand}" Margin="8,0,8,0" Padding="12,5" />
                                    <Button Content="Odstrániť" Command="{Binding RemoveTmdbKeyCommand}" Padding="12,5" />
                                </StackPanel>
                                <TextBox Text="{Binding TmdbKeyInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nový kľúč TMDB" />
                            </DockPanel>
                            <CheckBox Content="Pripájať sa k TMDB" IsChecked="{Binding TmdbEnabled}" Margin="0,8,0,0"
                                      ToolTip="Vypnutím sa na TMDB nič neposiela; uložený kľúč ostáva." />
                            <TextBlock Text="{Binding TmdbStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <DockPanel Margin="0,8,0,0">
                                <!-- the TMDB logo, smaller than the UNIVERSUM name (TMDB attribution rules) -->
                                <Image DockPanel.Dock="Left" Source="/Assets/tmdb-logo.png" Height="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="The Movie Database (TMDB) – www.themoviedb.org" />
                                <TextBlock Text="{Binding TmdbAttribution, Mode=OneWay}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="HISTRA – sledovanie filmov a seriálov" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="Vlastný token z histra.net (Nastavenia → Tracking API), posiela sa ako hlavička Authorization: Bearer. HISTRA overuje názvy filmov a seriálov nájdené na TMDB (titul, ktorý nepotvrdí, čaká na vaše potvrdenie) a hľadá ich, keď nie je kľúč TMDB alebo TMDB titul nenájde; posiela sa iba hľadaný názov. Na tlačidlo v Listoch z HISTRA načíta vaše listy – do HISTRA UNIVERSUM nič nezapisuje." />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Uložiť" Command="{Binding SaveHistraTokenCommand}" Margin="8,0,8,0" Padding="12,5" />
                                    <Button Content="Odstrániť" Command="{Binding RemoveHistraTokenCommand}" Margin="0,0,8,0" Padding="12,5" />
                                    <Button Content="Získať token…" Command="{Binding OpenHistraTokenPageCommand}" Padding="12,5"
                                            ToolTip="Otvorí https://histra.net/settings/tracking-api" />
                                </StackPanel>
                                <TextBox Text="{Binding HistraTokenInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nový token HISTRA" />
                            </DockPanel>
                            <CheckBox Content="Pripájať sa k HISTRA" IsChecked="{Binding HistraEnabled}" Margin="0,8,0,0"
                                      ToolTip="Vypnutím sa na HISTRA nič neposiela; uložený token ostáva." />
                            <TextBlock Text="{Binding HistraStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Plagáty filmov a seriálov" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="Plagáty v Listoch z HISTRA (a ďalej v Premiérach a Novinkách) sa sťahujú zo servera plagátov a ukladajú v tomto počítači – každý len raz. Posiela sa len adresa obrázka, nič o vás." />
                            <CheckBox Content="Zobrazovať plagáty" IsChecked="{Binding PostersEnabled}" />
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Uložiť" Command="{Binding SavePosterServerCommand}" Margin="8,0,8,0" Padding="12,5" />
                                    <Button Content="Predvolený (TMDB)" Command="{Binding DefaultPosterServerCommand}" Padding="12,5" />
                                </StackPanel>
                                <TextBox Text="{Binding PosterServerInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Adresa servera plagátov (https://…)" />
                            </DockPanel>
                            <TextBlock Text="{Binding PosterStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Počasie na Dashboarde" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="Mesto sa vyhľadá na Open-Meteo (bez kľúča); posiela sa len zadané mesto a potom jeho súradnice, nič o vás. Bez mesta sa počasie nezisťuje." />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Hľadať" Command="{Binding FindWeatherTownCommand}" IsDefault="False" Margin="8,0,8,0" Padding="12,5"
                                            ToolTip="Nájde mestá s týmto menom; ak ich je viac, vyberiete to správne" />
                                    <Button Content="Odstrániť" Command="{Binding RemoveWeatherTownCommand}" Padding="12,5" />
                                </StackPanel>
                                <TextBox Text="{Binding WeatherTownInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Mesto alebo obec, napr. Valaská">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding FindWeatherTownCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <!-- several places of the same name: district, region, country and height tell them apart -->
                            <StackPanel Visibility="{Binding HasWeatherChoices, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                <ListBox ItemsSource="{Binding WeatherChoices}" SelectedItem="{Binding SelectedWeatherChoice}" MaxHeight="190"
                                         DisplayMemberPath="FullDisplay" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding UseWeatherChoiceCommand}" />
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding UseWeatherChoiceCommand}" />
                                    </ListBox.InputBindings>
                                </ListBox>
                                <Button Content="Použiť vybrané miesto" Command="{Binding UseWeatherChoiceCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,5" />
                            </StackPanel>
                            <TextBlock Text="{Binding WeatherStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding WeatherAttribution, Mode=OneWay}" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Preferované jazyky (v poradí priority, kódy oddelené čiarkou)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PreferredLanguages, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="Stopy v týchto jazykoch idú prvé; zvuk v nich znamená, že sa úplné titulky nezapínajú; forced platí len pre ne." />
                            <TextBlock Text="Slová pre forced titulky" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBox Text="{Binding ForcedKeywords, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            <TextBlock Text="Slová pre titulky pre nepočujúcich" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBox Text="{Binding HearingImpairedKeywords, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            <TextBlock Text="Slová pre komentáre" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBox Text="{Binding CommentaryKeywords, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" Text="Slová sa hľadajú v pôvodnom názve stopy ako celé slová, bez ohľadu na veľké písmená a diakritiku." />
                            <WrapPanel Margin="0,14,0,0">
                                <TextBlock Text="Dĺžka náhodného názvu videa:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding VideoNameLength, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            </WrapPanel>
                            <CheckBox Content="Odstraňovať tagy (globálne, stôp aj štatistické)" IsChecked="{Binding RemoveTags}" Margin="0,12,0,0" />
                            <CheckBox Content="Opraviť chýbajúci index videa (súbor sa zapíše nanovo)" IsChecked="{Binding RepairIndex}" Margin="0,6,0,0" />
                            <TextBlock Text="Veľkosť v názve: hranice SMALL; BIG; BluRay v GB (nad poslednou BluRay BIG)" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="filmy:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding MovieSizes, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,20,0" />
                                <TextBlock Text="seriály:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding SeriesSizes, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Uložiť" Command="{Binding SaveCommand}" Margin="0,0,8,0" Padding="16,6" />
                                <Button Content="Predvolený profil" Command="{Binding ResetCommand}" Padding="16,6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Skontrolovať teraz…" Command="{Binding ShowUpdatesCommand}" Padding="12,5" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Aktualizácie" FontWeight="SemiBold" />
                                <CheckBox Content="Kontrolovať automaticky (pri spustení, najviac raz za deň)" IsChecked="{Binding AutoCheckUpdates}" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Pýta sa len mkvtoolnix.download a github.com, nič o vás sa neposiela." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Zlučovanie" FontWeight="SemiBold" />
                            <CheckBox Content="Pri pridaní viacerých súborov sa pýtať, čo s nimi" IsChecked="{Binding MuxAskWhenAdding}" Margin="0,6,0,0"
                                      ToolTip="Ak ste v okne pridávania zvolili „Vždy použiť túto voľbu“, zaškrtnutím sa bude znova pýtať" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="{Binding MuxAddNote}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Údržba" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Folders}" Margin="0,4,0,8" />
                            <Button Content="Vymazať vyrovnávaciu pamäť analýzy" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left" Padding="12,5" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Background="{DynamicResource LayerFillColorDefaultBrush}">
            <TextBlock DockPanel.Dock="Top" Text="UNIVERSUM" FontSize="20" FontWeight="SemiBold" Margin="20,20,20,16" />
            <!-- Dashboard on its own, then the groups: framed, each with its own tint and a heading in its colour -->
            <ListBox ItemsSource="{Binding ToolsView}" SelectedItem="{Binding SelectedTool}" IsSynchronizedWithCurrentItem="False"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Border x:Name="Frame" Margin="8,5,8,1" Padding="0,0,0,3" CornerRadius="8" BorderThickness="1"
                                                    Background="{Binding Name.Background}" BorderBrush="{Binding Name.Border}">
                                                <StackPanel>
                                                    <TextBlock x:Name="Heading" Text="{Binding Name.Title}" Foreground="{Binding Name.Heading}"
                                                               FontSize="11.5" FontWeight="Bold" Margin="12,5,8,1" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Name.IsFramed}" Value="False">
                                                    <Setter TargetName="Heading" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Frame" Property="Margin" Value="0" />
                                                    <Setter TargetName="Frame" Property="BorderThickness" Value="0" />
                                                    <Setter TargetName="Frame" Property="Padding" Value="0" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <!-- compact rows: the whole rail fits a window 700 px high without scrolling -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="Margin" Value="4,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,0">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl Grid.Column="1" Content="{Binding SelectedTool.Page}" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding UpdateBadge}" Command="{Binding ShowUpdatesCommand}" Margin="0,0,8,0" Padding="12,4"
                            ToolTip="Aktualizácie MKVToolNix a UNIVERSUM">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Otvoriť v MKVToolNix GUI" Command="{Binding OpenMkvToolNixGuiCommand}" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="MKVToolNix…" Command="{Binding SetupCommand}" Padding="12,4" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}">
                    <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MkvToolNixStatus, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
