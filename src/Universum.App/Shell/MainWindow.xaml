                        </Grid>
                        <!-- the list of groups can be widened -->
                        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                      Background="Transparent" Cursor="SizeWE" ToolTip="{loc:T 'Ťahaním zmeníte šírku zoznamu skupín'}" />
                        <Grid Grid.Column="2">
                            <!-- owner, 7. 11. 2026: the files and the tracks of the group share the height – the line between them is dragged -->
